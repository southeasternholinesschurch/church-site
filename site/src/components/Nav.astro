---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
// Two versions of the same wordmark, named by WHERE they go rather than what
// colour they are — picking the wrong one is the easy mistake. Both are
// trimmed to their artwork and share a 6.18:1 ratio, so they swap without any
// shift in the layout.
import wordmarkOnDark from '../assets/brand/wordmark-on-dark.png';
import wordmarkOnLight from '../assets/brand/wordmark-on-light.png';

interface Props {
  settings: CollectionEntry<'settings'>['data'];
  theme?: 'dark' | 'light';
}
const { settings, theme = 'dark' } = Astro.props;
const wordmark = theme === 'light' ? wordmarkOnLight : wordmarkOnDark;

// Bulletin and Directory are deliberately absent — both are discreet pages
// reachable by direct URL or PWA shortcut only (brief §3, §7, §8).
const links = [
  { href: '/about', label: 'About' },
  { href: '/ministries', label: 'Ministries' },
  { href: '/sermons', label: 'Sermons' },
  { href: '/events', label: 'Events' },
  { href: '/give', label: 'Give' },
];
const current = Astro.url.pathname;
---
<header data-site-header class:list={['nav', theme === 'light' && 'nav--light']}>
  <div class="nav__inner">
    <a href="/" class="nav__brand">
      {/* The wordmark IS the church's name, so it carries the alt text — the
          plain-text span it replaces would otherwise be read out twice.
          densities 1-3 because the old mark was emitted at exactly its 30px
          display size, which is what made it look soft on any retina screen. */}
      <Image src={wordmark} alt="Fairhaven Community Church"
             width={260} densities={[1, 2, 3]} class="nav__wordmark" />
    </a>

    <nav class="nav__links" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} aria-current={current.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      <a href="/livestream" class="label nav__cta">Watch Live</a>
    </nav>

    <button class="nav__burger" type="button" aria-expanded="false" aria-controls="mobile-nav" data-burger>
      <span class="visually-hidden">Menu</span>
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
  </div>

  <div class="nav__panel" id="mobile-nav" hidden>
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    <a href="/livestream">Watch Live</a>
  </div>
</header>

<style>
  .nav { position: absolute; top: 0; left: 0; right: 0; z-index: 40; }
  .nav__inner {
    display: flex; align-items: center; justify-content: space-between;
    padding: 36px var(--pad);
    transition: padding .4s var(--ease);
  }
  .nav.is-scrolled .nav__inner { padding-block: 20px; }

  .nav__brand { display: flex; align-items: center; color: inherit; }
  /* Height-driven so the two versions can never disagree; width follows the
     6.18:1 artwork. */
  .nav__brand :global(.nav__wordmark) { height: 42px; width: auto; display: block; }

  .nav__links { display: flex; align-items: center; gap: 34px; }
  .nav__links a { color: rgba(244,239,231,.74); font-size: 14px; }
  .nav__links a:hover,
  .nav__links a[aria-current='page'] { color: var(--cream); }
  .nav__cta {
    color: var(--cream); border: 1px solid rgba(244,239,231,.4);
    padding: 10px 20px; border-radius: 999px;
  }
  .nav__cta:hover { border-color: var(--cream); }

  /* light variant, for pages that open on a pale ground */
  .nav--light .nav__links a { color: var(--ink-soft); }
  .nav--light .nav__links a:hover,
  .nav--light .nav__links a[aria-current='page'] { color: var(--ink); }
  .nav--light .nav__cta { color: var(--ink); border-color: var(--hair); }
  .nav--light .nav__burger span { background: var(--ink); }

  .nav__burger {
    display: none; position: relative; width: 26px; height: 16px;
    background: none; border: 0; padding: 0; cursor: pointer;
  }
  .nav__burger span[aria-hidden] { position: absolute; left: 0; right: 0; height: 2px; background: var(--cream); transition: transform .3s var(--ease), opacity .2s; }
  .nav__burger span:nth-of-type(1) { top: 0; }
  .nav__burger span:nth-of-type(2) { top: 7px; }
  .nav__burger span:nth-of-type(3) { top: 14px; }
  .nav__burger[aria-expanded='true'] span:nth-of-type(1) { transform: translateY(7px) rotate(45deg); }
  .nav__burger[aria-expanded='true'] span:nth-of-type(2) { opacity: 0; }
  .nav__burger[aria-expanded='true'] span:nth-of-type(3) { transform: translateY(-7px) rotate(-45deg); }

  .nav__panel { display: none; }

  @media (max-width: 860px) {
    .nav__links { display: none; }
    .nav__burger { display: block; }
    .nav__panel[hidden] { display: none; }
    .nav__panel {
      display: flex; flex-direction: column;
      background: var(--ink); padding: 8px var(--pad) 24px;
    }
    .nav__panel a {
      color: var(--cream); font-size: 18px; padding: 14px 0;
      border-bottom: 1px solid rgba(244,239,231,.14);
    }
    .nav__panel a:last-child { border-bottom: 0; }
  }
</style>

<script>
  const burger = document.querySelector('[data-burger]');
  const panel = document.getElementById('mobile-nav');
  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    if (panel) panel.hidden = open;
  });
</script>
