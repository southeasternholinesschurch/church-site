---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { clockText } from '../../lib/format';
import heroImg from '../../assets/photos/welcome.jpg';

const [settingsEntry] = await getCollection('settings');
const settings = settingsEntry.data;

// Grouped the way a visitor thinks about a week, not the way the data is stored.
const groups = [
  { label: 'Sunday Morning', times: settings.serviceTimes.filter((s) => s.day === 'Sunday' && s.time < '12:00') },
  { label: 'Sunday Evening', times: settings.serviceTimes.filter((s) => s.day === 'Sunday' && s.time >= '12:00') },
  { label: 'Wednesday Night', times: settings.serviceTimes.filter((s) => s.day === 'Wednesday') },
].filter((g) => g.times.length);
---
<BaseLayout
  title="I'm New"
  description="Whether you're exploring faith, looking for a church home, or just visiting the area — there's a place for you at Fairhaven Community Church."
>
  <!-- ============ HERO ============ -->
  <section class="nhero" data-par-frame>
    <div class="nhero__img duo par" data-par="80" style="--drift-scale: 1.28;">
      <Image src={heroImg} alt="Being welcomed at the door before a service"
             widths={[900, 1400, 2000, 2400]} sizes="140vw" fetchpriority="high" loading="eager" />
    </div>
    <div class="nhero__grade" aria-hidden="true"></div>
    <div class="nhero__body par-fg" data-par="-26">
      <a href="/about" class="nhero__back load d1">← About</a>
      <p class="label load d1 nhero__eyebrow">I'm New</p>
      <h1 class="serif load d2">We're so glad you're here.</h1>
      <p class="nhero__lede load d3">
        Whether you're exploring faith, looking for a church home, or just visiting the
        area — there's a place for you at Fairhaven Community Church. We're a friendly,
        Bible-centered church on the southeast side of Indianapolis, five minutes off
        [the highway] at the [street] exit.
      </p>
    </div>
  </section>

  <!-- ============ WHAT TO EXPECT ============ -->
  <section class="wrap expect-wrap">
    <div class="expect reveal">
      <div>
        <h2 class="label expect__h">What To Expect</h2>
        <p class="expect__lead serif">There's no dress code. Come as you are.</p>
      </div>
      <div class="expect__body">
        <p>
          From the moment you pull into the parking lot you'll find smiling faces and a
          warm atmosphere. Our worship is heartfelt and Spirit-led, with preaching rooted
          in God's Word and centered on real-life transformation.
        </p>
        <p>
          Whether you're in jeans or your Sunday best, you'll be welcomed the same.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ SERVICE TIMES ============ -->
  <section class="wrap times-wrap">
    <h2 class="label times__h reveal">Service Times</h2>
    <div class="times">
      {groups.map((g) => (
        <div class="tgroup reveal">
          <p class="tgroup__day">{g.label}</p>
          <ul class="tgroup__list">
            {g.times.map((t) => (
              <li><span class="tgroup__name">{t.label}</span><span class="tgroup__time">{clockText(t.time)}</span></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ PLAN YOUR VISIT ============ -->
  <section class="wrap plan-wrap">
    <div class="plan reveal">
      <div>
        <h2 class="label plan__h">Plan Your Visit</h2>
        <p class="plan__lead serif">We'd love to know you're coming.</p>
        <p class="plan__p">
          Message us on Facebook or give us a call, so we can look out for you, answer
          any questions, and help you feel at home from the start.
        </p>
        <div class="plan__acts">
          {settings.phone && (
            <a href={`tel:${settings.phone.replace(/[^\d+]/g, '')}`} class="btn btn--ink">
              Call {settings.phone}
            </a>
          )}
          <a href={settings.socials.facebook} target="_blank" rel="noreferrer" class="btn btn--line">
            Message us on Facebook ↗
          </a>
        </div>
      </div>
      <aside class="plan__side">
        <p class="label plan__sl">Get Connected</p>
        <p class="plan__sp">
          The best way to get plugged in is to show up and say hello. You can also
          follow us on <a href={settings.socials.facebook} target="_blank" rel="noreferrer">Facebook</a>
          to stay in the loop, or talk to a greeter or pastor after any service —
          we're here to serve.
        </p>
        <a href="/ministries" class="plan__link">See what's on for your family →</a>
      </aside>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="wrap cta-wrap">
    <div class="cta reveal">
      <div>
        <h2 class="serif cta__title">Come this Sunday.</h2>
        <p class="cta__p">
          {settings.address}. Nobody expects you to have it figured out before you walk in.
        </p>
      </div>
      <a href={settings.mapsUrl} target="_blank" rel="noreferrer" class="btn btn--solid cta__btn">Get directions ↗</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* NOTE: .nhero__img declares no transform — a scoped one would outrank .par */
  .nhero { position: relative; overflow: clip; background: var(--ink); color: var(--cream);
           min-height: 64vh; display: flex; flex-direction: column; }
  .nhero__img { position: absolute; inset: 0; z-index: 0; }
  .nhero__img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .nhero__grade { position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(180deg, rgba(26,21,18,.56) 0%, rgba(26,21,18,.22) 26%,
                                        rgba(26,21,18,.68) 62%, rgba(26,21,18,.96) 100%); }
  .nhero__body { position: relative; z-index: 3; margin-top: auto;
                 padding: 130px var(--pad) clamp(46px,6vw,74px); }
  .nhero__back { display: inline-block; font-size: 14px; font-weight: 700;
                 color: rgba(244,239,231,.7); margin-bottom: 26px; }
  .nhero__back:hover { color: var(--cream); }
  .nhero__eyebrow { color: var(--red-tint); margin: 0 0 18px; }
  .nhero h1 { margin: 0; font-size: clamp(40px,5.6vw,80px); line-height: 1.02; letter-spacing: -.02em; }
  .nhero__lede { margin: 22px 0 0; max-width: 56ch; font-size: 18px; line-height: 1.7; color: rgba(244,239,231,.82); }

  .expect-wrap { padding-block: clamp(56px,7vw,92px); }
  .expect { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1.3fr); gap: 60px; align-items: start; }
  .expect__h { color: var(--red); margin: 0 0 14px; }
  .expect__lead { margin: 0; font-size: clamp(26px,3.4vw,40px); line-height: 1.12; letter-spacing: -.01em; }
  .expect__body p { margin: 0 0 18px; font-size: 18px; line-height: 1.8; color: var(--ink-soft); }
  .expect__body p:last-child { margin-bottom: 0; }

  .times-wrap { padding-block: 0 clamp(56px,7vw,92px); }
  .times__h { color: var(--red); margin: 0 0 26px; }
  .times { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px,1fr)); gap: 30px;
           border-top: 2px solid var(--ink); padding-top: 26px; }
  .tgroup__day { margin: 0 0 12px; font-size: 12px; font-weight: 700; letter-spacing: .16em;
                 text-transform: uppercase; color: var(--ink-soft); }
  .tgroup__list { list-style: none; margin: 0; padding: 0; }
  .tgroup__list li { display: flex; align-items: baseline; justify-content: space-between;
                     gap: 16px; padding: 9px 0; border-bottom: 1px solid var(--hair); }
  .tgroup__name { font-family: var(--font-display); font-size: 21px; line-height: 1.2; }
  .tgroup__time { font-size: 16px; color: var(--ink-soft); white-space: nowrap; }

  .plan-wrap { padding-block: 0 clamp(56px,7vw,92px); }
  .plan { display: grid; grid-template-columns: minmax(0,1.25fr) minmax(0,1fr); gap: 60px; align-items: start; }
  .plan__h { color: var(--red); margin: 0 0 14px; }
  .plan__lead { margin: 0 0 14px; font-size: clamp(24px,3vw,34px); line-height: 1.14; }
  .plan__p { margin: 0; font-size: 17px; line-height: 1.78; color: var(--ink-soft); max-width: 48ch; }
  .plan__acts { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  .plan__side { background: var(--cream-deep); border-radius: var(--radius-lg); padding: clamp(26px,3vw,34px); }
  .plan__sl { color: var(--red); margin: 0 0 12px; }
  .plan__sp { margin: 0; font-size: 16px; line-height: 1.75; color: var(--ink-soft); }
  .plan__sp a { color: var(--red); text-decoration: underline; text-underline-offset: 3px; }
  .plan__link { display: inline-block; margin-top: 18px; font-size: 15px; font-weight: 700; color: var(--red); }

  .cta-wrap { padding-block: 0 clamp(70px,8vw,110px); }
  .cta { background: var(--ink); color: var(--cream); border-radius: var(--radius-lg);
         padding: clamp(40px,5vw,64px); display: flex; align-items: center;
         justify-content: space-between; gap: 34px; flex-wrap: wrap; }
  .cta__title { margin: 0 0 10px; font-size: clamp(26px,3.4vw,38px); line-height: 1.14; }
  .cta__p { margin: 0; font-size: 16px; line-height: 1.7; color: rgba(244,239,231,.72); max-width: 50ch; }
  .cta__btn { flex-shrink: 0; }

  @media (max-width: 860px) {
    .nhero__body { padding: 108px var(--pad) 46px; }
    .expect, .plan { grid-template-columns: 1fr; gap: 28px; }
    .cta__btn { width: 100%; }
  }
</style>
