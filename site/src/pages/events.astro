---
import BaseLayout from '../layouts/BaseLayout.astro';
import { copyFor } from '../lib/copy';
import EventCard from '../components/EventCard.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { getUpcomingEvents } from '../lib/ical';
import { clockText, eventTimeZone } from '../lib/format';
import bandImg from '../assets/photos/talking.jpg';

const [settingsEntry] = await getCollection('settings');
const settings = settingsEntry.data;

let events: Awaited<ReturnType<typeof getUpcomingEvents>> = [];
let error: string | null = null;
if (settings.calendarFeedUrl) {
  try {
    events = await getUpcomingEvents(settings.calendarFeedUrl, 180);
  } catch (err) {
    error = String(err);
  }
}

// Group into months so a long list stays scannable. Each event is labeled in
// its OWN zone (eventTimeZone) — a shared zone would push an all-day event on
// the 1st of a month back into the previous one on a UTC build machine, which
// is the same class of bug that put the Revival on the wrong day.
const months: { label: string; items: typeof events }[] = [];
for (const e of events) {
  const label = e.start.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: eventTimeZone(e.allDay) });
  const last = months[months.length - 1];
  if (last && last.label === label) last.items.push(e);
  else months.push({ label, items: [e] });
}

/** Page text, editable at /website/copy. Falls back to the words below. */
const t = await copyFor('events');
---
<BaseLayout
  title="Events"
  description="What's coming up at Fairhaven Community Church — plus the weekly rhythm you can count on."
>
  <!-- ============ HEADER ============ -->
  <section class="phead">
    <div class="phead__body">
      <p class="label load d1 phead__eyebrow">{t('header.eyebrow', "What's Happening")}</p>
      <h1 class="serif load d2">{t('header.headline', 'Events')}</h1>
      <p class="phead__lede load d3">
        {t('header.lede', 'Special services, revivals and gatherings. The weekly rhythm below runs whether or not anything special is on the calendar.')}
      </p>
    </div>
  </section>

  <!-- ============ WEEKLY RHYTHM ============ -->
  <section class="wrap week-wrap">
    <div class="week reveal">
      <div class="week__head">
        <p class="label week__h">{t('weekly.eyebrow', 'Every Week')}</p>
        <p class="week__sub">412 Meadowbrook Road</p>
      </div>
      <ul class="week__list">
        {settings.serviceTimes.map((s) => (
          <li class="week__row">
            <span class="week__day">{s.day}</span>
            <span class="week__label">{s.label}</span>
            <span class="week__time">{clockText(s.time)}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ CALENDAR ============ -->
  <section class="wrap cal-wrap">
    <div class="cal__head reveal">
      <p class="label cal__h">{t('calendar.eyebrow', 'On the Calendar')}</p>
      {events.length > 0 && (
        <p class="cal__sub">Next {events.length === 1 ? 'event' : `${events.length} events`}</p>
      )}
    </div>

    {!settings.calendarFeedUrl && (
      <p class="cal__note reveal">
        The event calendar isn't connected yet. Once the "Church Public Events" iCloud
        link is set as <code>calendarFeedUrl</code> in <code>src/content/settings/site.yaml</code>,
        this page and the homepage strip populate automatically on the next build.
      </p>
    )}
    {error && (
      <p class="cal__note reveal">
        Couldn't reach the calendar just now — it'll retry on the next scheduled rebuild.
        The weekly schedule above is unaffected.
      </p>
    )}
    {settings.calendarFeedUrl && !error && events.length === 0 && (
      <p class="cal__note reveal">
        Nothing special on the calendar for the next few months. The weekly services
        above run as usual — come to any of them.
      </p>
    )}

    {months.map((m) => (
      <div class="month">
        <h2 class="month__h reveal">{m.label}</h2>
        <div class="month__list">
          {m.items.map((event) => <EventCard event={event} variant="row" />)}
        </div>
      </div>
    ))}
  </section>

  <!-- ============ CTA BAND ============ -->
  <section class="band" data-par-frame>
    <div class="band__img duo par" data-par="70" style="--drift-scale: 1.34;">
      <Image src={bandImg} alt="Members of the congregation talking after a service"
             widths={[900, 1400, 2000, 2400]} sizes="140vw" />
    </div>
    <div class="band__scrim" aria-hidden="true"></div>
    <div class="band__body par-fg" data-par="-32">
      <p class="label band__eyebrow">{t('band.eyebrow', 'Come Along')}</p>
      <h2 class="serif band__title">{t('band.title', "You don't need an invitation to any of it.")}</h2>
      <p class="band__p">
        Every service and event on this page is open. Turn up, sit anywhere, leave when
        you need to.
      </p>
      <a href="/about" class="btn btn--solid band__btn">{t('band.button', 'Plan your visit')}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .phead { position: relative; background: var(--ink); color: var(--cream); overflow: clip; }
  .phead__body { position: relative; z-index: 3; padding: 150px var(--pad) 86px; }
  .phead__eyebrow { color: rgba(244,239,231,.6); margin: 0 0 20px; }
  .phead h1 { margin: 0; font-size: clamp(46px,6vw,88px); line-height: 1; letter-spacing: -.02em; }
  .phead__lede { margin: 22px 0 0; max-width: 52ch; font-size: 18px; line-height: 1.68; color: rgba(244,239,231,.78); }

  .week-wrap { padding-block: clamp(56px,6vw,86px) 0; }
  .week__head { display: flex; align-items: baseline; justify-content: space-between; gap: 20px;
                border-bottom: 2px solid var(--ink); padding-bottom: 14px; }
  .week__h { color: var(--red); margin: 0; }
  .week__sub { margin: 0; font-size: 14px; color: var(--ink-soft); }
  .week__list { list-style: none; margin: 0; padding: 0; }
  .week__row { display: grid; grid-template-columns: 130px minmax(0,1fr) auto; gap: 20px;
               align-items: baseline; padding: 20px 0; border-bottom: 1px solid var(--hair); }
  .week__day { font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--red); }
  .week__label { font-family: var(--font-display); font-size: clamp(21px,2.4vw,28px); line-height: 1.2; }
  .week__time { font-size: 17px; color: var(--ink-soft); white-space: nowrap; }

  .cal-wrap { padding-block: clamp(60px,7vw,96px) clamp(70px,8vw,110px); }
  .cal__head { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 8px; }
  .cal__h { color: var(--red); margin: 0; }
  .cal__sub { margin: 0; font-size: 14px; color: var(--ink-soft); }
  .cal__note { margin: 22px 0 0; max-width: 60ch; font-size: 17px; line-height: 1.75; color: var(--ink-soft); }
  .cal__note code { background: var(--cream-deep); padding: 1px 5px; border-radius: 3px; font-size: .92em; }

  .month { margin-top: 44px; }
  .month__h { margin: 0; font-family: var(--font-body); font-size: 12px; font-weight: 700;
              letter-spacing: .2em; text-transform: uppercase; color: var(--ink-soft); }
  .month__list { margin-top: 4px; }
  /* the first row's top hairline would double the month rule */
  .month__list :global(.ev:first-child) { border-top: 1px solid var(--hair); }

  /* NOTE: .band__img declares no transform — a scoped one would outrank .par */
  .band { position: relative; overflow: clip; background: var(--ink); color: var(--cream);
          min-height: 62vh; display: flex; align-items: center; }
  .band__img { position: absolute; inset: 0; z-index: 0; }
  .band__img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .band__scrim { position: absolute; inset: 0; z-index: 1;
                 background: linear-gradient(90deg, rgba(26,21,18,.9) 0%, rgba(26,21,18,.72) 55%, rgba(26,21,18,.5) 100%); }
  .band__body { position: relative; z-index: 3; padding: clamp(70px,8vw,110px) var(--pad); max-width: 720px; }
  .band__eyebrow { color: var(--red-tint); margin: 0 0 18px; }
  .band__title { margin: 0; font-size: clamp(30px,4.4vw,54px); line-height: 1.1; letter-spacing: -.01em; }
  .band__p { margin: 18px 0 0; font-size: 17px; line-height: 1.72; color: rgba(244,239,231,.78); max-width: 46ch; }
  .band__btn { margin-top: 30px; }

  @media (max-width: 860px) {
    .phead__body { padding: 110px var(--pad) 52px; }
    .week__row { grid-template-columns: 1fr auto; gap: 6px 16px; }
    .week__day { grid-column: 1 / -1; }
    .band__scrim { background: linear-gradient(180deg, rgba(26,21,18,.72) 0%, rgba(26,21,18,.9) 100%); }
  }
</style>
