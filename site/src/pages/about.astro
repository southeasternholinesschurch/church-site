---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { clockText } from '../lib/format';
import { STAFF_PHOTOS } from '../lib/staff-assets';

import heroImg from '../assets/photos/exterior.jpg';
import beliefsImg from '../assets/photos/preaching-hand.jpg';
import welcomeImg from '../assets/photos/welcome.jpg';
import worshipImg from '../assets/photos/hands.jpg';
import preachingImg from '../assets/photos/preacher.jpg';
import visitImg from '../assets/photos/exterior-wide.jpg';

// Leadership preview — the faces themselves, so the section plainly points at
// the staff page rather than being congregation copy with a staff link bolted on.
const staff = (await getCollection('staff')).sort((a, b) => a.data.order - b.data.order);

const [settingsEntry] = await getCollection('settings');
const settings = settingsEntry.data;
---
<BaseLayout
  title="About"
  description="More than a congregation — who we are, what we believe, and what to expect on your first Sunday at Fairhaven Community Church."
>
  <!-- ============ HERO — THE BUILDING ============ -->
  <section class="ahero grain" data-par-frame>
    <Image
      src={heroImg}
      alt="Fairhaven Community Church seen from the lawn"
      class="ahero__img par"
      widths={[640, 1024, 1600, 2400]}
      sizes="140vw"
      loading="eager"
      fetchpriority="high"
      data-par="100"
      style="--drift-scale: 1.32;"
    />
    <div class="ahero__grade"></div>

    <div class="ahero__body par-fg" data-par="-30">
      <p class="label load d1 ahero__eyebrow">About</p>
      <h1 class="serif load d2">More than a <em>congregation</em>.</h1>
      <p class="ahero__lede load d3">
        A family where hearts are mended, hope is restored, and lives are changed —
        on Meadowbrook Road since 1968.
      </p>
    </div>
  </section>

  <!-- ============ MISSION ============ -->
  <section class="mission wrap">
    <p class="label reveal mission__h">Our Mission</p>
    <p class="serif reveal mission__stmt">
      We exist to glorify God by making Christ known, nurturing believers, and
      serving our community with <em>love and truth</em>.
    </p>
    <div class="growx mission__rule"></div>
  </section>

  <!-- ============ WHAT WE BELIEVE ============ -->
  <section class="wrap sect">
    <div class="split reveal">
      <div class="split__media">
        <Image src={beliefsImg} alt="Pastor the pastor preaching on a Sunday morning"
               widths={[600, 1024, 1600]} sizes="(max-width: 760px) 100vw, 50vw" />
      </div>
      <div>
        <p class="label split__h">What We Believe</p>
        <h2 class="serif split__title">Historic Christian truth, lived out.</h2>
        <p class="split__p">
          We hold to the authority of Scripture, the power of prayer, and the necessity
          of a personal relationship with Jesus.
        </p>
        <p class="split__p">
          We are committed to holiness — to walking in the Spirit and reflecting Christ's
          character in everyday life, shaped by surrender to God's will rather than by
          whatever happens to be fashionable.
        </p>
        <a href="/about/beliefs" class="split__more">Read what we believe →</a>
      </div>
    </div>
  </section>

  <!-- ============ WHAT TO EXPECT ============ -->
  <section class="wrap sect">
    <div class="sect__head reveal">
      <p class="label sect__h">What To Expect</p>
      <p class="sect__sub">Your first Sunday, roughly</p>
        <a href="/about/im-new" class="split__more">New here? Start here →</a>
    </div>
    <div class="beats3">
      <div class="beat reveal">
        <div class="beat__media">
          <Image src={welcomeImg} alt="Being greeted at the door before the service"
                 widths={[500, 900, 1400]} sizes="(max-width: 760px) 100vw, 33vw" />
        </div>
        <h3 class="serif">A warm welcome</h3>
        <p>You'll be greeted, not processed. Come as you are — there's no dress code, and
           no expectation that you already know anyone.</p>
      </div>
      <div class="beat reveal">
        <div class="beat__media">
          <Image src={worshipImg} alt="The congregation with hands raised in worship"
                 widths={[500, 900, 1400]} sizes="(max-width: 760px) 100vw, 33vw" />
        </div>
        <h3 class="serif">Heartfelt worship</h3>
        <p>Hymns sung together, from the book. Reverence and joy in the same room —
           tradition held with authenticity.</p>
      </div>
      <div class="beat reveal">
        <div class="beat__media">
          <Image src={preachingImg} alt="Assistant Pastor the assistant pastor preaching"
                 widths={[500, 900, 1400]} sizes="(max-width: 760px) 100vw, 33vw" />
        </div>
        <h3 class="serif">Preaching for real life</h3>
        <p>Biblical and direct, grounded in the week you actually just had — conviction
           carried with compassion.</p>
      </div>
    </div>
  </section>

  <!-- ============ LEADERSHIP ============ -->
  <section class="wrap sect">
    <div class="lead reveal">
      <div class="lead__intro">
        <p class="label lead__h">Our Leadership</p>
        <h2 class="serif lead__title">The people who serve here.</h2>
        <p class="lead__p">
          Around 150 of us gather each week — families who've been at Fairhaven for
          decades alongside people who first walked in last month. These are the people
          who look after them.
        </p>
        <a href="/about/staff" class="btn btn--ink lead__btn">Meet the staff</a>
      </div>

      <ul class="lead__people">
        {staff.map((person) => {
          const photo = person.data.photo ? STAFF_PHOTOS[person.data.photo] : undefined;
          return (
            <li class="lead__person">
              <a href="/about/staff">
                {photo ? (
                  <span class="lead__ring">
                    <Image src={photo} alt={person.data.photoAlt ?? `${person.data.name}, ${person.data.role}`}
                           widths={[180, 280, 400]} sizes="130px"
                           style={`object-position: 50% ${person.data.focus}%;`} />
                  </span>
                ) : (
                  <span class="lead__ring lead__ring--empty" aria-hidden="true"></span>
                )}
                <span class="lead__name">{person.data.name}</span>
                <span class="lead__role">{person.data.role}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- ============ PLAN YOUR VISIT ============ -->
  <section class="wrap sect">
    <div class="visit reveal">
      <Image src={visitImg} alt="" class="visit__img"
             widths={[900, 1400, 2000]} sizes="100vw" />
      <div class="visit__grade"></div>
      <div class="visit__body">
        <p class="label visit__eyebrow">Plan Your Visit</p>
        <h2 class="serif visit__title">Come this Sunday.</h2>
        <div class="visit__rows">
          {settings.serviceTimes.map((s) => (
            <div class="visit__row">
              <span>{s.label}</span>
              <span class="serif visit__time">{clockText(s.time)}</span>
            </div>
          ))}
        </div>
        <p class="visit__addr">412 Meadowbrook Road<br />Fairhaven 46203</p>
        <div class="visit__acts">
          <a href={settings.mapsUrl} target="_blank" rel="noreferrer" class="btn btn--solid">Get directions</a>
          <a href="/livestream" class="btn btn--ghost">Watch a service first</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* no transform here — .par owns it, and a scoped rule would outrank it */
  .ahero { position: relative; min-height: 760px; overflow: clip; background: var(--ink); display: flex; flex-direction: column; }
  .ahero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ahero__grade {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(26,21,18,.52) 0%, rgba(26,21,18,.12) 30%, rgba(26,21,18,.5) 66%, rgba(26,21,18,.94) 100%);
  }
  .ahero__body { position: relative; z-index: 3; margin-top: auto; padding: 0 var(--pad) 74px; }
  .ahero__eyebrow { color: rgba(244,239,231,.72); margin: 0 0 22px; }
  .ahero h1 { margin: 0; color: var(--cream); font-size: clamp(46px,7.6vw,110px); line-height: .96; letter-spacing: -.022em; max-width: 14ch; }
  .ahero h1 :global(em) { font-style: italic; color: var(--red-tint); }
  .ahero__lede { margin: 28px 0 0; max-width: 48ch; font-size: 18px; line-height: 1.68; color: rgba(244,239,231,.82); }

  .mission { padding-block: clamp(78px,10vw,144px) clamp(60px,8vw,110px); max-width: 1180px; margin-inline: auto; text-align: center; }
  .mission__h { color: var(--red); margin: 0 0 32px; }
  .mission__stmt { margin: 0 auto; font-size: clamp(30px,4.4vw,56px); line-height: 1.22; letter-spacing: -.012em; max-width: 21ch; }
  .mission__stmt :global(em) { font-style: italic; color: var(--red); }
  .mission__rule { height: 1px; background: var(--red); width: 130px; margin: 52px auto 0; }

  .sect { padding-bottom: clamp(76px,9vw,130px); }
  .sect__head { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 46px; }
  .sect__h { color: var(--red); margin: 0; }
  .sect__sub { margin: 0; font-size: 15px; color: var(--ink-soft); }

  .split { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 72px; align-items: center; }
  .split--flip .split__media { order: 2; }
  .split__media { position: relative; aspect-ratio: 4/3; overflow: clip; border-radius: var(--radius); background: var(--ink); }
  .split__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .split__h { color: var(--red); margin: 0 0 20px; }
  .split__title { margin: 0 0 22px; font-size: clamp(30px,3.8vw,46px); line-height: 1.14; }
  .lead { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1.15fr);
          gap: 60px; align-items: center; }
  .lead__h { color: var(--red); margin: 0 0 14px; }
  .lead__title { margin: 0 0 14px; font-size: clamp(30px,4vw,48px); line-height: 1.08; letter-spacing: -.02em; }
  .lead__p { margin: 0; font-size: 17px; line-height: 1.78; color: var(--ink-soft); max-width: 44ch; }
  .lead__btn { margin-top: 26px; }
  .lead__people { list-style: none; margin: 0; padding: 0; display: grid;
                  grid-template-columns: repeat(auto-fit, minmax(130px,1fr)); gap: 30px 20px; }
  .lead__person a { display: block; text-align: center; color: inherit; }
  .lead__ring { display: block; width: 130px; aspect-ratio: 1; margin: 0 auto 14px;
                border-radius: 50%; overflow: hidden; background: var(--cream-deep); }
  .lead__ring :global(img) { width: 100%; height: 100%; object-fit: cover; display: block;
                             transition: transform .6s var(--ease); }
  .lead__person a:hover .lead__ring :global(img) { transform: scale(1.05); }
  .lead__ring--empty { border: 1px dashed rgba(26,21,18,.22); }
  .lead__name { display: block; font-family: var(--font-display); font-size: 20px; line-height: 1.2; }
  .lead__role { display: block; margin-top: 4px; font-size: 11px; font-weight: 700;
                letter-spacing: .16em; text-transform: uppercase; color: var(--red); }

  .split__more { display: inline-block; margin-top: 18px; font-size: 15px;
                 font-weight: 700; color: var(--red); }
  .split__p { margin: 0 0 18px; font-size: 17px; line-height: 1.78; color: var(--ink-soft); }
  .split__p:last-child { margin-bottom: 0; }

  .beats3 { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 44px; }
  .beat__media { position: relative; aspect-ratio: 3/2; overflow: clip; border-radius: var(--radius); background: var(--ink); margin-bottom: 24px; }
  .beat__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .beat h3 { margin: 0 0 12px; font-size: clamp(26px,3.1vw,32px); line-height: 1.18; }
  .beat p { margin: 0; font-size: 16px; line-height: 1.78; color: var(--ink-soft); }

  .visit { position: relative; overflow: clip; background: var(--ink); color: var(--cream); border-radius: var(--radius-lg); }
  .visit__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .visit__grade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(26,21,18,.95) 34%, rgba(26,21,18,.6) 66%, rgba(26,21,18,.35) 100%); }
  .visit__body { position: relative; z-index: 2; padding: 68px 60px; max-width: 620px; }
  .visit__eyebrow { color: rgba(244,239,231,.62); margin: 0 0 18px; }
  .visit__title { margin: 0 0 26px; font-size: clamp(30px,4vw,48px); line-height: 1.12; }
  .visit__rows { margin-bottom: 28px; }
  .visit__row { border-top: 1px solid var(--hair-inv); padding: 13px 0; display: flex; justify-content: space-between; gap: 20px; font-size: 16px; }
  .visit__row:last-of-type { border-bottom: 1px solid var(--hair-inv); }
  .visit__time { font-family: var(--font-display); font-size: 22px; }
  .visit__addr { margin: 0 0 28px; font-size: 16px; line-height: 1.7; color: rgba(244,239,231,.76); }
  .visit__acts { display: flex; gap: 12px; flex-wrap: wrap; }

  @media (max-width: 860px) {
    .ahero { min-height: 560px; }
    .split { grid-template-columns: 1fr; gap: 30px; }
    .split--flip .split__media { order: 0; }
    .beats3 { grid-template-columns: 1fr; gap: 40px; }
    .visit__body { padding: 40px 24px; }
    .visit__acts :global(.btn) { width: 100%; }
  }
</style>
