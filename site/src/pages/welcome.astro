---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuestCardForm from '../components/GuestCardForm.astro';
import { getCollection } from 'astro:content';
import { copyFor } from '../lib/copy';

/**
 * The guest card — what the NFC tags in the pews and the link-tree open.
 *
 * Built for one moment: somebody in a pew, on their phone, during the
 * announcements or just after the benediction. So it is short, it asks for a
 * first name and nothing else is required, and it loads before the card is put
 * back in the rack. Everything they send goes to the pastors' follow-up list in
 * the staff app (Care), not to the church inbox.
 *
 * Kept out of search results and the sitemap: it is a card handed out in the
 * building, not a page anybody should land on from Google. Plan Your Visit is
 * the page for people who have not come yet.
 */
const [settingsEntry] = await getCollection('settings');
const settings = settingsEntry.data;
const t = await copyFor('welcome');
---
<BaseLayout
  title="Welcome"
  description="Glad you're here. Let the pastor know you came, or ask for a visit or a call."
  noindex
>
  <section class="wh">
    <div class="wh__body">
      <p class="label load d1 wh__eyebrow">{t('hero.eyebrow', 'Welcome')}</p>
      <h1 class="serif load d2">{t('hero.headline', "We're glad you're here.")}</h1>
      <p class="wh__lede load d3">
        {t('hero.lede', "Whether it's your first Sunday or your fiftieth, let us know you came. Only your first name is needed — and if you'd like a visit or a call, this is the way to ask.")}
      </p>
    </div>
  </section>

  <section class="wrap wcard">
    <div class="wcard__in">
      <GuestCardForm mode="here" t={t} smsNumber={settings.smsNumber} />
    </div>
  </section>

  <section class="wrap wmore">
    <p class="label wmore__h">{t('links.heading', 'While you are here')}</p>
    <nav class="wmore__links" aria-label="More for visitors">
      <a href="/bulletin">{t('links.bulletin', "This week's bulletin")}</a>
      <a href="/ministries">{t('links.ministries', 'For kids, youth and families')}</a>
      <a href="/about/beliefs">{t('links.beliefs', 'What we believe')}</a>
      <a href="/give">{t('links.give', 'Give')}</a>
    </nav>
  </section>
</BaseLayout>

<style>
  .wh { background: var(--ink); color: var(--cream); }
  .wh__body { padding: 130px var(--pad) clamp(40px, 5vw, 64px); max-width: 760px; }
  .wh__eyebrow { color: var(--red-tint); margin: 0 0 16px; }
  .wh h1 { margin: 0; font-size: clamp(40px, 5.6vw, 76px); line-height: 1.02; letter-spacing: -.02em; }
  .wh__lede { margin: 20px 0 0; max-width: 52ch; font-size: 18px; line-height: 1.7; color: rgba(244,239,231,.8); }

  .wcard { padding-block: clamp(36px, 5vw, 64px) 0; }
  .wcard__in { max-width: 760px; }

  .wmore { padding-block: clamp(36px, 5vw, 56px) clamp(70px, 8vw, 110px); }
  .wmore__h { color: var(--red); margin: 0 0 14px; }
  .wmore__links { display: flex; flex-wrap: wrap; gap: 10px; max-width: 760px; }
  .wmore__links a { font-size: 15px; font-weight: 700; padding: 11px 18px; border-radius: 999px;
                    border: 1px solid var(--hair); color: var(--ink); }
  .wmore__links a:hover { border-color: var(--ink); }

  @media (max-width: 860px) {
    .wh__body { padding: 104px var(--pad) 40px; }
  }
</style>
