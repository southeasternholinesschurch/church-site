---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { getUpcomingEvents } from '../lib/ical';
import { clockLabel } from '../lib/format';

import heroImg from '../assets/photos/worship.jpg';
import quoteImg from '../assets/photos/prayer.jpg';
import { MINISTRY_PHOTOS } from '../lib/ministry-assets';

const [settingsEntry] = await getCollection('settings');
const settings = settingsEntry.data;

let upcoming: Awaited<ReturnType<typeof getUpcomingEvents>> = [];
let eventsError: string | null = null;
if (settings.calendarFeedUrl) {
  try {
    upcoming = (await getUpcomingEvents(settings.calendarFeedUrl, 30)).slice(0, 3);
  } catch (err) {
    eventsError = String(err);
  }
}

const ministries = (await getCollection('ministries')).sort((a, b) => a.data.order - b.data.order);
/*
 * The SAME map the ministries pages use, not a second copy of it.
 *
 * This page kept its own list, so a ministry could show one photo here and a
 * different one on its own page — which is precisely what ministry-assets.ts
 * exists to prevent, and what happened the moment Fairhaven Youth's photo changed.
 */
const ministryImages = MINISTRY_PHOTOS;

---
<BaseLayout title="Home">
  <!-- ============ HERO ============ -->
  <section class="hero grain" data-par-frame>
    <!-- The photo drifts as the hero crosses the viewport while the copy
         lifts against it; the differential is what reads as depth.
         data-par is travel in px. Two constraints pull against each other:
         it must stay under the image's overhang, (scale-1)*height/2, or
         the photo's edge slides into frame — but it also has to be large
         enough to SEE. The background needs to lag the page by roughly
         15-20% of the scroll distance; below about 10% nobody notices it.
         More lag therefore means more scale, which is why these are 1.35
         and 1.40 rather than something subtler. -->
    <Image
      src={heroImg}
      alt="The congregation gathered for Sunday morning worship"
      class="hero__img par"
      widths={[640, 1024, 1600, 2400]}
      sizes="140vw"
      loading="eager"
      fetchpriority="high"
      data-par="120" style="--drift-scale: 1.35;"
    />
    <div class="hero__grade"></div>
    <div class="hero__wash"></div>

    <div class="hero__body">
      <div class="hero__lead par-fg" data-par="-34">
        <p class="label load d1 hero__eyebrow">Welcome · Worship · Word</p>
        <h1 class="serif load d2">A place to <em>call home</em></h1>
        <p class="hero__lede load d3">
          More than a congregation — a family where hearts are mended, hope is
          restored, and lives are changed.
        </p>
        <div class="hero__acts load d4">
          <a href="/about" class="btn btn--solid">Plan Your Visit</a>
          <a href={settings.mapsUrl} target="_blank" rel="noreferrer" class="btn btn--ghost">Get Directions</a>
        </div>
      </div>

      <!-- editorial gathering-times column -->
      <div class="times load d5">
        <div class="times__rule growx"></div>
        <p class="label times__h">We Gather</p>
        {settings.serviceTimes.map((s) => {
          const t = clockLabel(s.time);
          return (
            <div class="times__row">
              <div class="serif times__n">{t.time}<span>{t.suffix}</span></div>
              <div class="label times__l">{s.label}</div>
            </div>
          );
        })}
        <p class="times__addr">412 Meadowbrook Road<br />Fairhaven, IN 46140</p>
      </div>
    </div>
  </section>

  <!-- ============ SERVICE TIMES — MOBILE ONLY ============ -->
  <!-- Deliberately a different composition from the desktop hero column, not
       a reflow of it. On a narrow screen the times cannot share the hero: they
       stack under the buttons, push the whole block past the fold, and land on
       the busiest part of the photograph. Here they get solid ground, room to
       breathe, and a two-up row that is quicker to scan than the stacked
       version ever was. The hero keeps only the invitation. -->
  <section class="gather grain">
    <div class="wrap gather__inner">
      <p class="label gather__h reveal">We Gather</p>
      <dl class="gather__list">
        {settings.serviceTimes.map((s) => {
          const t = clockLabel(s.time);
          return (
            <div class="gather__row reveal">
              <dt class="serif gather__n">{t.time}<span>{t.suffix}</span></dt>
              <dd class="label gather__l">{s.label}</dd>
            </div>
          );
        })}
      </dl>
      <p class="gather__addr reveal">412 Meadowbrook Road<br />Fairhaven, IN 46140</p>
    </div>
  </section>

  <!-- ============ MISSION ============ -->
  <section class="mission wrap">
    <h2 class="label reveal mission__h">Why We're Here</h2>
    <p class="serif reveal mission__stmt">
      We exist to glorify God by making Christ known, nurturing believers, and
      serving our community with <em>love and truth</em>.
    </p>
    <div class="growx mission__rule"></div>
  </section>

  <!-- ============ THREE BEATS ============ -->
  <section class="beats wrap">
    <div class="beat reveal">
      <div class="serif beat__n">01</div>
      <div class="beat__rule"></div>
      <h3 class="serif">A warm welcome</h3>
      <p>You'll be greeted, not processed. Come as you are — no dress code, and no
         expectation that you already know anyone.</p>
    </div>
    <div class="beat reveal">
      <div class="serif beat__n">02</div>
      <div class="beat__rule"></div>
      <h3 class="serif">Heartfelt worship</h3>
      <p>Hymns sung together, from the book. Reverence and joy in the same room —
         tradition held with authenticity.</p>
    </div>
    <div class="beat reveal">
      <div class="serif beat__n">03</div>
      <div class="beat__rule"></div>
      <h3 class="serif">Preaching for real life</h3>
      <p>Biblical and direct, grounded in the week you actually just had —
         conviction carried with compassion.</p>
    </div>
  </section>

  <!-- ============ PHOTO BAND — the parallax moment ============ -->
  <!-- the photo drifts one way, the quote lifts the other: the differential
       is what reads as depth, not the movement of either on its own -->
  <section class="band grain" data-par-frame>
    <Image
      src={quoteImg}
      alt=""
      class="band__img par"
      widths={[640, 1024, 1600, 2400]}
      sizes="140vw"
      data-par="75" style="--drift-scale: 1.40;"
    />
    <div class="band__grade"></div>
    <div class="band__body wrap">
      <p class="serif band__quote par-fg fade" data-par="-40">
        “Whether you're seeking answers, carrying a burden, or just looking for a
        spiritual home — <em>you're always welcome here.</em>”
      </p>
    </div>
  </section>

  <!-- ============ EVENTS ============ -->
  <section class="events wrap">
    <div class="events__head reveal">
      <h2 class="label events__h">What's Happening</h2>
      <a href="/events" class="events__all">See all events →</a>
    </div>

    {!settings.calendarFeedUrl && (
      <p class="events__empty">
        The calendar isn't connected yet — set <code>calendarFeedUrl</code> in
        <code>src/content/settings/site.yaml</code>.
      </p>
    )}
    {eventsError && <p class="events__empty">Couldn't reach the calendar just now. It'll retry on the next rebuild.</p>}
    {upcoming.length > 0 && (
      <div class="events__grid">{upcoming.map((event) => <EventCard event={event} />)}</div>
    )}
    {settings.calendarFeedUrl && !eventsError && upcoming.length === 0 && (
      <p class="events__empty">Nothing on the calendar in the next few weeks — check back soon.</p>
    )}
  </section>

  <!-- ============ MINISTRIES ============ -->
  <section class="mins wrap">
    <div class="mins__head reveal">
      <h2 class="label mins__h">Ministries</h2>
      <p class="mins__sub">Something for every season of life</p>
    </div>
    <div class="mins__grid">
      {ministries.map((m) => (
        <a href={`/ministries/${m.slug}`} class="min reveal" data-ministry={m.data.accent}>
          <div class="min__media">
            {ministryImages[m.data.photo ?? ""] ? (
              <Image src={ministryImages[m.data.photo ?? ""]!} alt="" widths={[400, 800]} sizes="(max-width: 760px) 50vw, 25vw" />
            ) : (
              <div class="min__placeholder" aria-hidden="true"></div>
            )}
          </div>
          <h3 class="serif min__name">{m.data.name}</h3>
          {m.data.ageRange && <span class="label min__age">{m.data.ageRange}</span>}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- hero ---------- */
  /* overflow: clip, NOT hidden. `hidden` makes an element a scroll
     container, and a view() timeline binds to its subject's nearest
     scrollport — so a parallax image inside an overflow:hidden hero
     binds to the hero, which never scrolls, and the timeline goes
     inactive. `clip` clips identically without becoming a scroller. */
  .hero {
    position: relative; min-height: 980px; overflow: clip;
    background: var(--ink); display: flex; flex-direction: column;
  }
  .hero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* Grade weight sits at the BOTTOM, where the headline is, and stays light
     across the middle so the photograph is actually visible. Tuned against
     this specific photo — the sanctuary ceiling is bright, and an even
     grade heavy enough for the text crushed the whole image to near-black. */
  .hero__grade {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(26,21,18,.46) 0%, rgba(26,21,18,.06) 24%, rgba(26,21,18,.34) 58%, rgba(26,21,18,.88) 100%);
  }
  /* separate right-hand wash so the times column stays readable whatever
     photo sits behind it */
  .hero__wash {
    position: absolute; inset: 0;
    background: linear-gradient(270deg, rgba(26,21,18,.74) 0%, rgba(26,21,18,.52) 16%, rgba(26,21,18,.16) 34%, transparent 50%);
  }
  /* Mobile only; the desktop hero carries its own times column. */
  .gather { display: none; background: var(--ink); color: var(--cream); }
  .gather__inner { padding-block: 46px 52px; }
  .gather__h { color: var(--red-tint); margin: 0 0 22px; }
  .gather__list { margin: 0; }
  /* Two-up and baseline-aligned: the eye reads down the times, and the service
     names sit off to the right instead of doubling the height of every row. */
  .gather__row {
    display: grid; grid-template-columns: auto 1fr; gap: 0 20px; align-items: baseline;
    border-top: 1px solid var(--hair-inv); padding: 15px 0 16px;
  }
  .gather__row:last-of-type { border-bottom: 1px solid var(--hair-inv); }
  .gather__n { font-family: var(--font-display); font-size: 38px; line-height: 1;
               color: var(--cream); margin: 0; }
  .gather__n span { font-size: 17px; color: rgba(244,239,231,.66); margin-left: 3px; }
  .gather__l { margin: 0; color: rgba(244,239,231,.78); text-align: right; }
  .gather__addr { margin: 26px 0 0; font-size: 15px; line-height: 1.7;
                  color: rgba(244,239,231,.62); }

  .hero__body {
    position: relative; z-index: 3; margin-top: auto;
    /* The top padding is what keeps the headline out from under the fixed
       masthead. `margin-top: auto` bottom-anchors this block, which reads as
       "it can never reach the top" — but that only holds while the hero is
       taller than its content. On a narrow screen the buttons stack and the
       service list grows past the hero's min-height, auto has no free space
       left to distribute, and the content starts at y=0 with the wordmark
       printed straight over the h1. Reserving the masthead's height here
       costs nothing in the roomy case, because the block stays
       bottom-anchored either way. */
    padding: 120px var(--pad) 72px;
    display: grid; grid-template-columns: minmax(0,1fr) 292px; gap: 84px; align-items: end;
  }
  .hero__eyebrow { color: rgba(244,239,231,.74); margin: 0 0 24px; }
  .hero h1 {
    margin: 0; color: var(--cream);
    font-size: clamp(52px, 8.9vw, 128px); line-height: .94; letter-spacing: -.022em; max-width: 12ch;
  }
  .hero h1 :global(em) { font-style: italic; color: var(--red-tint); }
  .hero__lede { margin: 34px 0 0; max-width: 46ch; font-size: 18px; line-height: 1.68; color: rgba(244,239,231,.82); }
  .hero__acts { display: flex; gap: 13px; margin-top: 36px; flex-wrap: wrap; }

  .times { position: relative; padding-bottom: 6px; }
  .times__rule { position: absolute; left: -34px; top: 6px; bottom: 6px; width: 1px; background: rgba(244,239,231,.28); transform-origin: top; }
  .times__h { color: rgba(244,239,231,.72); margin: 0 0 20px; }
  .times__row { border-top: 1px solid var(--hair-inv); padding: 15px 0 14px; }
  .times__row:last-of-type { border-bottom: 1px solid var(--hair-inv); }
  .times__n { font-family: var(--font-display); font-size: 40px; line-height: 1; color: var(--cream); }
  .times__n span { font-size: 19px; color: rgba(244,239,231,.62); margin-left: 3px; }
  .times__l { color: rgba(244,239,231,.74); margin-top: 8px; }
  .times__addr { margin: 20px 0 0; font-size: 13px; line-height: 1.65; color: rgba(244,239,231,.7); }

  /* ---------- mission ---------- */
  .mission { padding-block: clamp(78px,10vw,150px) clamp(70px,9vw,130px); max-width: 1180px; margin-inline: auto; text-align: center; }
  .mission__h { color: var(--red); margin: 0 0 34px; }
  .mission__stmt { margin: 0 auto; font-size: clamp(30px,4.4vw,56px); line-height: 1.22; letter-spacing: -.012em; max-width: 21ch; }
  .mission__stmt :global(em) { font-style: italic; color: var(--red); }
  .mission__rule { height: 1px; background: var(--red); width: 130px; margin: 56px auto 0; }

  /* ---------- beats ---------- */
  .beats { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 62px; padding-bottom: clamp(80px,9vw,140px); }
  .beat__n { font-family: var(--font-display); font-size: 20px; color: var(--red); }
  .beat__rule { height: 1px; background: var(--hair); margin: 18px 0 24px; }
  .beat h3 { margin: 0 0 14px; font-size: clamp(27px,3.2vw,32px); line-height: 1.2; }
  .beat p { margin: 0; font-size: 16px; line-height: 1.78; color: var(--ink-soft); }

  /* ---------- photo band ---------- */
  .band { position: relative; height: 560px; overflow: clip; background: var(--ink); }
  .band__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; }
  .band__grade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(26,21,18,.94) 22%, rgba(26,21,18,.42) 68%, rgba(26,21,18,.2) 100%); }
  .band__body { position: relative; z-index: 2; height: 100%; display: flex; align-items: center; }
  .band__quote { margin: 0; max-width: 46ch; font-size: clamp(26px,4vw,52px); line-height: 1.24; color: var(--cream); letter-spacing: -.01em; }
  .band__quote :global(em) { font-style: italic; color: var(--red-tint); }

  /* ---------- events ---------- */
  .events { padding-block: clamp(78px,9vw,130px) 0; }
  .events__head { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 34px; }
  .events__h { color: var(--red); margin: 0; }
  .events__all { font-size: 15px; }
  .events__grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(290px,1fr)); }
  .events__empty { color: var(--ink-soft); max-width: 56ch; }

  /* ---------- ministries ---------- */
  .mins { padding-block: clamp(78px,9vw,130px); }
  .mins__head { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 40px; }
  .mins__h { color: var(--red); margin: 0; }
  .mins__sub { margin: 0; font-size: 15px; color: var(--ink-soft); }
  .mins__grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 26px; }
  .min { color: inherit; display: block; }
  .min__media { position: relative; aspect-ratio: 4/3; overflow: clip; border-radius: var(--radius); background: var(--cream-deep); }
  .min__media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .7s var(--ease); }
  .min:hover .min__media :global(img) { transform: scale(1.05); }
  /* the ministry accent appears only here, as a thin edge — never the page palette */
  .min__media::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 4px; background: var(--ministry-accent, var(--red)); }
  /* no photo yet: a tint in the ministry's colour, not a "needed" marker */
  .min__placeholder { position: absolute; inset: 0;
                      background: color-mix(in srgb, var(--ministry-accent, var(--red)) 18%, var(--cream-deep)); }
  .min__name { margin: 16px 0 4px; font-size: clamp(24px,2.6vw,30px); line-height: 1.14; }
  .min__age { color: var(--red); }

  /* ---------- phone ---------- */
  @media (max-width: 860px) {
    .hero { min-height: 820px; }
    /* Both grades above encode the DESKTOP geometry, and neither survives the
       stack. The bottom-weighted grade assumes the text sits in a band at the
       foot of the hero — once it fills the whole height, the lede lands on the
       bright middle of the photograph. And the right-hand wash darkens the
       column the times occupy on desktop; stacked, it is shading empty space
       while the times themselves sit unprotected over faces and pews.
       One vertical grade instead, staying light only across the top where
       nothing is printed. */
    .hero__grade {
      background: linear-gradient(180deg,
        rgba(26,21,18,.54) 0%, rgba(26,21,18,.28) 13%, rgba(26,21,18,.70) 34%,
        rgba(26,21,18,.88) 60%, rgba(26,21,18,.95) 100%);
    }
    .hero__wash { display: none; }
    .hero__body { grid-template-columns: 1fr; gap: 34px; padding-bottom: 52px; }
    /* the times move out of the hero entirely — see the .gather section */
    .times { display: none; }
    .gather { display: block; }
    .hero__lede { font-size: 16px; margin-top: 22px; }
    .hero__acts { flex-direction: column; }
    .hero__acts :global(.btn) { width: 100%; }
    .times__rule { display: none; }
    .times__row { padding: 11px 0 10px; }
    .times__n { font-size: 30px; }
    .times__n span { font-size: 15px; }
    .beats { grid-template-columns: 1fr; gap: 40px; }
    .band { height: 420px; }
    .mins__grid { grid-template-columns: 1fr 1fr; gap: 16px; }
  }
</style>
