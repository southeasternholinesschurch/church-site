---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SermonCard from '../../components/SermonCard.astro';
import { getCollection } from 'astro:content';
import { isVisibleSermon, SERMON_WINDOW_MONTHS } from '../../lib/content';
import { slugify } from '../../lib/slugify';
import { SERVICE_TYPE_LABELS } from '../../lib/sermons';

export const getStaticPaths = (async () => {
  const sermons = await getCollection('sermons', ({ data }) => isVisibleSermon(data));
  return sermons.map((sermon) => ({ params: { slug: sermon.slug }, props: { sermon } }));
}) satisfies GetStaticPaths;

const { sermon } = Astro.props;
const { Content } = await sermon.render();
const { title, series, speaker, date, scripture, youtubeId, service, serviceType } = sermon.data;
// Imported services carry no sermon title; the service label is the heading.
const heading = title?.trim() || service;
// timeZone: 'UTC' — see the comment in SermonCard.astro; the frontmatter
// date is date-only and coerces to UTC midnight, so pin the zone here too.
const dateLabel = date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

// "More from this series" first, falling back to the most recent messages —
// a sermon page should never be a dead end.
const all = (await getCollection('sermons', ({ data }) => isVisibleSermon(data)))
  .filter((s) => s.slug !== sermon.slug)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const sameSeries = series ? all.filter((s) => s.data.series === series) : [];
const more = (sameSeries.length ? sameSeries : all).slice(0, 3);
const moreLabel = sameSeries.length ? `More from ${series}` : 'Recent Messages';
---
<BaseLayout title={heading} description={`${heading} at [Your Church Name] — ${dateLabel}.`}>
  <!-- ============ PLAYER ============ -->
  <section class="stage" data-par-frame>
    <div class="stage__bg duo par" data-par="70" style="--drift-scale: 1.28;" aria-hidden="true">
      <img src={`https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg`} alt="" />
    </div>
    <div class="stage__scrim" aria-hidden="true"></div>
    <div class="stage__body">
      <a href="/sermons" class="stage__back load d1">← All sermons</a>
      <div class="stage__head">
        <div class="stage__title">
          {series
            ? <a href={`/sermons/series/${slugify(series)}`} class="label stage__series load d1">{series}</a>
            : <span class="label stage__series stage__series--plain load d1">{SERVICE_TYPE_LABELS[serviceType]}</span>}
          <h1 class="serif load d2">{heading}</h1>
          <p class="stage__meta load d3">{speaker ? `${speaker} · ${dateLabel}` : dateLabel}</p>
          {scripture && <p class="stage__scripture load d3">{scripture}</p>}
        </div>
      </div>
      <div class="stage__embed load d4">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
          title={heading}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- ============ NOTES ============ -->
  <section class="wrap notes-wrap">
    <div class="notes reveal">
      <aside class="notes__side">
        <p class="label notes__l">Service</p>
        <p class="notes__v">{service}</p>
        {speaker && (<><p class="label notes__l">Speaker</p><p class="notes__v">{speaker}</p></>)}
        <p class="label notes__l">Date</p>
        <p class="notes__v">{dateLabel}</p>
        {scripture && (<><p class="label notes__l">Scripture</p><p class="notes__v">{scripture}</p></>)}
        <a href={`https://www.youtube.com/watch?v=${youtubeId}`} target="_blank" rel="noreferrer" class="notes__yt">
          Watch on YouTube ↗
        </a>
      </aside>
      <div class="notes__body">
        <Content />
      </div>
    </div>
  </section>

  <!-- ============ MORE ============ -->
  {more.length > 0 && (
    <section class="wrap more-wrap">
      <div class="more__head reveal">
        <h2 class="label more__h">{moreLabel}</h2>
        <a href="/sermons" class="more__all">All messages →</a>
      </div>
      <div class="more__grid">
        {more.map((s) => <SermonCard sermon={s} />)}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* NOTE: no `transform` here — a scoped transform would outrank `.par`
     (0,2,0 beats 0,1,0) and silently kill the parallax. */
  .stage { position: relative; background: var(--ink); color: var(--cream); overflow: clip; }
  .stage__bg { position: absolute; inset: 0; z-index: 0; }
  .stage__bg :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .stage__scrim { position: absolute; inset: 0; z-index: 1;
                  background: linear-gradient(180deg, rgba(26,21,18,.86) 0%, rgba(26,21,18,.93) 55%, var(--ink) 100%); }
  .stage__body { position: relative; z-index: 3; padding: 128px var(--pad) clamp(60px,7vw,96px); }
  .stage__back { display: inline-block; font-size: 14px; font-weight: 700;
                 color: rgba(244,239,231,.66); margin-bottom: 34px; }
  .stage__back:hover { color: var(--cream); }
  .stage__series { display: inline-block; color: var(--red-tint); margin-bottom: 16px; }
  .stage__series:hover { color: var(--cream); }
  /* not a link when there's no series to link to */
  .stage__series--plain { color: rgba(244,239,231,.6); }
  .stage__series--plain:hover { color: rgba(244,239,231,.6); }
  .stage h1 { margin: 0; font-size: clamp(34px,5.2vw,68px); line-height: 1.05; letter-spacing: -.02em; max-width: 18ch; }
  .stage__meta { margin: 18px 0 0; font-size: 16px; color: rgba(244,239,231,.74); }
  .stage__scripture { margin: 5px 0 0; font-size: 16px; color: var(--red-tint); }
  .stage__embed { margin-top: 46px; aspect-ratio: 16/9; border-radius: var(--radius-lg);
                  overflow: hidden; background: #000; box-shadow: 0 30px 70px rgba(0,0,0,.45); }
  .stage__embed iframe { width: 100%; height: 100%; border: 0; display: block; }

  .notes-wrap { padding-block: clamp(60px,7vw,96px); }
  .notes { display: grid; grid-template-columns: 230px minmax(0,1fr); gap: 66px; }
  .notes__side { border-top: 2px solid var(--ink); padding-top: 18px; align-self: start; }
  .notes__l { color: var(--red); margin: 0 0 4px; }
  .notes__l:not(:first-child) { margin-top: 20px; }
  .notes__v { margin: 0; font-size: 16px; line-height: 1.5; }
  .notes__yt { display: inline-block; margin-top: 28px; font-size: 14px; font-weight: 700; color: var(--red); }
  .notes__body :global(p) { margin: 0 0 18px; font-size: 18px; line-height: 1.8; color: var(--ink-soft); }
  .notes__body :global(h2) { font-family: var(--font-display); font-size: 30px; line-height: 1.2;
                             margin: 40px 0 14px; color: var(--ink); }
  .notes__body :global(h3) { font-size: 17px; font-weight: 700; letter-spacing: .04em;
                             text-transform: uppercase; margin: 32px 0 10px; color: var(--ink); }
  .notes__body :global(ul), .notes__body :global(ol) { margin: 0 0 18px; padding-left: 22px;
                             font-size: 18px; line-height: 1.8; color: var(--ink-soft); }
  .notes__body :global(li) { margin-bottom: 7px; }
  .notes__body :global(blockquote) { margin: 26px 0; padding-left: 24px; border-left: 2px solid var(--red);
                             font-family: var(--font-display); font-size: 22px; line-height: 1.45; color: var(--ink); }
  .notes__body :global(a) { color: var(--red); text-decoration: underline; text-underline-offset: 3px; }
  .notes__body :global(:first-child) { margin-top: 0; }

  .more-wrap { padding-block: 0 clamp(80px,9vw,130px); }
  .more__head { display: flex; align-items: baseline; justify-content: space-between;
                gap: 20px; margin-bottom: 30px; padding-top: 40px; border-top: 1px solid var(--hair); }
  .more__h { color: var(--red); margin: 0; }
  .more__all { font-size: 14px; font-weight: 700; color: var(--ink-soft); }
  .more__all:hover { color: var(--red); }
  .more__grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 34px; }

  @media (max-width: 860px) {
    .stage__body { padding: 104px var(--pad) 52px; }
    .stage__embed { margin-top: 32px; }
    .notes { grid-template-columns: 1fr; gap: 30px; }
    .more__grid { grid-template-columns: 1fr; gap: 34px; }
  }
</style>
