---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SermonCard from '../../../../components/SermonCard.astro';
import { getCollection } from 'astro:content';
import { SERIES_ARTWORK } from '../../../../lib/sermon-assets';
import { Image } from 'astro:assets';
import { isVisibleSermon } from '../../../../lib/content';
import { byServiceOrder } from '../../../../lib/sermons';

export const getStaticPaths = (async ({ paginate }) => {
  const sermons = await getCollection('sermons', ({ data }) => isVisibleSermon(data));
  const allSeries = await getCollection('series', ({ data }) => !data.draft);

  return allSeries.flatMap((entry) => {
    const filtered = sermons
      .filter((s) => s.data.series?.slug === entry.slug)
      // oldest first, morning before evening on a shared date
      .sort((a, b) => byServiceOrder(a.data, b.data));
    // A series with nothing published yet gets no page rather than an empty one.
    if (!filtered.length) return [];
    return paginate(filtered, {
      pageSize: 12,
      params: { series: entry.slug },
      props: { entry, total: filtered.length, span: {
        from: filtered[0].data.date, to: filtered[filtered.length - 1].data.date,
      } },
    });
  });
}) satisfies GetStaticPaths;

const { page, entry, total, span } = Astro.props;
const seriesName = entry.data.name;
const { summary, scripture, artwork } = entry.data;
const art = artwork ? SERIES_ARTWORK[artwork] : undefined;
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const spanLabel = fmt(span.from) === fmt(span.to) ? fmt(span.from) : `${fmt(span.from)} – ${fmt(span.to)}`;
---
{/* CollectionPage rather than VideoObject: this page is the index of a run,
    and the individual sermons carry the video markup. */}
<BaseLayout
  title={`${seriesName} — Sermons`}
  description={summary ?? `Every message in the ${seriesName} series from Fairhaven Community Church, in order.`}
  ogImage={art?.src}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CreativeWorkSeries',
    name: seriesName,
    ...(summary ? { description: summary } : {}),
    ...(scripture ? { about: scripture } : {}),
    url: new URL(`/sermons/series/${entry.slug}`, Astro.site).href,
    numberOfItems: total,
  }}
>
  <section class="phead">
    {art && (
      <div class="phead__art" aria-hidden="true">
        <Image src={art} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" />
      </div>
    )}
    <div class="phead__body">
      <a href="/sermons" class="phead__back load d1">← All sermons</a>
      <p class="label load d1 phead__eyebrow">Series{scripture ? ` · ${scripture}` : ''}</p>
      <h1 class="serif load d2">{seriesName}</h1>
      {summary && <p class="phead__lede load d3">{summary}</p>}
      <p class="phead__count load d3">
        {total} service{total === 1 ? '' : 's'} · {spanLabel} · in order, from the beginning
      </p>
    </div>
  </section>

  <section class="wrap grid-wrap">
    <div class="grid">
      {page.data.map((sermon) => <SermonCard sermon={sermon} />)}
    </div>

    {page.lastPage > 1 && (
      <nav class="pager reveal" aria-label="Pagination">
        {page.url.prev ? <a href={page.url.prev}>← Earlier</a> : <span class="pager__off">← Earlier</span>}
        <span class="pager__now">{page.currentPage} / {page.lastPage}</span>
        {page.url.next ? <a href={page.url.next}>Later →</a> : <span class="pager__off">Later →</span>}
      </nav>
    )}
  </section>
</BaseLayout>

<style>
  .phead { position: relative; background: var(--ink); color: var(--cream); overflow: clip; }
  .phead__body { position: relative; z-index: 3; padding: 128px var(--pad) 82px; }
  .phead__back { display: inline-block; font-size: 14px; font-weight: 700;
                 color: rgba(244,239,231,.66); margin-bottom: 34px; }
  .phead__back:hover { color: var(--cream); }
  .phead__eyebrow { color: var(--red-tint); margin: 0 0 18px; }
  .phead h1 { margin: 0; font-size: clamp(40px,5.6vw,80px); line-height: 1.02; letter-spacing: -.02em; }
  .phead__lede { margin: 20px 0 0; font-size: 19px; line-height: 1.6; color: rgba(244,239,231,.82); max-width: 56ch; }
  .phead__count { margin: 14px 0 0; font-size: 15px; color: rgba(244,239,231,.6); }
  /* Artwork sits behind the title, dimmed enough that white type stays legible
     on any photograph a church happens to upload. */
  .phead__art { position: absolute; inset: 0; z-index: 1; }
  .phead__art :global(img) { width: 100%; height: 100%; object-fit: cover; opacity: .34; }
  .phead__art::after { content: ''; position: absolute; inset: 0;
                       background: linear-gradient(180deg, rgba(26,21,18,.55), rgba(26,21,18,.9)); }

  .grid-wrap { padding-block: clamp(60px,7vw,96px) clamp(80px,9vw,130px); }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 44px 34px; }

  .pager { display: flex; align-items: center; justify-content: center; gap: 22px; margin-top: 66px; font-size: 15px; }
  .pager a { color: var(--red); font-weight: 700; }
  .pager__off { color: rgba(74,64,56,.4); }
  .pager__now { color: var(--ink-soft); }

  @media (max-width: 860px) {
    .phead__body { padding: 104px var(--pad) 50px; }
    .grid { grid-template-columns: 1fr; gap: 34px; }
  }
</style>
