---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SermonCard from '../../components/SermonCard.astro';
import { getCollection } from 'astro:content';
import { slugify } from '../../lib/slugify';
import { isVisibleSermon, SERMON_WINDOW_MONTHS } from '../../lib/content';
import { SERVICE_TYPE_LABELS, type ServiceType } from '../../lib/sermons';

const YOUTUBE_ARCHIVE = 'https://www.youtube.com/@YOUR-SUBDOMAIN/streams';

/**
 * The archive is paginated server-side (the brief expects ~600 messages,
 * three a week over four years). Series browsing is real links, so it works
 * with no JavaScript. Search/speaker/year filter client-side across the WHOLE
 * archive via a small build-time index — filtering only the current page
 * would quietly lie about what's in the library.
 */
export const getStaticPaths = (async ({ paginate }) => {
  const sermons = (await getCollection('sermons', ({ data }) => isVisibleSermon(data)))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return paginate(sermons, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const all = (await getCollection('sermons', ({ data }) => isVisibleSermon(data)))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const seriesList = [...new Set(all.map((s) => s.data.series).filter(Boolean))] as string[];
const years = [...new Set(all.map((s) => String(s.data.date.getUTCFullYear())))].sort().reverse();

// Only offer service types that actually occur, in a fixed running order.
const TYPE_ORDER: ServiceType[] = ['sunday-morning', 'sunday-evening', 'wednesday', 'other'];
const presentTypes = TYPE_ORDER.filter((t) => all.some((s) => s.data.serviceType === t));

// index for client-side search across the whole archive
const index = all.map((s) => ({
  t: s.data.title?.trim() || s.data.service,
  sv: s.data.service,
  st: s.data.serviceType,
  sp: s.data.speaker ?? '',
  se: s.data.series ?? '',
  y: String(s.data.date.getUTCFullYear()),
  sc: s.data.scripture ?? '',
  k: s.data.series?.trim() || (s.data.title?.trim() ? s.data.service : SERVICE_TYPE_LABELS[s.data.serviceType]),
  u: `/sermons/${s.slug}`, id: s.data.youtubeId,
  d: s.data.date.toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }),
  // Extra haystack so date searches actually work. The visible label uses the
  // SHORT month ("Aug 19"), so without this, typing "august 19" — the obvious
  // thing, and what the placeholder invites — matches nothing. Carries the long
  // month, the short month and the ISO form.
  ds: [
    s.data.date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }),
    s.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }),
    s.data.date.toISOString().slice(0, 10),
  ].join(' ').toLowerCase(),
}));

const featured = page.currentPage === 1 ? page.data[0] : null;
const rest = page.currentPage === 1 ? page.data.slice(1) : page.data;
---
<BaseLayout
  title="Sermons"
  description="Four years of messages from Fairhaven Community Church — search the archive or follow a series from the beginning."
>
  <section class="phead">
    <div class="phead__body">
      <p class="label load d1 phead__eyebrow">The Archive</p>
      <h1 class="serif load d2">Sermons</h1>
      <p class="phead__lede load d3">
        The last {SERMON_WINDOW_MONTHS} months of services, searchable. Everything
        older lives on our YouTube channel.
      </p>
    </div>
  </section>

  {all.length === 0 ? (
    <!-- the pastor: this is what visitors see until the archive lands. The import
         plan (and why it needs the YouTube API key confirmed first) is in
         docs/README.md → "Sermons". Keep the copy below visitor-facing. -->
    <section class="wrap empty">
      <p class="empty__p">
        The sermon archive is still being brought across from YouTube — every message
        will be searchable here once it lands. In the meantime, every service is on
        our channel.
      </p>
      <a href="https://www.youtube.com/@YOUR-SUBDOMAIN" target="_blank" rel="noreferrer" class="btn btn--ink">
        Watch on YouTube
      </a>
    </section>
  ) : (
    <>
      <!-- ============ FILTERS ============ -->
      <section class="wrap tools-wrap">
        <form class="tools reveal" data-filter role="search" onsubmit="return false">
          <div class="fld fld--search">
            <label class="label fld__l" for="q">Search</label>
            <div class="fld__c">
              <input id="q" name="q" type="search" placeholder="Service, date, speaker, or scripture…" autocomplete="off" />
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" width="17" height="17" aria-hidden="true">
                <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path>
              </svg>
            </div>
          </div>
          <div class="fld">
            <label class="label fld__l" for="service">Service</label>
            <div class="fld__c">
              <select id="service" name="service">
                <option value="">All services</option>
                {presentTypes.map((t) => <option value={t}>{SERVICE_TYPE_LABELS[t]}</option>)}
              </select>
            </div>
          </div>
          <div class="fld">
            <label class="label fld__l" for="year">Year</label>
            <div class="fld__c">
              <select id="year" name="year">
                <option value="">All years</option>
                {years.map((y) => <option value={y}>{y}</option>)}
              </select>
            </div>
          </div>
        </form>

        {seriesList.length > 0 && (
          <nav class="chips reveal" aria-label="Filter by series">
            <a class="chip chip--on" href="/sermons">All</a>
            {seriesList.map((s) => <a class="chip" href={`/sermons/series/${slugify(s)}`}>{s}</a>)}
          </nav>
        )}
      </section>

      <!-- ============ RESULTS (client-side, replaces the grid when filtering) ============ -->
      <section class="wrap results-wrap" data-results hidden>
        <div class="sect__head">
          <h2 class="label sect__h">Results</h2>
          <p class="sect__sub" data-results-count></p>
        </div>
        <div class="grid" data-results-grid></div>
        <p class="empty__p" data-results-empty hidden>Nothing matched. Try fewer words.</p>
      </section>

      <!-- ============ THE ARCHIVE ============ -->
      <div data-archive>
        {featured && (
          <section class="wrap featured-wrap">
            <h2 class="label reveal sect__h">Most Recent</h2>
            <SermonCard sermon={featured} featured />
          </section>
        )}

        <section class="wrap grid-wrap">
          <div class="sect__head reveal">
            <h2 class="label sect__h">All Services</h2>
            <p class="sect__sub">
              Page {page.currentPage} of {page.lastPage} · {all.length} service{all.length === 1 ? '' : 's'}
            </p>
          </div>
          <div class="grid">
            {rest.map((sermon) => <SermonCard sermon={sermon} />)}
          </div>

          {page.lastPage > 1 && (
            <nav class="pager reveal" aria-label="Pagination">
              {page.url.prev ? <a href={page.url.prev}>← Newer</a> : <span class="pager__off">← Newer</span>}
              <span class="pager__now">{page.currentPage} / {page.lastPage}</span>
              {page.url.next ? <a href={page.url.next}>Older →</a> : <span class="pager__off">Older →</span>}
            </nav>
          )}

          <!-- The site carries a rolling window; YouTube has everything. Say so
               plainly rather than letting someone conclude it isn't there. -->
          <aside class="archive reveal">
            <div>
              <p class="label archive__k">Looking further back?</p>
              <h2 class="serif archive__h">Don't see the service you're after?</h2>
              <p class="archive__p">
                This page keeps the last {SERMON_WINDOW_MONTHS} months. Every service we've
                ever streamed is on our YouTube channel.
              </p>
            </div>
            <a href={YOUTUBE_ARCHIVE} target="_blank" rel="noreferrer" class="btn btn--solid archive__btn">
              Full service archive ↗
            </a>
          </aside>
        </section>
      </div>
    </>
  )}
</BaseLayout>

<script is:inline define:vars={{ index }}>
  /* Filtering runs over the whole archive, not the current page. With JS off
     the form simply isn't wired and the paginated archive below still works,
     as do the series links. */
  (function () {
    const form = document.querySelector('[data-filter]');
    if (!form || !index.length) return;
    const archive = document.querySelector('[data-archive]');
    const results = document.querySelector('[data-results]');
    const grid = document.querySelector('[data-results-grid]');
    const count = document.querySelector('[data-results-count]');
    const none = document.querySelector('[data-results-empty]');

    function card(s) {
      return `<article class="card"><a href="${s.u}" class="card__link">
        <div class="duo card__thumb"><img src="https://i.ytimg.com/vi/${s.id}/hqdefault.jpg" alt="" loading="lazy" width="480" height="360">
        <div class="card__veil"></div></div>
        <div class="card__body"><span class="label card__kicker">${s.k}</span>
        <h3 class="serif card__title">${s.t}</h3>
        <p class="card__meta">${s.sp ? s.sp + ' · ' : ''}${s.d}</p>
        ${s.sc ? `<p class="card__scripture">${s.sc}</p>` : ''}</div></a></article>`;
    }

    function apply() {
      const q = form.q.value.trim().toLowerCase();
      const sv = form.service.value;
      const y = form.year.value;
      const filtering = q || sv || y;

      if (!filtering) {
        results.hidden = true;
        archive.hidden = false;
        return;
      }
      const hits = index.filter((s) => {
        if (sv && s.st !== sv) return false;
        if (y && s.y !== y) return false;
        if (!q) return true;
        return (s.t + ' ' + s.sv + ' ' + s.sp + ' ' + s.se + ' ' + s.sc + ' ' + s.ds).toLowerCase().includes(q);
      });
      archive.hidden = true;
      results.hidden = false;
      count.textContent = `${hits.length} service${hits.length === 1 ? '' : 's'}`;
      none.hidden = hits.length > 0;
      grid.innerHTML = hits.map(card).join('');
    }

    let t;
    form.addEventListener('input', () => { clearTimeout(t); t = setTimeout(apply, 140); });
    form.addEventListener('change', apply);
  })();
</script>

<style>
  .phead { position: relative; background: var(--ink); color: var(--cream); overflow: clip; }
  .phead__body { position: relative; z-index: 3; padding: 150px var(--pad) 86px; }
  .phead__eyebrow { color: rgba(244,239,231,.6); margin: 0 0 20px; }
  .phead h1 { margin: 0; font-size: clamp(46px,6vw,88px); line-height: 1; letter-spacing: -.02em; }
  .phead__lede { margin: 22px 0 0; max-width: 52ch; font-size: 18px; line-height: 1.68; color: rgba(244,239,231,.78); }

  .empty { padding-block: clamp(60px,7vw,100px); }
  .empty__p { max-width: 56ch; font-size: 17px; line-height: 1.75; color: var(--ink-soft); }
  .empty__p :global(code) { background: var(--cream-deep); padding: 1px 5px; border-radius: 3px; font-size: .92em; }

  .tools-wrap { padding-block: 46px 0; }
  .tools { display: grid; grid-template-columns: minmax(0,1.6fr) minmax(0,1fr) minmax(0,1fr);
           gap: 30px; align-items: end; border-bottom: 1px solid var(--hair); padding-bottom: 22px; }
  .fld__l { display: block; margin-bottom: 8px; color: var(--ink-soft); }
  .fld--search .fld__l { color: var(--red); }
  .fld__c { display: flex; align-items: center; gap: 10px;
            border-bottom: 1px solid var(--hair); padding-bottom: 9px; min-height: 40px; }
  .fld__c input, .fld__c select {
    flex: 1; border: 0; background: none; font: inherit; font-size: 17px;
    color: var(--ink); padding: 4px 0; min-height: 32px;
  }
  .fld__c input:focus-visible, .fld__c select:focus-visible { outline: 2px solid var(--red); outline-offset: 3px; }
  .fld__c input::placeholder { color: rgba(74,64,56,.7); }

  .chips { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 26px; }
  .chip { font-size: 13px; font-weight: 700; letter-spacing: .04em; padding: 9px 16px;
          border-radius: 999px; border: 1px solid var(--hair); color: var(--ink-soft); }
  .chip:hover { border-color: var(--ink); color: var(--ink); }
  .chip--on { background: var(--ink); border-color: var(--ink); color: var(--cream); }
  .chip--on:hover { color: var(--cream); }

  .featured-wrap { padding-block: 60px 0; }
  .grid-wrap { padding-block: 70px clamp(80px,9vw,130px); }
  .results-wrap { padding-block: 50px clamp(80px,9vw,130px); }
  .sect__head { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 30px; }
  .sect__h { color: var(--red); margin: 0; }
  .sect__sub { margin: 0; font-size: 14px; color: var(--ink-soft); }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 44px 34px; }

  .archive { margin-top: 66px; background: var(--ink); color: var(--cream);
             border-radius: var(--radius-lg); padding: clamp(32px,4vw,52px);
             display: flex; align-items: center; justify-content: space-between;
             gap: 30px; flex-wrap: wrap; }
  .archive__k { color: var(--red-tint); margin: 0 0 12px; }
  .archive__h { margin: 0 0 10px; font-size: clamp(24px,3vw,34px); line-height: 1.14; }
  .archive__p { margin: 0; font-size: 16px; line-height: 1.7; color: rgba(244,239,231,.76); max-width: 46ch; }
  .archive__btn { flex-shrink: 0; }

  .pager { display: flex; align-items: center; justify-content: center; gap: 22px; margin-top: 66px; font-size: 15px; }
  .pager a { color: var(--red); font-weight: 700; }
  .pager__off { color: rgba(74,64,56,.4); }
  .pager__now { color: var(--ink-soft); }

  @media (max-width: 860px) {
    .phead__body { padding: 110px var(--pad) 52px; }
    .tools { grid-template-columns: 1fr; gap: 20px; }
    .grid { grid-template-columns: 1fr; gap: 34px; }
    .archive__btn { width: 100%; text-align: center; }
  }
</style>
