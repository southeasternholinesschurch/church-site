---
import type { GetStaticPaths } from 'astro';
import { copyFor } from '../../lib/copy';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SermonCard from '../../components/SermonCard.astro';
import { getCollection } from 'astro:content';
import { slugify } from '../../lib/slugify';
import { isVisibleSermon } from '../../lib/content';
import { SERVICE_TYPE_LABELS, type ServiceType } from '../../lib/sermons';
import { parseScripture, span } from '../../lib/scripture';

const YOUTUBE_ARCHIVE = 'https://www.youtube.com/@yourchurch/streams';

/**
 * The archive is paginated server-side (the brief expects ~600 messages,
 * three a week over four years). Series browsing is real links, so it works
 * with no JavaScript. Search/speaker/year filter client-side across the WHOLE
 * archive via a small build-time index — filtering only the current page
 * would quietly lie about what's in the library.
 */
export const getStaticPaths = (async ({ paginate }) => {
  const sermons = (await getCollection('sermons', ({ data }) => isVisibleSermon(data)))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return paginate(sermons, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const all = (await getCollection('sermons', ({ data }) => isVisibleSermon(data)))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

/**
 * Series that actually have a published sermon in the window. Read from the
 * series collection rather than scraped out of the sermons, so a series keeps
 * its proper name and casing — and so one that has been created but not yet
 * preached does not appear as an empty filter.
 */
const allSeries = await getCollection('series', ({ data }) => !data.draft);
const usedSlugs = new Set(all.map((s) => s.data.series?.slug).filter(Boolean));
const seriesList = allSeries.filter((x) => usedSlugs.has(x.slug));
/** slug -> display name, for the search index and the card labels below. */
const seriesName = new Map(allSeries.map((x) => [x.slug, x.data.name]));
const years = [...new Set(all.map((s) => String(s.data.date.getUTCFullYear())))].sort().reverse();

// Only offer service types that actually occur, in a fixed running order.
const TYPE_ORDER: ServiceType[] = ['sunday-morning', 'sunday-evening', 'wednesday', 'other'];
const presentTypes = TYPE_ORDER.filter((t) => all.some((s) => s.data.serviceType === t));

// index for client-side search across the whole archive
const index = all.map((s) => ({
  t: s.data.title?.trim() || s.data.service,
  sv: s.data.service,
  st: s.data.serviceType,
  sp: s.data.speaker ?? '',
  se: s.data.series ? (seriesName.get(s.data.series.slug) ?? '') : '',
  y: String(s.data.date.getUTCFullYear()),
  sc: s.data.scripture ?? '',
  // The passages as [book, from, to] — what a search for "John 3" is matched
  // against, so it finds "John 3:1-21" without the words having to line up.
  ps: parseScripture(s.data.scripture).map((p) => [p.book, ...span(p)]),
  k: (s.data.series ? seriesName.get(s.data.series.slug) : undefined)
     || (s.data.title?.trim() ? s.data.service : SERVICE_TYPE_LABELS[s.data.serviceType]),
  u: `/sermons/${s.slug}`, id: s.data.youtubeId,
  d: s.data.date.toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }),
  // Extra haystack so date searches actually work. The visible label uses the
  // SHORT month ("Aug 19"), so without this, typing "august 19" — the obvious
  // thing, and what the placeholder invites — matches nothing. Carries the long
  // month, the short month and the ISO form.
  ds: [
    s.data.date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }),
    s.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }),
    s.data.date.toISOString().slice(0, 10),
  ].join(' ').toLowerCase(),
}));

/** Page text, editable at /website/copy. Falls back to the words below. */
const t = await copyFor('sermons');

const featured = page.currentPage === 1 ? page.data[0] : null;
const rest = page.currentPage === 1 ? page.data.slice(1) : page.data;
---
<BaseLayout
  title="Sermons"
  description="Four years of messages from Fairhaven Community Church — search the archive or follow a series from the beginning."
>
  <section class="phead">
    <div class="phead__body">
      <p class="label load d1 phead__eyebrow">{t('header.eyebrow', 'The Archive')}</p>
      <h1 class="serif load d2">{t('header.headline', 'Sermons')}</h1>
      <p class="phead__lede load d3">
        {t('header.lede', "Every service we've published here, searchable — and where a message has been written out, the whole of it. Anything older is on our YouTube channel.")}
      </p>
    </div>
  </section>

  {all.length === 0 ? (
    <!-- For the pastor: this is what visitors see until the archive lands. The import
         plan (and why it needs the YouTube API key confirmed first) is in
         docs/README.md → "Sermons". Keep the copy below visitor-facing. -->
    <section class="wrap empty">
      <p class="empty__p">
        {t('empty.body', 'The sermon archive is still being brought across from YouTube — every message will be searchable here once it lands. In the meantime, every service is on our channel.')}
      </p>
      <a href="https://www.youtube.com/@yourchurch" target="_blank" rel="noreferrer" class="btn btn--ink">
        {t('empty.button', 'Watch on YouTube')}
      </a>
    </section>
  ) : (
    <>
      <!-- ============ FILTERS ============ -->
      <section class="wrap tools-wrap">
        <form class="tools reveal" data-filter role="search" onsubmit="return false">
          <div class="fld fld--search">
            <label class="label fld__l" for="q">{t('filters.searchLabel', 'Search')}</label>
            <div class="fld__c">
              <input id="q" name="q" type="search" placeholder={t('filters.searchPlaceholder', 'Service, date, speaker, or a passage like John 3…')} autocomplete="off" />
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" width="17" height="17" aria-hidden="true">
                <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path>
              </svg>
            </div>
          </div>
          <div class="fld">
            <label class="label fld__l" for="service">{t('filters.serviceLabel', 'Service')}</label>
            <div class="fld__c">
              <select id="service" name="service">
                <option value="">{t('filters.allServices', 'All services')}</option>
                {presentTypes.map((t) => <option value={t}>{SERVICE_TYPE_LABELS[t]}</option>)}
              </select>
            </div>
          </div>
          <div class="fld">
            <label class="label fld__l" for="year">{t('filters.yearLabel', 'Year')}</label>
            <div class="fld__c">
              <select id="year" name="year">
                <option value="">{t('filters.allYears', 'All years')}</option>
                {years.map((y) => <option value={y}>{y}</option>)}
              </select>
            </div>
          </div>
        </form>

        <p class="byscripture reveal">
          <a href="/sermons/scripture">{t('filters.byScripture', 'Browse by book of the Bible →')}</a>
        </p>

        {seriesList.length > 0 && (
          <nav class="chips reveal" aria-label="Filter by series">
            <a class="chip chip--on" href="/sermons">{t('filters.allSeries', 'All')}</a>
            {seriesList.map((x) => <a class="chip" href={`/sermons/series/${x.slug}`}>{x.data.name}</a>)}
          </nav>
        )}
      </section>

      <!-- ============ RESULTS (client-side, replaces the grid when filtering) ============ -->
      <section class="wrap results-wrap" data-results hidden>
        <div class="sect__head">
          <h2 class="label sect__h">{t('results.heading', 'Results')}</h2>
          <p class="sect__sub" data-results-count></p>
        </div>
        <div class="grid" data-results-grid></div>
        <p class="empty__p" data-results-empty hidden>{t('results.none', 'Nothing matched. Try fewer words.')}</p>
      </section>

      <!-- ============ THE ARCHIVE ============ -->
      <div data-archive>
        {featured && (
          <section class="wrap featured-wrap">
            <h2 class="label reveal sect__h">{t('archive.mostRecent', 'Most Recent')}</h2>
            <SermonCard sermon={featured} featured />
          </section>
        )}

        <section class="wrap grid-wrap">
          <div class="sect__head reveal">
            <h2 class="label sect__h">{t('archive.allServices', 'All Services')}</h2>
            <p class="sect__sub">
              Page {page.currentPage} of {page.lastPage} · {all.length} service{all.length === 1 ? '' : 's'}
            </p>
          </div>
          <div class="grid">
            {rest.map((sermon) => <SermonCard sermon={sermon} />)}
          </div>

          {page.lastPage > 1 && (
            <nav class="pager reveal" aria-label="Pagination">
              {page.url.prev ? <a href={page.url.prev}>← Newer</a> : <span class="pager__off">← Newer</span>}
              <span class="pager__now">{page.currentPage} / {page.lastPage}</span>
              {page.url.next ? <a href={page.url.next}>Older →</a> : <span class="pager__off">Older →</span>}
            </nav>
          )}

          <!-- The archive starts where the import reached back to and grows
               forward; nothing published here is ever removed. YouTube has the
               years before that. Say so plainly rather than letting someone
               conclude a service isn't there. -->
          <aside class="archive reveal">
            <div>
              <p class="label archive__k">{t('archive.eyebrow', 'Looking further back?')}</p>
              <h2 class="serif archive__h">{t('archive.title', "Don't see the service you're after?")}</h2>
              <p class="archive__p">
                {t('archive.body', "Everything published here stays here. Services from before this archive began are on our YouTube channel, where every service we've ever streamed lives.")}
              </p>
            </div>
            <a href={YOUTUBE_ARCHIVE} target="_blank" rel="noreferrer" class="btn btn--solid archive__btn">
              {t('archive.button', 'Full service archive ↗')}
            </a>
          </aside>
        </section>
      </div>
    </>
  )}
</BaseLayout>

{/* The archive's own data, for the search below. JSON rather than
    define:vars so the script that reads it can be a bundled module — which is
    what lets it share the passage reader with the build instead of carrying a
    second copy of sixty-six books. */}
<script type="application/json" id="sermon-index" is:inline set:html={JSON.stringify(index)} />

<script>
  /* Filtering runs over the whole archive, not the current page. With JS off
     the form simply isn't wired and the paginated archive below still works,
     as do the series links.

     A query that reads as a Bible passage ("John 3", "1 Cor 12:4", "Psalm 23")
     also matches every sermon whose passage OVERLAPS it — so "John 3:16" finds
     a message on John 3:1-21, which no amount of matching words would. The
     ordinary word match still runs alongside, so nothing that used to be found
     stops being found. */
  import { readScripture, span } from '../../lib/scripture';

  type Entry = { t: string; sv: string; st: string; sp: string; se: string; y: string; sc: string;
                 ps: [number, number, number][]; k: string; u: string; id: string; d: string; ds: string };

  const data = document.getElementById('sermon-index');
  const index: Entry[] = data ? JSON.parse(data.textContent || '[]') : [];
  const form = document.querySelector<HTMLFormElement>('[data-filter]');

  if (form && index.length) {
    const archive = document.querySelector<HTMLElement>('[data-archive]')!;
    const results = document.querySelector<HTMLElement>('[data-results]')!;
    const grid = document.querySelector<HTMLElement>('[data-results-grid]')!;
    const count = document.querySelector<HTMLElement>('[data-results-count]')!;
    const none = document.querySelector<HTMLElement>('[data-results-empty]')!;
    // Typed as "something with a value" rather than as DOM elements: the site's
    // types include the Workers runtime, whose `Element` is HTMLRewriter's and
    // not the DOM's, and HTMLSelectElement will not typecheck against it.
    type Field = { value: string };
    const field = (name: string) => form.elements.namedItem(name) as unknown as Field;
    const q = field('q'), service = field('service'), year = field('year');

    // Text from the index is the church's own, but it is still put into HTML,
    // so it is escaped on the way in.
    const esc = (v: string) => v.replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

    const card = (s: Entry) => `<article class="card"><a href="${esc(s.u)}" class="card__link">
        <div class="duo card__thumb"><img src="https://i.ytimg.com/vi/${esc(s.id)}/hqdefault.jpg" alt="" loading="lazy" width="480" height="360">
        <div class="card__veil"></div>
        <span class="card__play" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M8 5l11 7-11 7z"></path></svg></span></div>
        <div class="card__body"><span class="label card__kicker">${esc(s.k)}</span>
        <h3 class="serif card__title">${esc(s.t)}</h3>
        <p class="card__meta">${s.sp ? esc(s.sp) + ' · ' : ''}${esc(s.d)}</p>
        ${s.sc ? `<p class="card__scripture">${esc(s.sc)}</p>` : ''}</div></a></article>`;

    const apply = () => {
      const text = q.value.trim().toLowerCase();
      const sv = service.value;
      const y = year.value;
      if (!text && !sv && !y) {
        results.hidden = true;
        archive.hidden = false;
        return;
      }
      const asked = text ? readScripture(q.value).passages.map((p) => [p.book, ...span(p)]) : [];
      const hits = index.filter((s) => {
        if (sv && s.st !== sv) return false;
        if (y && s.y !== y) return false;
        if (!text) return true;
        const words = (s.t + ' ' + s.sv + ' ' + s.sp + ' ' + s.se + ' ' + s.sc + ' ' + s.ds).toLowerCase().includes(text);
        const passage = asked.some(([b, a1, a2]) => s.ps.some(([sb, b1, b2]) => sb === b && a1 <= b2 && b1 <= a2));
        return words || passage;
      });
      archive.hidden = true;
      results.hidden = false;
      count.textContent = `${hits.length} service${hits.length === 1 ? '' : 's'}`;
      none.hidden = hits.length > 0;
      grid.innerHTML = hits.map(card).join('');
    };

    let timer: ReturnType<typeof setTimeout>;
    form.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(apply, 140); });
    form.addEventListener('change', apply);
  }
</script>

<style>
  .phead { position: relative; background: var(--ink); color: var(--cream); overflow: clip; }
  .phead__body { position: relative; z-index: 3; padding: 150px var(--pad) 86px; }
  .phead__eyebrow { color: rgba(244,239,231,.6); margin: 0 0 20px; }
  .phead h1 { margin: 0; font-size: clamp(46px,6vw,88px); line-height: 1; letter-spacing: -.02em; }
  .phead__lede { margin: 22px 0 0; max-width: 52ch; font-size: 18px; line-height: 1.68; color: rgba(244,239,231,.78); }

  .empty { padding-block: clamp(60px,7vw,100px); }
  .empty__p { max-width: 56ch; font-size: 17px; line-height: 1.75; color: var(--ink-soft); }
  .empty__p :global(code) { background: var(--cream-deep); padding: 1px 5px; border-radius: 3px; font-size: .92em; }

  .tools-wrap { padding-block: 46px 0; }
  .tools { display: grid; grid-template-columns: minmax(0,1.6fr) minmax(0,1fr) minmax(0,1fr);
           gap: 30px; align-items: end; border-bottom: 1px solid var(--hair); padding-bottom: 22px; }
  .fld__l { display: block; margin-bottom: 8px; color: var(--ink-soft); }
  .fld--search .fld__l { color: var(--red); }
  .fld__c { display: flex; align-items: center; gap: 10px;
            border-bottom: 1px solid var(--hair); padding-bottom: 9px; min-height: 40px; }
  .fld__c input, .fld__c select {
    flex: 1; border: 0; background: none; font: inherit; font-size: 17px;
    color: var(--ink); padding: 4px 0; min-height: 32px;
  }
  .fld__c input:focus-visible, .fld__c select:focus-visible { outline: 2px solid var(--red); outline-offset: 3px; }
  .fld__c input::placeholder { color: rgba(74,64,56,.7); }

  /*
   * The search results' cards.
   *
   * They are built in the browser from the index, so SermonCard's styles —
   * scoped to the cards Astro renders — never reach them, and the results came
   * out as square, all-red tiles. These are SermonCard's rules again, reached
   * through the results grid. If the card's look changes, change both.
   */
  [data-results-grid] :global(.card__link) { display: block; color: inherit; }
  [data-results-grid] :global(.card__thumb) { aspect-ratio: 16/9; border-radius: var(--radius); }
  [data-results-grid] :global(.card__thumb img) { width: 100%; height: 100%; object-fit: cover; }
  [data-results-grid] :global(.card__veil) { position: absolute; inset: 0; z-index: 2;
    background: linear-gradient(180deg, transparent 45%, rgba(26,21,18,.55) 100%); }
  [data-results-grid] :global(.card__play) { position: absolute; z-index: 3; left: 50%; top: 50%;
    transform: translate(-50%,-50%); width: 52px; height: 52px; border-radius: 999px;
    border: 1px solid rgba(244,239,231,.7); display: flex; align-items: center; justify-content: center;
    color: var(--cream); }
  [data-results-grid] :global(.card__body) { padding-top: 14px; }
  [data-results-grid] :global(.card__kicker) { color: var(--red); display: block; line-height: 18px; }
  [data-results-grid] :global(.card__title) { margin: 8px 0 6px; font-size: 25px; line-height: 1.22; color: var(--ink); }
  [data-results-grid] :global(.card__meta) { margin: 0; font-size: 14px; color: var(--ink-soft); }
  [data-results-grid] :global(.card__scripture) { margin: 5px 0 0; font-size: 14px; color: var(--red); }
  @media (max-width: 860px) { [data-results-grid] :global(.card__title) { font-size: 22px; } }

  .byscripture { margin: 18px 0 0; font-size: 15px; font-weight: 700; }
  .byscripture a { color: var(--red); }
  .chips { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 26px; }
  .chip { font-size: 13px; font-weight: 700; letter-spacing: .04em; padding: 9px 16px;
          border-radius: 999px; border: 1px solid var(--hair); color: var(--ink-soft); }
  .chip:hover { border-color: var(--ink); color: var(--ink); }
  .chip--on { background: var(--ink); border-color: var(--ink); color: var(--cream); }
  .chip--on:hover { color: var(--cream); }

  .featured-wrap { padding-block: 60px 0; }
  .grid-wrap { padding-block: 70px clamp(80px,9vw,130px); }
  .results-wrap { padding-block: 50px clamp(80px,9vw,130px); }
  .sect__head { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 30px; }
  .sect__h { color: var(--red); margin: 0; }
  .sect__sub { margin: 0; font-size: 14px; color: var(--ink-soft); }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 44px 34px; }

  .archive { margin-top: 66px; background: var(--ink); color: var(--cream);
             border-radius: var(--radius-lg); padding: clamp(32px,4vw,52px);
             display: flex; align-items: center; justify-content: space-between;
             gap: 30px; flex-wrap: wrap; }
  .archive__k { color: var(--red-tint); margin: 0 0 12px; }
  .archive__h { margin: 0 0 10px; font-size: clamp(24px,3vw,34px); line-height: 1.14; }
  .archive__p { margin: 0; font-size: 16px; line-height: 1.7; color: rgba(244,239,231,.76); max-width: 46ch; }
  .archive__btn { flex-shrink: 0; }

  .pager { display: flex; align-items: center; justify-content: center; gap: 22px; margin-top: 66px; font-size: 15px; }
  .pager a { color: var(--red); font-weight: 700; }
  .pager__off { color: rgba(74,64,56,.4); }
  .pager__now { color: var(--ink-soft); }

  @media (max-width: 860px) {
    .phead__body { padding: 110px var(--pad) 52px; }
    .tools { grid-template-columns: 1fr; gap: 20px; }
    .grid { grid-template-columns: 1fr; gap: 34px; }
    .archive__btn { width: 100%; text-align: center; }
  }
</style>
