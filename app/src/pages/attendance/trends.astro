---
/**
 * Trends moved into /attendance on 2026-09-17.
 *
 * It was never a separate errand. "How was Sunday" is one question, and the
 * table of recent services was answering the first half of it on one tab while
 * the chart answered the second half on another. It is a fold under that table
 * now.
 *
 * The kind filter is carried across, so a bookmark of a particular line still
 * lands on that line. 302 rather than 301, for the reason written out in
 * pages/groups/index.astro: a cached permanent redirect cannot be corrected.
 */
const kind = Astro.url.searchParams.get('kind');
const q = kind ? `kind=${encodeURIComponent(kind)}&trends=open` : 'trends=open';
return Astro.redirect(`/attendance?${q}#trends`, 302);
---
