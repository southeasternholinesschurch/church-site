---
import AppLayout from '../layouts/AppLayout.astro';
import { getDb, schema } from '../db';
import { sql, eq, desc } from 'drizzle-orm';
import { canAccess } from '../lib/permissions';
import { dueCounts, refreshMissing } from '../lib/care-db';
import { textHealth, lastSeen, CRON_LATE_MINUTES } from '../lib/troubleshoot-db';
import { allHeroes } from '../lib/lobby-heroes-db';
import { churchToday } from '../lib/services';

const user = Astro.locals.user!;
const db = getDb(Astro.locals.runtime.env);

/*
 * Two numbers, and neither of them is displayed as a number.
 *
 * `total` only decides whether this is a fresh install with an empty database.
 * `unknown` only decides whether the notice below appears. The adult and child
 * counts went with the tiles that used to print them — see the note further
 * down — so they are no longer selected either.
 */
const [counts] = await db.select({
  total: sql<number>`count(*)`,
  unknown: sql<number>`sum(case when adult_child = 'unknown' then 1 else 0 end)`,
}).from(schema.people).where(eq(schema.people.archived, false));

/*
 * The directory rollout card used to live here — "X of Y listed adults have
 * opened their link", with a progress bar.
 *
 * It is gone, and not because it was wrong. It was right, and it finished:
 * nearly everyone has opened the link, so the bar sat at the top of the page
 * reporting a number that no longer moves. A dashboard's best space should go
 * to what is done every week, not to what was done once. The same figures are
 * still counted on /invites, which is where you go when you actually want to
 * chase the last few people.
 *
 * What replaces it is the four screens the pastor opens most.
 *
 * The four counting tiles above it — People, Adults, Children, Unconfirmed —
 * are gone for the same reason, one round of edits later. A headcount that
 * moves by one or two a month is not something you check on a Sunday morning;
 * it is something you look up when you happen to want it, and /people prints
 * it at the top of the list next to the filters that break it down.
 *
 * What survives is the one of the four that was never really a count: the
 * unconfirmed notice. It stays because it is not reporting a number, it is
 * asking for something to be done, and the thing it asks for changes how those
 * people are treated everywhere else in the app.
 */

const recent = await db.select().from(schema.services)
  .orderBy(desc(schema.services.date)).limit(5);

const total = counts?.total ?? 0;
const unknown = counts?.unknown ?? 0;

/*
 * The follow-up list, as a notice and not as a tile — the same reasoning as the
 * unconfirmed notice above: it is not reporting a number, it is asking for
 * something to be done, and it disappears when there is nothing to do. Admins
 * only, because that is who can open what it links to.
 */
const careEnv = Astro.locals.runtime.env;
// Brought up to date first, like /care itself, so the dashboard is never the
// one place that has not noticed a regular stopped coming.
//
// Caught, because this is the page everybody lands on: a notice that cannot be
// worked out (the care tables not migrated yet, a slow database) is a notice
// left off, never a dashboard that will not load.
let care: Awaited<ReturnType<typeof dueCounts>> | null = null;
if (canAccess(user.role, '/care')) {
  try {
    await refreshMissing(careEnv);
    care = await dueCounts(careEnv);
  } catch { care = null; }
}
/*
 * A warning when texting has a problem, for the admins who can fix it (the pastor,
 * 2026-10-21: "so I can see notifications if texts don't go out"). Shown only
 * for something worth acting on: the five-minute job has stopped, texts are
 * overdue, or texts in the last three days did not arrive. Caught like Care.
 *
 * Only what is NEW since this person last opened the troubleshooting page
 * ("once a dashboard alert is clicked on it is cleared"). A job that has
 * stopped is new if it was still running when they last looked.
 */
let textLine: string | null = null;
if (canAccess(user.role, '/website')) {
  try {
    const seen = await lastSeen(db, user.id);
    const h = await textHealth(db, 3, seen);
    textLine = [
      h.cronMinutesAgo !== null && h.cronMinutesAgo > CRON_LATE_MINUTES
        && (!seen || (h.cronLastRun ?? '') > seen)
        && 'the five-minute text job has stopped, so scheduled texts and reminders are not going out',
      h.overdue > 0 && `${h.overdue} scheduled ${h.overdue === 1 ? 'text is' : 'texts are'} overdue`,
      h.notDelivered > 0 && `${h.notDelivered} ${h.notDelivered === 1 ? 'text' : 'texts'} did not arrive ${seen ? 'since you last checked' : 'in the last 3 days'}`,
    ].filter(Boolean).join('; ') || null;
  } catch { textLine = null; }
}

/*
 * The lobby screen gets one line here; everything for it is on the Lobby tab.
 * Caught: a table not yet migrated is a card left off, never a dashboard that
 * will not load.
 */
let heroCount: number | null = null;
if (canAccess(user.role, '/lobby/manage')) {
  try {
    const today = churchToday();
    heroCount = (await allHeroes(db)).filter((h) => h.active && (!h.startsOn || h.startsOn <= today) && (!h.endsOn || h.endsOn >= today)).length;
  } catch { heroCount = null; }
}

const careLine = care && care.total > 0 ? [
  care.guest && `${care.guest} guest ${care.guest === 1 ? 'card' : 'cards'}`,
  care.reminder && `${care.reminder} ${care.reminder === 1 ? 'reminder' : 'reminders'}`,
  care.missing && `${care.missing} ${care.missing === 1 ? 'regular who has' : 'regulars who have'} not been in`,
].filter(Boolean).join(', ') : null;
---
<AppLayout title="Dashboard" user={user} backdrop>
  <h1>Dashboard</h1>

  {total === 0 && (
    <div class="card" style="margin-bottom:26px;">
      <h2>No people yet</h2>
      <p class="muted">
        The database is empty. Import the Breeze export to get started — see
        <code>app/README.md</code> for the command. The export is never committed
        to the repository; it is read from your machine and written straight to
        the database.
      </p>
    </div>
  )}

  {total > 0 && unknown > 0 && (
    <p class="notice">
      <strong>{unknown} {unknown === 1 ? 'person is' : 'people are'} not marked as adult or child.</strong>
      The Breeze export had no age, birthday or family role for them. Until that is
      set they are treated as children — kept out of the directory and counted as
      children in attendance. <a href="/people?filter=unknown">Review them</a>.
    </p>
  )}

  {textLine && (
    <p class="notice">
      <strong>Texting:</strong> {textLine}. <a href="/website/troubleshooting">See what happened</a>.
    </p>
  )}

  {careLine && (
    <p class="notice notice--care">
      <strong>To follow up:</strong> {careLine}. <a href="/care">Open Care</a>.
    </p>
  )}

  {/* The most-used screens, as targets big enough to hit on a phone without
      aiming. Four became five on 2026-10-26 when the pastor asked for the service
      order, which he makes most weeks. Keep it near there: the moment this
      becomes a menu it stops being faster than the nav bar above it. */}
  <nav class="quick" aria-label="Jump to">
    <a href="/messaging">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5z" />
      </svg>
      <span class="quick__l">Send a text</span>
      <span class="quick__n">Everyone, or one group</span>
    </a>

    <a href="/attendance">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 11.5l2.6 2.6L21 4.7" />
        <path d="M20.5 12v7a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2V5.5a2 2 0 0 1 2-2H16" />
      </svg>
      <span class="quick__l">Take attendance</span>
      <span class="quick__n">Start or reopen a service</span>
    </a>

    <a href="/bulletin">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M14 2.75H6.5a2 2 0 0 0-2 2v14.5a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V8.25z" />
        <path d="M14 2.75v5.5h5.5" />
        <path d="M8.5 13.5h7M8.5 17h7M8.5 10h2.5" />
      </svg>
      <span class="quick__l">Bulletin</span>
      <span class="quick__n">Build this week’s</span>
    </a>

    <a href="/service-orders">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 6.5h11M9 12h11M9 17.5h11" />
        <path d="M4 6.5h.01M4 12h.01M4 17.5h.01" stroke-width="2.4" />
      </svg>
      <span class="quick__l">Service order</span>
      <span class="quick__n">Who leads each part</span>
    </a>

    <a href="/signups">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15.5 4.5h2a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2h-11a2 2 0 0 1-2-2v-13a2 2 0 0 1 2-2h2" />
        <rect x="8.5" y="2.5" width="7" height="4" rx="1.2" />
        <path d="M8.75 11.5h6.5M8.75 15.5h4" />
      </svg>
      <span class="quick__l">Sign-up sheets</span>
      <span class="quick__n">Meals, nursery, helpers</span>
    </a>
  </nav>

  {heroCount !== null && (
    <a class="card lobby-link" href="/lobby/manage">
      <span><strong>Lobby screen</strong>
        <span class="muted"> · {heroCount === 0 ? 'no hero frames showing' : `${heroCount} hero ${heroCount === 1 ? 'frame' : 'frames'} showing`}</span></span>
      <span class="lobby-link__go">Hero frames, words and pace →</span>
    </a>
  )}

  <div class="card">
    <h2>Recent services</h2>
    {recent.length === 0 ? (
      <p class="muted" style="margin:0;">No attendance has been recorded yet.</p>
    ) : (
      <table>
        <thead><tr><th>Date</th><th>Service</th></tr></thead>
        <tbody>
          {recent.map((s) => (
            <tr><td>{s.date}</td><td>{s.label ?? s.kind}</td></tr>
          ))}
        </tbody>
      </table>
    )}
  </div>
</AppLayout>
<style>
  /* Five squares in a row. Two-up on a phone, which keeps them square there as
     well — a 5-wide row on a 375px screen gives tiles too small to label — and
     the fifth, alone on its row, becomes a wide bar rather than a square with
     a hole beside it. */
  /* minmax(0, …) and not a plain 1fr.
   *
   * A 1fr track has an AUTO minimum, which is min-content — and on a tile with
   * `aspect-ratio`, min-content width is derived from the height the text
   * needs. So the two-up phone layout was sizing its columns from how tall
   * "Take attendance / Start or reopen a service" wraps, producing 159.6px
   * tracks inside a 331px grid and pushing the last tile 2px past the right
   * edge of every card on the page. Flooring the track at 0 makes the columns
   * a pure division of the row, which is the only way these line up at every
   * width rather than at the one that was checked. */
  /* Green rather than the warning red: a guest card is good news. */
  .notice--care { border-color: var(--ok); background: #e8f2eb; color: #16532c; }
  .notice--care a { color: #16532c; font-weight: 700; }
  .quick {
    display: grid; grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px; margin-bottom: 26px;
  }
  .quick a {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 9px; text-align: center;
    /* `width: 100%` is load-bearing, not tidiness.
     *
     * Without it the tile has no definite width, so `aspect-ratio` drives BOTH
     * dimensions off `max-height` — every tile came out 200px wide inside a
     * 247px grid track, and the row finished 48px short of the right edge of
     * every card above and below it. Stating the width makes it definite, and
     * aspect-ratio then only fills in the height, which max-height is free to
     * cap without pulling the width in after it.
     *
     * So: as wide as its track at every size, and square until a square would
     * be taller than 200px. */
    width: 100%; aspect-ratio: 1; max-height: 200px;
    padding: 16px 12px; border-radius: var(--radius-lg);
    border: 1px solid var(--hair); background: rgba(255, 255, 255, .94);
    color: var(--ink); text-decoration: none;
    transition: background .12s ease, border-color .12s ease, transform .12s ease;
  }
  .quick a:hover { background: var(--ink); border-color: var(--ink); color: var(--cream); }
  .quick a:active { transform: translateY(1px); }
  .quick svg { width: 30px; height: 30px; }
  .quick__l { font-weight: 700; font-size: 17px; line-height: 1.25; }
  .quick__n { font-size: 13px; line-height: 1.35; color: var(--ink-soft); }
  .quick a:hover .quick__n { color: rgba(244, 239, 231, .8); }

  @media (max-width: 900px) {
    .quick { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .quick a:last-child:nth-child(odd) {
      grid-column: 1 / -1; aspect-ratio: auto; min-height: 96px;
      display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto;
      column-gap: 16px; row-gap: 2px; justify-content: start; text-align: left; padding: 16px 20px;
    }
    .quick a:last-child:nth-child(odd) svg { grid-row: 1 / 3; align-self: center; }
    .quick a:last-child:nth-child(odd) .quick__l { align-self: end; }
    .quick a:last-child:nth-child(odd) .quick__n { align-self: start; }
  }
  .lobby-link { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;
                margin-bottom: 26px; color: var(--ink); text-decoration: none; }
  .lobby-link:hover { border-color: var(--ink); }
  .lobby-link__go { font-weight: 700; }

  @media (prefers-reduced-motion: reduce) {
    .quick a { transition: none; }
    .quick a:active { transform: none; }
  }
</style>
