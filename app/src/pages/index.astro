---
import AppLayout from '../layouts/AppLayout.astro';
import { getDb, schema } from '../db';
import { sql, eq, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
const db = getDb(Astro.locals.runtime.env);

const [counts] = await db.select({
  total: sql<number>`count(*)`,
  adults: sql<number>`sum(case when adult_child = 'adult' then 1 else 0 end)`,
  children: sql<number>`sum(case when adult_child = 'child' then 1 else 0 end)`,
  unknown: sql<number>`sum(case when adult_child = 'unknown' then 1 else 0 end)`,
}).from(schema.people).where(eq(schema.people.archived, false));

/*
 * The directory rollout card used to live here — "X of Y listed adults have
 * opened their link", with a progress bar.
 *
 * It is gone, and not because it was wrong. It was right, and it finished:
 * nearly everyone has opened the link, so the bar sat at the top of the page
 * reporting a number that no longer moves. A dashboard's best space should go
 * to what is done every week, not to what was done once. The same figures are
 * still counted on /invites, which is where you go when you actually want to
 * chase the last few people.
 *
 * What replaces it is the four screens the pastor opens most.
 */

const recent = await db.select().from(schema.services)
  .orderBy(desc(schema.services.date)).limit(5);

const total = counts?.total ?? 0;
const unknown = counts?.unknown ?? 0;
---
<AppLayout title="Dashboard" user={user} backdrop>
  <h1>Dashboard</h1>

  {total === 0 ? (
    <div class="card" style="margin-bottom:26px;">
      <h2>No people yet</h2>
      <p class="muted">
        The database is empty. Import the Breeze export to get started — see
        <code>app/README.md</code> for the command. The export is never committed
        to the repository; it is read from your machine and written straight to
        the database.
      </p>
    </div>
  ) : (
    <>
      {/* 140px rather than 160px, which is the difference between two of these
          per row on a 375px phone and four stacked full-width cards pushing the
          quick links below the fold — the whole point of the quick links being
          that they are reached without scrolling. Four items and auto-fit still
          means four across on a desktop. */}
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:14px; margin-bottom:26px;">
        <div class="card"><p class="label muted">People</p><p style="font-size:32px;margin:4px 0 0;">{total}</p></div>
        <div class="card"><p class="label muted">Adults</p><p style="font-size:32px;margin:4px 0 0;">{counts?.adults ?? 0}</p></div>
        <div class="card"><p class="label muted">Children</p><p style="font-size:32px;margin:4px 0 0;">{counts?.children ?? 0}</p></div>
        <div class="card"><p class="label muted">Unconfirmed</p><p style="font-size:32px;margin:4px 0 0;">{unknown}</p></div>
      </div>

      {unknown > 0 && (
        <p class="notice">
          <strong>{unknown} {unknown === 1 ? 'person is' : 'people are'} not marked as adult or child.</strong>
          The Breeze export had no age, birthday or family role for them. Until that is
          set they are treated as children — kept out of the directory and counted as
          children in attendance. <a href="/people?filter=unknown">Review them</a>.
        </p>
      )}
    </>
  )}

  {/* The four most-used screens, as targets big enough to hit on a phone
      without aiming. Deliberately not a fifth: the moment this becomes a menu
      it stops being faster than the nav bar above it. */}
  <nav class="quick" aria-label="Jump to">
    <a href="/messaging">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5z" />
      </svg>
      <span class="quick__l">Send a text</span>
      <span class="quick__n">Everyone, or one group</span>
    </a>

    <a href="/attendance">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 11.5l2.6 2.6L21 4.7" />
        <path d="M20.5 12v7a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2V5.5a2 2 0 0 1 2-2H16" />
      </svg>
      <span class="quick__l">Take attendance</span>
      <span class="quick__n">Start or reopen a service</span>
    </a>

    <a href="/bulletin">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M14 2.75H6.5a2 2 0 0 0-2 2v14.5a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V8.25z" />
        <path d="M14 2.75v5.5h5.5" />
        <path d="M8.5 13.5h7M8.5 17h7M8.5 10h2.5" />
      </svg>
      <span class="quick__l">Bulletin</span>
      <span class="quick__n">Build this week’s</span>
    </a>

    <a href="/signups">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15.5 4.5h2a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2h-11a2 2 0 0 1-2-2v-13a2 2 0 0 1 2-2h2" />
        <rect x="8.5" y="2.5" width="7" height="4" rx="1.2" />
        <path d="M8.75 11.5h6.5M8.75 15.5h4" />
      </svg>
      <span class="quick__l">Sign-up sheets</span>
      <span class="quick__n">Meals, nursery, helpers</span>
    </a>
  </nav>

  <div class="card">
    <h2>Recent services</h2>
    {recent.length === 0 ? (
      <p class="muted" style="margin:0;">No attendance has been recorded yet.</p>
    ) : (
      <table>
        <thead><tr><th>Date</th><th>Service</th></tr></thead>
        <tbody>
          {recent.map((s) => (
            <tr><td>{s.date}</td><td>{s.label ?? s.kind}</td></tr>
          ))}
        </tbody>
      </table>
    )}
  </div>
</AppLayout>

<style>
  /* Four squares. Two-up on a phone, which keeps them square there as well —
     a 4-wide row on a 375px screen gives tiles too small to label. */
  .quick {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 14px; margin-bottom: 26px;
  }
  .quick a {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 9px; text-align: center; aspect-ratio: 1; max-height: 200px;
    padding: 16px 12px; border-radius: var(--radius-lg);
    border: 1px solid var(--hair); background: rgba(255, 255, 255, .94);
    color: var(--ink); text-decoration: none;
    transition: background .12s ease, border-color .12s ease, transform .12s ease;
  }
  .quick a:hover { background: var(--ink); border-color: var(--ink); color: var(--cream); }
  .quick a:active { transform: translateY(1px); }
  .quick svg { width: 30px; height: 30px; }
  .quick__l { font-weight: 700; font-size: 17px; line-height: 1.25; }
  .quick__n { font-size: 13px; line-height: 1.35; color: var(--ink-soft); }
  .quick a:hover .quick__n { color: rgba(244, 239, 231, .8); }

  @media (max-width: 720px) {
    .quick { grid-template-columns: repeat(2, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) {
    .quick a { transition: none; }
    .quick a:active { transform: none; }
  }
</style>
