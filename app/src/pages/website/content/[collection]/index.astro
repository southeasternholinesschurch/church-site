---
import AppLayout from '../../../../layouts/AppLayout.astro';
import { siteEditingConfigured } from '../../../../lib/site-content';
import { COLLECTIONS, listEntries, type CollectionId } from '../../../../lib/site-entries';

/**
 * One list screen for staff, ministries and beliefs. They differ in their
 * fields, not in their shape — a folder of markdown files with a position —
 * so three near-identical pages would be three places to fix the next bug.
 */
const user = Astro.locals.user!;
const env = Astro.locals.runtime.env;
const id = Astro.params.collection as CollectionId;
if (!COLLECTIONS[id]) return Astro.redirect('/website', 302);

const meta = COLLECTIONS[id];
const configured = siteEditingConfigured(env);

let entries: { slug: string; data: Record<string, unknown> }[] = [];
let error: string | null = null;
if (configured) {
  try { entries = await listEntries(env, id); }
  catch (err) { error = err instanceof Error ? err.message : String(err); }
}
---
<AppLayout title={meta.label} user={user}>
  <p style="margin:0 0 6px;"><a href="/website" class="muted">← The website</a></p>
  <h1>{meta.label}</h1>

  {!configured && <p class="notice"><strong>Website editing is not connected yet.</strong> The GitHub token still needs adding as a Worker secret.</p>}
  {error && <p class="notice">Could not read the website's files: {error}</p>}

  {configured && (
    <>
      <p class="muted" style="max-width:60ch; margin:-4px 0 20px;">
        {entries.length} {entries.length === 1 ? meta.singular : `${meta.singular}s`}, in the order they appear on the site.
      </p>

      <div class="card t-wrap" style="padding:0; overflow-x:auto; margin-bottom:20px;">
        <table class="t-stack">
          <thead><tr><th>#</th><th>{meta.titleField === 'title' ? 'Title' : 'Name'}</th><th></th><th></th></tr></thead>
          <tbody>
            {entries.length === 0 ? (
              <tr><td colspan="4" class="muted" style="padding:22px;">Nothing here yet.</td></tr>
            ) : entries.map((e) => (
              <tr>
                <td data-label="#" class="muted">{String(e.data.order ?? '—')}</td>
                <td data-label="Name"><strong>{String(e.data[meta.titleField] ?? e.slug)}</strong></td>
                <td data-label="" class="muted" style="font-size:14px;">
                  {id === 'staff' && String(e.data.role ?? '')}
                  {id === 'ministries' && String(e.data.ageRange ?? '')}
                  {id !== 'beliefs' && !e.data.photo && <span style="color:var(--red);">no photo</span>}
                </td>
                <td data-label=""><a class="btn btn--ghost" style="min-height:36px; padding:6px 12px;"
                   href={`/website/content/${id}/${e.slug}`}>Edit</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <a class="btn" href={`/website/content/${id}/new`}>Add a {meta.singular}</a>
    </>
  )}
</AppLayout>
