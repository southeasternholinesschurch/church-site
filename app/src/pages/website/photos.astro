---
import AppLayout from '../../layouts/AppLayout.astro';
import { siteEditingConfigured, listDir } from '../../lib/site-content';
import { listEntries } from '../../lib/site-entries';

/**
 * Every photograph the website uses, and which ones nothing points at.
 *
 * Resizing happens in the BROWSER, before anything is uploaded. A Worker has no
 * image library, and Cloudflare's image resizing is a paid product — but the
 * phone that took the photo already has a canvas. It also means an 8MB original
 * never crosses the network at all, which matters on a church wifi.
 */
const user = Astro.locals.user!;
const env = Astro.locals.runtime.env;
const configured = siteEditingConfigured(env);

const FOLDERS = [
  { dir: 'photos', label: 'Site photographs', note: 'Ministries, the home page, the about pages.' },
  { dir: 'staff', label: 'Staff portraits', note: 'Cropped to a circle on the about page.' },
  { dir: 'series', label: 'Series artwork', note: 'Shown on a series page and on every sermon in it.' },
  { dir: 'sermons', label: 'Sermon artwork', note: 'Overrides the series artwork for one sermon.' },
  { dir: 'uploads', label: 'Banner images', note: 'For the homepage banner. Served exactly as uploaded, so size matters here.' },
];

let groups: { dir: string; label: string; note: string; files: { name: string; slug: string; size: number }[] }[] = [];
let used = new Set<string>();
let error: string | null = null;

if (configured) {
  try {
    for (const f of FOLDERS) {
      const dir = f.dir === 'uploads' ? 'site/public/uploads' : `site/src/assets/${f.dir}`;
      const files = (await listDir(env, dir))
        .filter((x) => /\.(jpe?g|png|webp|avif)$/i.test(x.name))
        .map((x) => ({ name: x.name, slug: x.name.replace(/\.[^.]+$/, ''), size: x.size }));
      groups.push({ ...f, files });
    }
    // Which photographs something actually points at. A picture nothing
    // references is not a fault, but it IS the first thing to check when
    // somebody says "I uploaded it and it didn't appear".
    for (const id of ['staff', 'ministries'] as const) {
      for (const e of await listEntries(env, id)) {
        if (typeof e.data.photo === 'string') used.add(e.data.photo);
      }
    }
  } catch (err) { error = err instanceof Error ? err.message : String(err); }
}
const kb = (n: number) => `${Math.round(n / 1024)} KB`;
---
<AppLayout title="Photos" user={user}>
  <p style="margin:0 0 6px;"><a href="/website" class="muted">← The website</a></p>
  <h1>Photos</h1>
  <p class="muted" style="max-width:62ch; margin:-4px 0 22px;">
    Every picture the website uses. To change one, upload a new file with the
    <strong>same name</strong> — everything pointing at it follows automatically,
    with nothing else to edit.
  </p>

  {!configured && <p class="notice"><strong>Website editing is not connected yet.</strong></p>}
  {error && <p class="notice">Could not read the website's files: {error}</p>}

  {configured && (
    <>
      <div class="card" style="margin-bottom:24px;">
        <h2 style="margin-top:0;">Add or replace a photo</h2>
        <p class="muted" style="margin:-6px 0 14px; font-size:15px;">
          Pictures are shrunk to 2400px on the long edge before they are sent —
          a phone photo is around 8MB and nothing on the site is shown larger
          than this. The original on your phone is untouched.
        </p>
        <form id="up">
          <label class="field" style="max-width:340px;">
            <span>Where it goes</span>
            <select name="folder" id="folder">
              {FOLDERS.map((f) => <option value={f.dir}>{f.label}</option>)}
            </select>
          </label>
          <label class="field">
            <span>Name</span>
            <input name="slug" id="slug" placeholder="seniors-conversation" />
            <small class="muted">Lower case, hyphens, no spaces. Use an existing name to replace that photo.</small>
          </label>
          <label class="field">
            <span>Picture</span>
            <input type="file" id="file" accept="image/jpeg,image/png,image/webp" />
          </label>
          <p id="preview-line" class="muted" style="font-size:14px;"></p>
          <canvas id="canvas" hidden></canvas>
          <button class="btn" type="submit" id="go" disabled>Upload</button>
          <span id="status" class="muted" style="margin-left:12px;"></span>
        </form>
      </div>

      {groups.map((g) => (
        <div class="card" style="margin-bottom:20px;">
          <h2 style="margin-top:0;">{g.label}</h2>
          <p class="muted" style="margin:-6px 0 14px; font-size:15px;">{g.note}</p>
          {g.files.length === 0 ? (
            <p class="muted" style="margin:0;">Nothing here yet.</p>
          ) : (
            <div class="shelf">
              {g.files.map((f) => (
                <figure class="shot">
                  <img src={`/website/photo/${g.dir}/${f.name}`} alt="" loading="lazy" />
                  <figcaption>
                    <code>{f.slug}</code>
                    <span class="muted">{kb(f.size)}</span>
                    {g.dir !== 'series' && g.dir !== 'sermons' && !used.has(f.slug)
                      && <span class="unused">nothing uses this</span>}
                  </figcaption>
                </figure>
              ))}
            </div>
          )}
        </div>
      ))}
    </>
  )}
</AppLayout>

<style>
  .shelf { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 18px; }
  .shot { margin: 0; }
  .shot img { width: 100%; aspect-ratio: 3/2; object-fit: cover; border-radius: var(--radius);
              background: var(--cream-deep); display: block; }
  .shot figcaption { display: flex; flex-direction: column; gap: 2px; margin-top: 6px; font-size: 13px; }
  .shot code { font-size: 13px; }
  .unused { color: var(--red); }
</style>

<script>
  const file = document.getElementById('file') as HTMLInputElement;
  const slug = document.getElementById('slug') as HTMLInputElement;
  const folder = document.getElementById('folder') as unknown as HTMLSelectElement;
  const go = document.getElementById('go') as HTMLButtonElement;
  const status = document.getElementById('status')!;
  const line = document.getElementById('preview-line')!;
  const canvas = document.getElementById('canvas') as HTMLCanvasElement;

  const MAX_EDGE = 2400;
  let payload: string | null = null;

  /**
   * Shrink in the browser. The point is not politeness about bandwidth: a
   * Worker cannot resize an image, and committing an 8MB phone photograph to
   * the repository would put it there permanently, for every clone, forever.
   */
  async function prepare(f: File) {
    const bitmap = await createImageBitmap(f);
    const scale = Math.min(1, MAX_EDGE / Math.max(bitmap.width, bitmap.height));
    const w = Math.round(bitmap.width * scale);
    const h = Math.round(bitmap.height * scale);
    canvas.width = w; canvas.height = h;
    canvas.getContext('2d')!.drawImage(bitmap, 0, 0, w, h);
    const blob: Blob = await new Promise((res) =>
      canvas.toBlob((b) => res(b!), 'image/jpeg', 0.82));
    const buf = new Uint8Array(await blob.arrayBuffer());
    let bin = '';
    for (const b of buf) bin += String.fromCharCode(b);
    payload = btoa(bin);
    line.textContent =
      `${bitmap.width}×${bitmap.height}, ${Math.round(f.size / 1024)} KB `
      + `→ ${w}×${h}, ${Math.round(blob.size / 1024)} KB`;
    go.disabled = false;
  }

  file.addEventListener('change', () => {
    payload = null; go.disabled = true; line.textContent = '';
    const f = file.files?.[0];
    if (!f) return;
    if (!slug.value.trim()) {
      slug.value = f.name.replace(/\.[^.]+$/, '').toLowerCase()
        .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
    }
    line.textContent = 'Preparing…';
    prepare(f).catch((e) => { line.textContent = `Could not read that picture: ${e}`; });
  });

  document.getElementById('up')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = slug.value.trim().toLowerCase().replace(/[^a-z0-9-]/g, '');
    if (!payload || !name) { status.textContent = 'Pick a picture and give it a name.'; return; }
    go.disabled = true; status.textContent = 'Uploading…';
    const res = await fetch('/api/site/photo', {
      method: 'POST', headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ folder: folder.value, slug: name, dataBase64: payload }),
    });
    const body = await res.json().catch(() => ({})) as { error?: string; replaced?: boolean };
    if (!res.ok) { status.textContent = body.error ?? 'Upload failed.'; go.disabled = false; return; }
    status.textContent = body.replaced ? 'Replaced. Live in a couple of minutes.' : 'Added.';
    setTimeout(() => location.reload(), 1200);
  });
</script>
