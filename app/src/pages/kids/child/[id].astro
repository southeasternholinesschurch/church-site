---
import KidsLayout from '../../../layouts/KidsLayout.astro';
import { getDb, schema, nowIso } from '../../../db';
import { and, asc, desc, eq, or, sql } from 'drizzle-orm';
import { readForm } from '../../../lib/form';
import { churchToday } from '../../../lib/services';
import { ageOn, suggestClass, classMismatch, noteStamp, MAX_NOTE, type AgeClass } from '../../../lib/kids';
import { photosEnabled, putPhoto, deletePhoto, sniffImage, MAX_UPLOAD_BYTES } from '../../../lib/photos';
/* The app's ONE phone-normalisation rule, already used by the sender and the
 * backfill script. A second copy here had quietly dropped the already-E.164
 * passthrough, which is how two functions with the same name start
 * disagreeing about the same number. */
import { toE164 } from '../../../lib/sms';
import { balanceOf, parseAmount, REASON_LABEL, MAX_AMOUNT } from '../../../lib/bucks';
import { randomToken } from '../../../lib/auth';
import { canIssueCards, canLinkChurchRecords } from '../../../lib/permissions';

/**
 * One child.
 *
 * Teachers and bus workers may edit this, not only the director (the pastor,
 * 2026-09-08) — a volunteer who spots a wrong phone number or a new allergy
 * should be able to fix it rather than find somebody who can.
 *
 * Reads and writes Fairhaven Kids' own list (`kids`) only — nothing here touches the
 * church's `people`. See the note on `kids` in the schema.
 */
const user = Astro.locals.user!;
const env = Astro.locals.runtime.env;
const db = getDb(env);
const id = Number(Astro.params.id);
if (!Number.isInteger(id)) return Astro.redirect('/kids/children', 302);

const back = (m: string) => Astro.redirect(`/kids/child/${id}?saved=${m}`, 303);
let error: string | null = null;
/* What was typed into the details form, kept only when the save is REJECTED so
 * the form comes back as they left it rather than reverting to the stored
 * values and hiding the thing they were trying to fix. */
let typed: Record<string, string> | null = null;

// ---- writes -----------------------------------------------------------------
if (Astro.request.method === 'POST') {
  // readForm, never request.formData() directly: a malformed or empty body
  // rejects, and an unhandled rejection in frontmatter is a 500. Scanners POST
  // empty bodies at every URL they find.
  const form = await readForm(Astro.request);
  const act = String(form.get('action') ?? '');

  const [child] = await db.select({ id: schema.kids.id, photoKey: schema.kids.photoKey,
                                    routeId: schema.kids.routeId })
    .from(schema.kids).where(eq(schema.kids.id, id)).limit(1);
  if (!child) return Astro.redirect('/kids/children', 302);

  const num = (v: FormDataEntryValue | null) => {
    const n = Number(String(v ?? ''));
    return Number.isInteger(n) && n > 0 ? n : null;
  };
  const str = (v: FormDataEntryValue | null) => {
    const s = String(v ?? '').trim();
    return s === '' ? null : s;
  };

  if (act === 'save-details') {
    /*
     * WHO THEY ARE — name, birthday, address.
     *
     * These fields could be entered when a child was added and then never
     * changed from here: correcting an address or a date of birth meant the
     * church-side person page, which the gate refuses to a teacher or a bus
     * worker. So the details were typed once, went stale, and the people most
     * likely to notice could not fix them.
     */
    const firstName = str(form.get('firstName'));
    const lastName = str(form.get('lastName'));
    const birthday = str(form.get('birthday'));
    if (!firstName || !lastName) {
      error = 'A first and last name are both needed.';
    } else if (birthday && (!/^\d{4}-\d{2}-\d{2}$/.test(birthday)
                            || ageOn(birthday, churchToday()) === null)) {
      // The same guard the add-child form uses. A year typed as 2109, or a date
      // in the future, would otherwise sit in the record producing a nonsense
      // age and a nonsense class suggestion for as long as the child is here.
      error = 'That date of birth does not look right.';
    } else {
      /*
       * NO phone and NO email in this write.
       *
       * The church does not keep children's own contact numbers (the pastor,
       * 2026-09-11), so the form stopped asking. Leaving the columns in the
       * write would not have been neutral: with the inputs gone the form sends
       * nothing, str() reads null, and saving an address would silently blank
       * a number already on the record. Anything the church sends about a
       * child goes to a guardian, whose number lives on kid_guardians.
       */
      await db.update(schema.kids).set({
        firstName, lastName, birthday,
        addressStreet: str(form.get('addressStreet')),
        addressCity: str(form.get('addressCity')),
        addressState: str(form.get('addressState')),
        addressZip: str(form.get('addressZip')),
        updatedAt: nowIso(),
      }).where(eq(schema.kids.id, id));
      return back('details');
    }
    // Rejected: hand the typed values back to the form below.
    typed = Object.fromEntries([...form.entries()]
      .filter(([, val]) => typeof val === 'string')) as Record<string, string>;
  }

  if (act === 'save-profile') {
    const classId = num(form.get('classId'));
    const routeId = num(form.get('routeId'));
    const allergies = str(form.get('allergies'));
    const medicalNotes = str(form.get('medicalNotes'));
    const inClub = form.get('inClub') === '1';
    await db.update(schema.kids).set({
      classId, routeId, allergies, medicalNotes, inClub, updatedAt: nowIso(),
      // A stop number belongs to a route: moved to another one, the child is
      // unplaced there rather than landing at some other route's stop 4.
      ...(routeId !== child.routeId ? { routeStop: null } : {}),
    }).where(eq(schema.kids.id, id));
    return back('profile');
  }

  if (act === 'add-guardian') {
    const name = str(form.get('name'));
    if (!name) { error = 'A guardian needs a name.'; }
    else {
      const phone = str(form.get('phone'));
      const at = nowIso();
      await db.insert(schema.kidGuardians).values({
        kidId: id, name, relationship: str(form.get('relationship')),
        phone, phoneE164: toE164(phone), email: str(form.get('email')),
        isPrimary: false,
        // A guardian added by hand starts as 'unknown', never opted in. Consent
        // is something a family gives, not something a form defaults to.
        smsConsent: 'unknown',
        createdAt: at, updatedAt: at,
      });
      return back('guardian-added');
    }
  }

  if (act === 'save-guardian') {
    const gid = num(form.get('guardianId'));
    const name = str(form.get('name'));
    if (!gid || !name) { error = 'A guardian needs a name.'; }
    else {
      const phone = str(form.get('phone'));
      const consent = String(form.get('smsConsent') ?? 'unknown');
      const valid = ['unknown', 'opted_in', 'opted_out'].includes(consent)
        ? consent as 'unknown' | 'opted_in' | 'opted_out' : 'unknown';
      const [existing] = await db.select({ smsConsent: schema.kidGuardians.smsConsent })
        .from(schema.kidGuardians)
        .where(and(eq(schema.kidGuardians.id, gid), eq(schema.kidGuardians.kidId, id))).limit(1);
      if (!existing) { error = 'That guardian is not on this child.'; }
      else {
        const at = nowIso();
        // Only stamp the consent source and date when the ANSWER changed.
        // Re-saving a phone number should not rewrite the evidence of when a
        // family agreed, which is the whole point of keeping the date.
        const changed = existing.smsConsent !== valid;
        await db.update(schema.kidGuardians).set({
          name, relationship: str(form.get('relationship')),
          phone, phoneE164: toE164(phone), email: str(form.get('email')),
          smsConsent: valid,
          /* Typing a number here makes this a guardian in their own right.
           * Directory linking is gone (the pastor, 2026-09-11) and a row that still
           * claimed a member link would keep resolving its phone from the
           * member record, so the number just typed would be stored and then
           * ignored by the sender. */
          memberPersonId: null,
          ...(changed ? { smsConsentSource: 'recorded-by-staff', smsConsentAt: at } : {}),
          updatedAt: at,
        }).where(and(eq(schema.kidGuardians.id, gid), eq(schema.kidGuardians.kidId, id)));
        return back('guardian');
      }
    }
  }

  if (act === 'remove-guardian') {
    const gid = num(form.get('guardianId'));
    // Scoped to THIS child as well as the id, so a guardian id from another
    // child's page cannot be deleted by editing a form value.
    if (gid) await db.delete(schema.kidGuardians)
      .where(and(eq(schema.kidGuardians.id, gid), eq(schema.kidGuardians.kidId, id)));
    return back('guardian-removed');
  }

  if (act === 'add-note') {
    const body = str(form.get('body'));
    if (!body) error = 'Type the note first.';
    else if (body.length > MAX_NOTE) error = `That note is too long — keep it under ${MAX_NOTE} characters.`;
    else {
      await db.insert(schema.kidNotes).values({
        kidId: id, body,
        staffId: user.id > 0 ? user.id : null,
        authorName: user.name || user.email,
        createdAt: nowIso(),
      });
      return back('note');
    }
  }

  if (act === 'delete-note') {
    /*
     * Your own, or a director's call on anybody's.
     *
     * A volunteer who mistypes what happened should be able to take it back;
     * a volunteer who wrote something in temper should not be able to quietly
     * erase it once it has been read. Those pull in opposite directions and
     * this is the line between them — you may unsay your own words, and the
     * director may remove anyone's.
     */
    const noteId = num(form.get('noteId'));
    if (noteId) {
      const [note] = await db.select({ staffId: schema.kidNotes.staffId })
        .from(schema.kidNotes)
        .where(and(eq(schema.kidNotes.id, noteId), eq(schema.kidNotes.kidId, id))).limit(1);
      // staffId null is the kiosk or the demo user, and matches nobody: a null
      // author must not become "everyone's note" for a session whose id is 0.
      const mine = note?.staffId != null && note.staffId === user.id;
      if (note && (canLinkChurchRecords(user.role) || mine)) {
        // Scoped to this child as well as the id, so a note id from another
        // child's page cannot be deleted by editing a form value.
        await db.delete(schema.kidNotes)
          .where(and(eq(schema.kidNotes.id, noteId), eq(schema.kidNotes.kidId, id)));
      }
    }
    return back('note-deleted');
  }

  if (act === 'award' || act === 'spend') {
    const amount = parseAmount(String(form.get('amount') ?? ''));
    if (amount === null) {
      error = `Enter a whole number of bucks, 1 to ${MAX_AMOUNT}.`;
    } else {
      /*
       * The SIGN comes from the button, never from what was typed. parseAmount
       * refuses a minus, so "-5" in the spend box cannot quietly become a
       * five-buck award — which is the sort of thing nobody would notice for
       * weeks, and then only because a child said so.
       */
      await db.insert(schema.kidLedger).values({
        kidId: id,
        delta: act === 'award' ? amount : -amount,
        reason: act,
        note: str(form.get('note')),
        staffId: user.id > 0 ? user.id : null,
        createdAt: nowIso(),
      });
      return back(act === 'award' ? 'awarded' : 'spent');
    }
  }

  if (act === 'undo-entry') {
    const entryId = num(form.get('entryId'));
    if (entryId) {
      const [entry] = await db.select().from(schema.kidLedger)
        .where(and(eq(schema.kidLedger.id, entryId), eq(schema.kidLedger.kidId, id))).limit(1);
      /*
       * Undo is a NEW ROW of the opposite sign, not a delete.
       *
       * This is where append-only earns its keep: a child who asks why their
       * balance changed can be shown both the mistake and the fix, which
       * "we deleted it" cannot do.
       *
       * Attendance credits are excluded on purpose — they are undone by
       * unticking the register, which removes the row so that re-ticking can
       * credit again. A correction here would leave the original occupying the
       * unique index and the child permanently down.
       */
      if (entry && entry.reason !== 'attendance') {
        await db.insert(schema.kidLedger).values({
          kidId: id, delta: -entry.delta, reason: 'correction',
          note: `Undid: ${REASON_LABEL[entry.reason] ?? entry.reason}`
              + (entry.note ? ` — ${entry.note}` : ''),
          staffId: user.id > 0 ? user.id : null,
          createdAt: nowIso(),
        });
      }
      return back('undone');
    }
  }

  if (act === 'archive' || act === 'restore') {
    /*
     * ARCHIVED, NEVER DELETED — the same rule the rest of the app follows.
     *
     * Attendance rows and ledger entries point at this child. A hard delete
     * would cascade and silently change historical totals: a term's attendance
     * would quietly drop, and a child's Fairhaven Bucks history would vanish along
     * with the record of what they earned it for.
     *
     * It takes them out of every Fairhaven Kids list, register, card check-in and
     * guardian text, and keeps their details and history for if they come
     * back. It cannot touch the church's People tab: Fairhaven Kids has its own list.
     *
     * Director and above: removing a child from the section is structural, and
     * a mis-tap on a phone should not empty somebody's class.
     */
    if (!canLinkChurchRecords(user.role)) return back('profile');
    await db.update(schema.kids).set({ archived: act === 'archive', updatedAt: nowIso() })
      .where(eq(schema.kids.id, id));
    return act === 'archive'
      ? Astro.redirect('/kids/children?saved=archived', 303)
      : back('restored');
  }

  if (act === 'issue-card' || act === 'revoke-card') {
    /*
     * Director and above. Checked HERE rather than by path, because cards live
     * on a page teachers need for everything else — but the rule itself lives
     * in lib/permissions.ts with the others, so there is one file to read to
     * know what a teacher cannot do.
     *
     * Refused silently back to the page rather than with an error: a teacher
     * has no button to press, so arriving here at all means a stale form or a
     * hand-made request, and neither deserves an explanation.
     */
    if (!canIssueCards(user.role)) return back('profile');

    if (act === 'issue-card') {
      /*
       * Issuing REVOKES whatever came before, in the same breath.
       *
       * Two live cards for one child is two of everything the card can do —
       * and from release two, two kiosk taps. The old token stays in the table
       * rather than being overwritten, so a card found later can be identified
       * as the revoked one instead of silently working.
       */
      const at = nowIso();
      await db.update(schema.kidCards)
        .set({ active: false, revokedAt: at })
        .where(and(eq(schema.kidCards.kidId, id), eq(schema.kidCards.active, true)));
      await db.insert(schema.kidCards).values({
        kidId: id,
        // 32 bytes of crypto randomness as hex. Opaque: nothing about the
        // child is recoverable from it, and it is not guessable from another.
        token: randomToken(32),
        active: true, issuedAt: at, issuedBy: user.email,
      });
      return back('card-issued');
    }

    const cardId = num(form.get('cardId'));
    // Scoped to this child as well as the id, so a card id from another
    // child's page cannot be revoked by editing a form value.
    if (cardId) await db.update(schema.kidCards)
      .set({ active: false, revokedAt: nowIso() })
      .where(and(eq(schema.kidCards.id, cardId), eq(schema.kidCards.kidId, id)));
    return back('card-revoked');
  }

  if (act === 'photo' && photosEnabled(env)) {
    const file = form.get('photo');
    if (file instanceof File && file.size > 0) {
      if (file.size > MAX_UPLOAD_BYTES) error = 'That photo is too large.';
      else {
        const bytes = new Uint8Array(await file.arrayBuffer());
        // The real leading bytes, not the browser's content-type header, which
        // is attacker-controlled. These files are served back to browsers.
        const mime = sniffImage(bytes);
        if (!mime) error = 'That does not look like a JPEG, PNG or WebP.';
        else {
          const key = await putPhoto(env, id, bytes, mime, 'kids');
          await db.update(schema.kids).set({ photoKey: key, updatedAt: nowIso() })
            .where(eq(schema.kids.id, id));
          await deletePhoto(env, child.photoKey);
          return back('photo');
        }
      }
    } else error = 'Choose a photo first.';
  }

  if (act === 'photo-remove') {
    await deletePhoto(env, child.photoKey);
    await db.update(schema.kids).set({ photoKey: null, updatedAt: nowIso() })
      .where(eq(schema.kids.id, id));
    return back('photo-removed');
  }
}

// ---- reads ------------------------------------------------------------------
/* Archived children are still readable HERE — otherwise archiving somebody
 * would bounce you off the only page that can bring them back. They are hidden
 * from the lists, the registers and the audiences, which is the point. */
const [child] = await db.select().from(schema.kids)
  .where(eq(schema.kids.id, id)).limit(1);
if (!child) return Astro.redirect('/kids/children', 302);
/* One row holds both who they are and their Fairhaven Kids details now; the second
 * name keeps the template below reading the way it always has. */
const profile = child;

/*
 * Active classes and routes, PLUS whichever this child is already in even if it
 * has been stopped.
 *
 * Without the second half, a child in a class the director switched off would
 * render with "— not in a class —" selected, and the next person to save
 * anything on this page — a phone number, an allergy — would silently move them
 * out of it. A form must not quietly discard a value just because the option
 * list stopped offering it.
 */
const classRows = await db.select().from(schema.kidClasses)
  .where(profile?.classId
    ? or(eq(schema.kidClasses.active, true), eq(schema.kidClasses.id, profile.classId))
    : eq(schema.kidClasses.active, true))
  .orderBy(asc(schema.kidClasses.sort));
const routeRows = await db.select().from(schema.kidRoutes)
  .where(profile?.routeId
    ? or(eq(schema.kidRoutes.active, true), eq(schema.kidRoutes.id, profile.routeId))
    : eq(schema.kidRoutes.active, true))
  .orderBy(asc(schema.kidRoutes.name));

/*
 * The grown-ups. Name and number, typed in here and owned here.
 *
 * Linking a guardian to a church directory record was removed on 2026-09-11
 * (the pastor: "I just want the name of the parent and their phone number"). The
 * column survives, because kids-recipients.ts and the replies tab still resolve
 * it and no migration should drop a foreign key to make a form shorter — but
 * nothing creates one any more, and saving a guardian clears it.
 *
 * memberPhone is joined for exactly one reason: a row linked BEFORE the change
 * keeps its number on the member record, so the field below falls back to it
 * and the first save brings it across. Without that the number would render as
 * an empty box and look like a guardian nobody can reach.
 */
const guardians = await db.select({
  id: schema.kidGuardians.id,
  name: schema.kidGuardians.name,
  relationship: schema.kidGuardians.relationship,
  phone: schema.kidGuardians.phone,
  email: schema.kidGuardians.email,
  smsConsent: schema.kidGuardians.smsConsent,
  smsConsentSource: schema.kidGuardians.smsConsentSource,
  smsConsentAt: schema.kidGuardians.smsConsentAt,
  memberPhone: schema.people.phone,
}).from(schema.kidGuardians)
  .leftJoin(schema.people, eq(schema.people.id, schema.kidGuardians.memberPersonId))
  .where(eq(schema.kidGuardians.kidId, id))
  .orderBy(asc(schema.kidGuardians.id));

const ageClasses: AgeClass[] = classRows.map((c) => ({
  id: c.id, name: c.name, minAge: c.minAge, maxAge: c.maxAge,
}));
const age = ageOn(child.birthday, churchToday());
const suggested = suggestClass(age, ageClasses);
const outgrown = classMismatch(age, profile?.classId ?? null, ageClasses) === true;

/* The whole ledger for the balance, and the most recent slice to show. Seventy
 * children with a handful of rows each makes this one cheap read; a stored
 * balance column would be a race between two teachers awarding at once. */
const ledger = await db.select().from(schema.kidLedger)
  .where(eq(schema.kidLedger.kidId, id))
  .orderBy(desc(schema.kidLedger.id));
const balance = balanceOf(ledger);
const recent = ledger.slice(0, 8);

/* Newest first: on a bus on the way home, the note that matters is the one
 * from twenty minutes ago. */
const notes = await db.select().from(schema.kidNotes)
  .where(eq(schema.kidNotes.kidId, id))
  .orderBy(desc(schema.kidNotes.id));

const cards = await db.select().from(schema.kidCards)
  .where(eq(schema.kidCards.kidId, id))
  .orderBy(desc(schema.kidCards.id));
const liveCard = cards.find((c) => c.active) ?? null;

/* The URL that goes on the tag. Built from the request's own origin so it is
 * right in every environment without a variable to forget — the same reason
 * the Twilio signature check trusts request.url. */
const cardUrl = liveCard ? `${Astro.url.origin}/kids/card/${liveCard.token}` : null;

const saved = Astro.url.searchParams.get('saved');
const SAVED: Record<string, string> = {
  profile: 'Saved.', photo: 'Photo updated.', 'photo-removed': 'Photo removed.',
  details: 'Details saved.',
  note: 'Note added.', 'note-deleted': 'Note deleted.',
  guardian: 'Guardian saved.', 'guardian-added': 'Guardian added.',
  'guardian-removed': 'Guardian removed.',
  awarded: 'Bucks awarded.', spent: 'Bucks spent.', undone: 'That entry was undone.',
  restored: 'Back in Fairhaven Kids.',
  copied: 'Copied from the church records. Choose their class and route below, and add a guardian.',
  // The add-child form redirects here with this and there was nothing to show
  // for it, so adding a child landed on a page that said nothing had happened.
  created: 'Added. Fill in anything you did not have to hand.',
  'card-issued': 'New card issued. Any earlier card has stopped working.',
  'card-revoked': 'Card revoked. It will no longer open anything.',
};
const title = `${child.firstName} ${child.lastName}`;
---
<KidsLayout title={title} user={user}>
  <p style="margin:0 0 6px;"><a href="/kids/children" style="font-size:15px;">← All children</a></p>
  <div style="display:flex; gap:14px; align-items:baseline; flex-wrap:wrap;">
    <h1 style="margin-bottom:4px;">{title}</h1>
    {/* The page a card tap opens. Reachable without one too — a card gets lost,
        and a teacher may just want a balance without setting anything up. */}
    <a href={`/kids/child/${child.id}/quick`} class="k-classroom">Classroom view →</a>
  </div>
  <p class="k-muted" style="margin:0 0 22px;">
    {age !== null ? `${age} years old` : 'No birthday on file'}
  </p>

  {child.archived && (
    <div class="k-card" style="border-left:5px solid #a3540a; margin-bottom:18px;">
      <strong>This child is archived from Fairhaven Kids.</strong>
      <p class="k-muted" style="margin:6px 0 0;">
        They are hidden from the Fairhaven Kids lists, the registers and any texts.
        Nothing has been deleted — their attendance and bucks are still here.
      </p>
      {canLinkChurchRecords(user.role) && (
        <form method="POST" style="margin:12px 0 0;">
          <input type="hidden" name="action" value="restore" />
          <button class="k-btn" type="submit">Bring them back</button>
        </form>
      )}
    </div>
  )}

  {error && <div class="k-card" style="border-left:5px solid #b01818; margin-bottom:18px;"><strong>{error}</strong></div>}
  {saved && SAVED[saved] && <div class="k-card" style="border-left:5px solid #1f6b3a; margin-bottom:18px;">{SAVED[saved]}</div>}

  {/* Allergies first, above everything else, in red. Not a field in a form
      somebody scrolls to — the one thing that has to be seen without looking. */}
  {profile?.allergies && (
    <div class="k-card" style="border-left:6px solid #b01818; margin-bottom:18px;">
      <div class="k-label" style="color:#b01818;">Allergies</div>
      <p style="margin:6px 0 0; font-size:19px; font-weight:600;">{profile.allergies}</p>
      {profile.medicalNotes && <p class="k-muted" style="margin:8px 0 0;">{profile.medicalNotes}</p>}
    </div>
  )}

  {/* ---------------------------------------------------------------------
      WHO THEY ARE, first.

      This page used to open with the class they sit in, put the photo in a
      column beside it, keep the grown-ups eight hundred pixels below the
      bucks, and hide "add a grown-up" in a closed panel at the very bottom —
      so the answer to "who is this child and who do we ring?" was assembled
      from four places in three different shapes.

      One section now, in the order somebody actually asks: their name and
      face, where they live, who to ring. What they DO here — class, route,
      bucks, card — follows underneath, because none of it is any use until
      this part is right.
      --------------------------------------------------------------------- */}
  <h2 class="k-h" style="margin-top:0;">Personal information</h2>

  <div class="k-card" style="margin-bottom:14px;">
    <div class="k-person">
      <div>
        {child.photoKey ? (
          <img src={`/kids/photo/${child.id}?v=${encodeURIComponent(child.photoKey.slice(-8))}`}
               alt="" width="132" height="132" class="k-photo" />
        ) : (
          /* Their initials rather than an empty box, so the slot reads as a
             photo that has not been taken yet instead of a broken one. */
          <div class="k-photo k-photo--none" aria-hidden="true">
            {child.firstName.slice(0, 1)}{child.lastName.slice(0, 1)}
          </div>
        )}
        {photosEnabled(env) ? (
          <>
            <form method="POST" enctype="multipart/form-data" style="margin:12px 0 0;">
              <input type="hidden" name="action" value="photo" />
              <input type="file" name="photo" accept="image/jpeg,image/png,image/webp"
                     style="font-size:13px; max-width:100%;" />
              <button class="k-btn k-btn--quiet" type="submit" style="margin-top:8px;">Upload</button>
            </form>
            {child.photoKey && (
              <form method="POST" style="margin:8px 0 0;">
                <input type="hidden" name="action" value="photo-remove" />
                <button class="k-btn k-btn--quiet" type="submit">Remove photo</button>
              </form>
            )}
          </>
        ) : (
          <p class="k-muted" style="margin:12px 0 0; font-size:13px;">
            Photo storage is not switched on in this environment.
          </p>
        )}
      </div>

      <form method="POST" style="margin:0;">
        <input type="hidden" name="action" value="save-details" />

        <div class="k-grid">
          <label class="k-field"><span>First name</span>
            <input name="firstName" value={typed?.firstName ?? child.firstName}
                   required autocomplete="off" /></label>
          <label class="k-field"><span>Last name</span>
            <input name="lastName" value={typed?.lastName ?? child.lastName}
                   required autocomplete="off" /></label>
          <label class="k-field"><span>Date of birth</span>
            <input type="date" name="birthday" value={typed?.birthday ?? child.birthday ?? ''} /></label>
        </div>

        <div class="k-sub">Where they live</div>
        <label class="k-field"><span>Street</span>
          <input name="addressStreet" value={typed?.addressStreet ?? child.addressStreet ?? ''}
                 autocomplete="off" /></label>
        <div class="k-grid">
          <label class="k-field"><span>City</span>
            <input name="addressCity" value={typed?.addressCity ?? child.addressCity ?? ''}
                   autocomplete="off" /></label>
          <label class="k-field"><span>State</span>
            <input name="addressState" value={typed?.addressState ?? child.addressState ?? ''}
                   maxlength="2" autocomplete="off" /></label>
          <label class="k-field"><span>ZIP</span>
            <input name="addressZip" value={typed?.addressZip ?? child.addressZip ?? ''}
                   autocomplete="off" /></label>
        </div>

        <button class="k-btn" type="submit">Save details</button>
      </form>
    </div>
  </div>

  <div class="k-card" style="margin-bottom:18px;">
    <div class="k-sub k-sub--first">Parents and guardians</div>

    {guardians.map((g) => (
      <div class="k-guardian">
        <form method="POST" style="margin:0;">
          <input type="hidden" name="action" value="save-guardian" />
          <input type="hidden" name="guardianId" value={g.id} />
          <div class="k-grid">
            {/* Name and number first, because they are the two that matter and
                the other three are usually left alone. */}
            <label class="k-field"><span>Name</span>
              <input name="name" value={g.name} required autocomplete="off" /></label>
            <label class="k-field"><span>Phone</span>
              {/* memberPhone is the fallback for a guardian linked to a church
                  record before that feature was removed: their number lived on
                  the member row, so it is shown here and becomes theirs on the
                  first save. Without it the field would render empty and look
                  like a guardian with no number at all. */}
              <input name="phone" type="tel" value={g.phone ?? g.memberPhone ?? ''}
                     placeholder="(317) 555-0142" autocomplete="off" /></label>
            <label class="k-field"><span>Relationship</span>
              <input name="relationship" value={g.relationship ?? ''}
                     placeholder="mother" autocomplete="off" /></label>
            <label class="k-field"><span>Email</span>
              <input name="email" type="email" value={g.email ?? ''} autocomplete="off" /></label>
            <label class="k-field"><span>Texting</span>
              <select name="smsConsent">
                <option value="unknown" selected={g.smsConsent === 'unknown'}>Not recorded</option>
                <option value="opted_in" selected={g.smsConsent === 'opted_in'}>Agreed to be texted</option>
                <option value="opted_out" selected={g.smsConsent === 'opted_out'}>Opted out</option>
              </select>
            </label>
          </div>
          {/* An opt-out that came from the family THEMSELVES, by text. Staff can
              still change it — a family may re-consent in person — but it should
              never be flipped back without somebody noticing they are doing it. */}
          {g.smsConsent === 'opted_out' && g.smsConsentSource === 'sms-stop' && (
            <p style="margin:0 0 10px; color:#b01818; font-size:14px;">
              They texted STOP{g.smsConsentAt ? ` on ${g.smsConsentAt.slice(0, 10)}` : ''}.
              Do not put them back without them asking.
            </p>
          )}
          <button class="k-btn" type="submit">Save</button>
        </form>
        {/* Its OWN form, not a second button inside the one above.
            A form carries its fields in document order, so the hidden
            action=save-guardian sitting at the top won the read and this button
            saved the guardian it was meant to remove. */}
        <form method="POST" class="k-guardian__remove">
          <input type="hidden" name="action" value="remove-guardian" />
          <input type="hidden" name="guardianId" value={g.id} />
          <button class="k-btn k-btn--quiet" type="submit"
                  onclick="return confirm('Remove this grown-up from this child?')">Remove</button>
        </form>
      </div>
    ))}

    {/* Always here, never behind a disclosure triangle. Adding the second
        grown-up is a normal thing to do on this page, and it used to mean
        scrolling past the bucks and the card to a closed panel at the bottom. */}
    <form method="POST" class="k-guardian">
      <input type="hidden" name="action" value="add-guardian" />
      <div class="k-grid">
        <label class="k-field"><span>Name</span>
          <input name="name" required autocomplete="off" placeholder="Add another grown-up" /></label>
        <label class="k-field"><span>Phone</span>
          <input name="phone" type="tel" placeholder="(317) 555-0142" autocomplete="off" /></label>
        <label class="k-field"><span>Relationship</span>
          <input name="relationship" placeholder="mother" autocomplete="off" /></label>
        <label class="k-field"><span>Email</span>
          <input name="email" type="email" autocomplete="off" /></label>
      </div>
      <button class="k-btn k-btn--quiet" type="submit">Add this grown-up</button>
    </form>
  </div>

  <h2 class="k-h">In Fairhaven Kids</h2>
  <div class="k-card" style="margin-bottom:18px;">
    <form method="POST">
      <input type="hidden" name="action" value="save-profile" />

      <div class="k-grid">
        <label class="k-field"><span>Class</span>
          <select name="classId">
            <option value="">— not in a class —</option>
            {classRows.map((c) => (
              <option value={c.id} selected={profile?.classId === c.id}>
                {c.name}{c.active ? '' : ' (not running)'}
              </option>
            ))}
          </select>
        </label>

        <label class="k-field"><span>Bus route</span>
          <select name="routeId">
            {/* Most children walk in with their family, so no route is the
                normal answer and it is listed first. */}
            <option value="">— no route —</option>
            {routeRows.map((r) => (
              <option value={r.id} selected={profile?.routeId === r.id}>
                {r.name}{r.active ? '' : ' (not running)'}
              </option>
            ))}
          </select>
        </label>
      </div>

      {/* A SUGGESTION, never applied on its own. Class is a stored fact
          because most bus children have no birthday to derive one from. */}
      {suggested && outgrown && (
        <p style="margin:-6px 0 14px; color:#a3540a; font-size:14px;">
          Their age suggests <strong>{suggested.name}</strong>.
        </p>
      )}
      {suggested && !profile?.classId && (
        <p class="k-muted" style="margin:-6px 0 14px; font-size:14px;">
          Their age suggests {suggested.name}.
        </p>
      )}

      <label class="k-field"><span>Allergies</span>
        <input name="allergies" value={profile?.allergies ?? ''}
               placeholder="Peanuts — EpiPen in the office" autocomplete="off" /></label>
      <label class="k-field"><span>Medical notes</span>
        <textarea name="medicalNotes" rows="2">{profile?.medicalNotes ?? ''}</textarea></label>

      <label style="display:flex; gap:10px; align-items:center; font-size:15px; margin:0 0 16px;">
        <input type="checkbox" name="inClub" value="1" checked={profile?.inClub ?? false} />
        <span>Comes to Kids Club (Wednesday) — puts them on the Club attendance list</span>
      </label>

      <button class="k-btn" type="submit">Save</button>
    </form>
  </div>

  {/* ---------------------------------------------------------------------
      Read here, written mostly elsewhere.

      A teacher types these on the classroom screen with the child's card in
      their hand. This is the other end: a bus worker on the way home, opening
      the profile to find out what to say to the parent at the door.

      So the list comes first and newest-first, and the box to add one sits
      under it. Separate from allergies on purpose — an allergy is a standing
      fact shown in red above everything, and one difficult Wednesday must
      never be promoted into looking like one.
      --------------------------------------------------------------------- */}
  <h2 class="k-h">Notes</h2>
  <div class="k-card" style="margin-bottom:18px;">
    {notes.length === 0
      ? <p class="k-muted" style="margin:0 0 18px;">No notes yet.</p>
      : (
        <div style="margin-bottom:18px;">
          {notes.map((n) => (
            <div class="k-note">
              <p class="k-note__body">{n.body}</p>
              <p class="k-note__by">
                <span>{noteStamp(n.createdAt)}{n.authorName ? ` · ${n.authorName}` : ''}</span>
                {(canLinkChurchRecords(user.role)
                  || (n.staffId != null && n.staffId === user.id)) && (
                  <form method="POST" style="margin:0;">
                    <input type="hidden" name="action" value="delete-note" />
                    <input type="hidden" name="noteId" value={n.id} />
                    <button class="k-undo" type="submit"
                            onclick="return confirm('Delete this note?')">delete</button>
                  </form>
                )}
              </p>
            </div>
          ))}
        </div>
      )}

    <form method="POST" style="margin:0;">
      <input type="hidden" name="action" value="add-note" />
      <label class="k-field"><span>Add a note</span>
        <textarea name="body" rows="3" maxlength={MAX_NOTE} required
                  placeholder="What happened?"></textarea></label>
      <button class="k-btn" type="submit">Save note</button>
    </form>
  </div>

  <h2 style="margin:28px 0 12px;">Fairhaven Bucks</h2>
  <div class="k-card" style="margin-bottom:18px;">
    <div class="k-label" style="color:var(--k-ink-soft);">Balance</div>
    <p style="margin:2px 0 16px; font-size:34px; font-weight:800; line-height:1;">
      {balance}<span style="font-size:16px; font-weight:600; color:var(--k-ink-soft); margin-left:8px;">bucks</span>
    </p>

    <div class="k-bucks">
      <form method="POST" class="k-bucks__form">
        <input type="hidden" name="action" value="award" />
        <div class="k-bucks__row">
          <input name="amount" type="number" min="1" max={MAX_AMOUNT} placeholder="5" required
                 aria-label="Bucks to award" />
          <input name="note" placeholder="What for?" autocomplete="off" aria-label="What for" />
          <button class="k-btn" type="submit">Award</button>
        </div>
      </form>
      <form method="POST" class="k-bucks__form">
        <input type="hidden" name="action" value="spend" />
        <div class="k-bucks__row">
          <input name="amount" type="number" min="1" max={MAX_AMOUNT} placeholder="5" required
                 aria-label="Bucks to spend" />
          <input name="note" placeholder="On what?" autocomplete="off" aria-label="On what" />
          <button class="k-btn k-btn--quiet" type="submit">Spend</button>
        </div>
      </form>
    </div>

    {recent.length > 0 && (
      <div style="margin-top:18px; border-top:1px solid rgba(13,27,69,.1); padding-top:14px;">
        <div class="k-label" style="color:var(--k-ink-soft); margin-bottom:8px;">Recent</div>
        {recent.map((e) => (
          <div class="k-entry">
            <span class="k-entry__delta" class:list={[e.delta < 0 && 'is-down']}>
              {e.delta > 0 ? `+${e.delta}` : e.delta}
            </span>
            <span class="k-entry__what">
              {REASON_LABEL[e.reason] ?? e.reason}
              {e.note && <span class="k-muted"> · {e.note}</span>}
            </span>
            <span class="k-entry__when k-muted">{e.createdAt.slice(0, 10)}</span>
            {/* Attendance credits are undone by unticking the register, not
                here — see the handler for why a correction would strand them. */}
            {e.reason !== 'attendance' && (
              <form method="POST" style="margin:0;">
                <input type="hidden" name="action" value="undo-entry" />
                <input type="hidden" name="entryId" value={e.id} />
                <button class="k-undo" type="submit"
                        onclick="return confirm('Undo this entry?')">undo</button>
              </form>
            )}
          </div>
        ))}
        {ledger.length > recent.length && (
          <p class="k-muted" style="margin:10px 0 0; font-size:14px;">
            and {ledger.length - recent.length} older {ledger.length - recent.length === 1 ? 'entry' : 'entries'}
          </p>
        )}
      </div>
    )}
  </div>

  <h2 style="margin:28px 0 12px;">Card</h2>
  <div class="k-card" style="margin-bottom:18px;">
    {liveCard ? (
      <>
        <p style="margin-top:0;">
          Issued {liveCard.issuedAt.slice(0, 10)}
          {liveCard.issuedBy && <span class="k-muted"> by {liveCard.issuedBy}</span>}
        </p>
        {canIssueCards(user.role) ? (
          <>
            {/* The URL to write to the tag. Shown only to whoever may issue
                cards — it IS the credential, and a teacher has no reason to
                read one off a screen. */}
            <div class="k-label" style="color:var(--k-ink-soft);">Write this to the tag</div>
            <input readonly value={cardUrl} onclick="this.select()" class="k-token" />
            <form method="POST" style="display:inline-block; margin:0 8px 0 0;">
              <input type="hidden" name="action" value="revoke-card" />
              <input type="hidden" name="cardId" value={liveCard.id} />
              <button class="k-btn k-btn--quiet" type="submit"
                      onclick="return confirm('Revoke this card? It will stop working immediately.')">
                Revoke</button>
            </form>
            <form method="POST" style="display:inline-block; margin:0;">
              <input type="hidden" name="action" value="issue-card" />
              <button class="k-btn k-btn--quiet" type="submit"
                      onclick="return confirm('Issue a replacement? The current card stops working.')">
                Replace</button>
            </form>
          </>
        ) : (
          <p class="k-muted" style="margin-bottom:0;">
            Ask a director if this card needs replacing.
          </p>
        )}
      </>
    ) : (
      <>
        <p class="k-muted" style="margin-top:0;">No card issued.</p>
        {canIssueCards(user.role) ? (
          <form method="POST" style="margin:0;">
            <input type="hidden" name="action" value="issue-card" />
            <button class="k-btn" type="submit">Issue a card</button>
          </form>
        ) : (
          <p class="k-muted" style="margin-bottom:0;">A director can issue one.</p>
        )}
      </>
    )}

    {cards.filter((c) => !c.active).length > 0 && canIssueCards(user.role) && (
      <p class="k-muted" style="margin:14px 0 0; font-size:14px;">
        {cards.filter((c) => !c.active).length} earlier
        {cards.filter((c) => !c.active).length === 1 ? ' card has' : ' cards have'} been revoked
        and no longer open anything.
      </p>
    )}
  </div>

  {canLinkChurchRecords(user.role) && !child.archived && (
    <div class="k-card" style="margin-bottom:18px;">
      <div class="k-label" style="color:var(--k-ink-soft);">If they age out or stop coming</div>
      <p class="k-muted" style="margin:6px 0 0; font-size:14px;">
        Takes them off every Fairhaven Kids list. Nothing is deleted, and they can be brought back.
      </p>
      <form method="POST" style="margin:10px 0 0;">
        <input type="hidden" name="action" value="archive" />
        <button class="k-btn k-btn--quiet" type="submit"
                onclick="return confirm('Archive this child from Fairhaven Kids? They stay on the church People list, their attendance and bucks are kept, and you can bring them back.')">
          Archive from Fairhaven Kids</button>
      </form>
    </div>
  )}
</KidsLayout>

<style>
  .k-h { margin:30px 0 12px; }
  /* Photo beside the fields, not in a column of its own — one question, one
     place to answer it. It collapses before the fields get too narrow to read. */
  .k-person { display:grid; gap:24px; align-items:start;
              grid-template-columns: 150px minmax(0, 1fr); }
  @media (max-width: 640px) { .k-person { grid-template-columns: 1fr; } }
  .k-photo { width:132px; height:132px; border-radius:14px; object-fit:cover; display:block; }
  .k-photo--none { display:grid; place-items:center; font-size:34px; font-weight:800;
                   letter-spacing:.02em; color:var(--k-ink-soft); background:rgba(13,27,69,.07); }
  /* A ruled sub-heading, so one long card still reads as three answers rather
     than a wall of boxes. */
  .k-sub { font-size:12px; font-weight:700; letter-spacing:.1em; text-transform:uppercase;
           color:var(--k-ink-soft); margin:22px 0 12px; padding-top:16px;
           border-top:1px solid rgba(13,27,69,.1); }
  .k-sub--first { margin-top:0; padding-top:0; border-top:0; }
  .k-guardian { padding:18px 0 0; border-top:1px solid rgba(13,27,69,.1); margin-top:18px; }
  .k-guardian__remove { display:inline-block; margin:0 0 0 8px; }
  .k-note { padding:12px 0; border-top:1px solid rgba(13,27,69,.1); }
  .k-note:first-child { border-top:0; padding-top:0; }
  .k-note__body { margin:0; font-size:16px; white-space:pre-wrap; }
  .k-note__by { display:flex; align-items:center; gap:10px; margin:5px 0 0;
                font-size:13px; color:var(--k-ink-soft); }
  .k-grid { display:grid; gap:0 14px; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); }
  .k-field { display:block; margin-bottom:14px; }
  .k-field > span { display:block; font-size:12px; font-weight:700; letter-spacing:.1em;
                    text-transform:uppercase; color:var(--k-ink-soft); margin-bottom:5px; }
  .k-field input, .k-field select, .k-field textarea {
    width:100%; padding:10px 12px; font:inherit; font-size:16px; color:var(--k-ink);
    border:1px solid rgba(13,27,69,.22); border-radius:9px; background:#fff;
  }
  .k-btn { font:inherit; font-size:15px; font-weight:700; padding:10px 18px; border:0;
           border-radius:9px; background:var(--k-orange); color:#fff; cursor:pointer; }
  .k-btn--quiet { background:transparent; color:var(--k-ink-soft);
                  border:1px solid rgba(13,27,69,.22); font-weight:600; }
  .k-bucks { display:grid; gap:10px; }
  .k-bucks__row { display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
  .k-bucks__row input[type="number"] { width:88px; padding:10px 12px; font:inherit; font-size:16px;
    color:var(--k-ink); border:1px solid rgba(13,27,69,.22); border-radius:9px; background:#fff; }
  .k-bucks__row input[name="note"] { flex:1; min-width:150px; padding:10px 12px; font:inherit;
    font-size:16px; color:var(--k-ink); border:1px solid rgba(13,27,69,.22);
    border-radius:9px; background:#fff; }
  .k-entry { display:flex; align-items:center; gap:10px; padding:7px 0; font-size:15px; }
  .k-entry + .k-entry { border-top:1px solid rgba(13,27,69,.06); }
  .k-entry__delta { flex:0 0 48px; font-weight:800; color:#1f6b3a; }
  .k-entry__delta.is-down { color:#b01818; }
  .k-entry__what { flex:1; }
  .k-entry__when { flex:0 0 auto; font-size:13px; }
  .k-classroom { font-size:15px; font-weight:700; white-space:nowrap;
                 padding:8px 14px; border-radius:999px; text-decoration:none;
                 background:rgba(94,208,224,.14); border:1px solid rgba(94,208,224,.4); }
  .k-token { width:100%; margin-bottom:14px; padding:10px 12px; font-family:ui-monospace, SFMono-Regular, Menlo, monospace;
             font-size:13px; color:var(--k-ink); border:1px solid rgba(13,27,69,.22);
             border-radius:9px; background:#f6f8fc; }
  .k-undo { font:inherit; font-size:13px; background:none; border:0; cursor:pointer;
            color:var(--k-ink-soft); text-decoration:underline; padding:0; }
  .k-undo:hover { color:#b01818; }
</style>
