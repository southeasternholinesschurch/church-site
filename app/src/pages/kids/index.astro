---
import KidsLayout from '../../layouts/KidsLayout.astro';
import { getDb, schema } from '../../db';
import { and, eq, sql } from 'drizzle-orm';
import { churchToday, likelyKidsKind, kindLabel } from '../../lib/services';

/**
 * Fairhaven Kids — the landing page.
 *
 * A status board with one job: get a volunteer to tonight's list. The big
 * button is that job, and it carries the number a coordinator actually wants on
 * a Sunday or Wednesday evening — how many are checked in so far. Everything
 * else is a small second row, because it is used far less often.
 *
 * On a day with no children's meeting there is nothing to take attendance for,
 * and the page says so rather than offering a button that opens an empty list.
 */
const user = Astro.locals.user!;
const db = getDb(Astro.locals.runtime.env);
const director = user.role !== 'kids';

const today = churchToday();
const kind = likelyKidsKind(today);

/* Tonight's meeting only if somebody has already opened it. Counting nothing is
 * a true answer ("0 checked in"), and the button creates the meeting on tap. */
const [service] = kind
  ? await db.select({ id: schema.services.id }).from(schema.services)
      .where(and(eq(schema.services.date, today), eq(schema.services.kind, kind))).limit(1)
  : [undefined];
const [here] = service
  ? await db.select({ n: sql<number>`count(*)` }).from(schema.attendance)
      .where(eq(schema.attendance.serviceId, service.id))
  : [undefined];
const [enrolled] = await db.select({ n: sql<number>`count(*)` }).from(schema.kidProfiles)
  .innerJoin(schema.people, eq(schema.people.id, schema.kidProfiles.personId))
  .where(eq(schema.people.archived, false));

const TILES = [
  { name: 'Children', note: 'Every child — class, route, allergies and guardians.', href: '/kids/children' },
  { name: 'Messages', note: 'Text a bus route, and read what families replied.', href: '/kids/messaging' },
  ...(director ? [{ name: 'Setup', note: 'Classes, routes, cards and tablets.', href: '/kids/setup' }] : []),
];
---
<KidsLayout title="Fairhaven Kids" user={user}>
  {/* The wordmark IS the heading here. The h1 keeps the text for screen
      readers and for anything that cannot load the image. */}
  <h1 class="k-hero">
    <img src="/kids-logo-white.png" alt="Fairhaven Kids" width="450" height="220" />
  </h1>

  {kind ? (
    <a class="k-now" href="/kids/attendance">
      <span class="k-now__label">{kindLabel(kind)} · tonight</span>
      <span class="k-now__cta">Take attendance →</span>
      <span class="k-now__count">
        <strong>{here?.n ?? 0}</strong> checked in · {enrolled?.n ?? 0} children enrolled
      </span>
    </a>
  ) : (
    <div class="k-card k-now--none">
      <strong>No children’s meeting today.</strong>
      <p class="k-muted" style="margin:6px 0 0;">
        Fairhaven Kids meets Sunday evening and Wednesday evening.
        Need to fix a past one? <a href="/kids/register" style="color:var(--k-ink); font-weight:700;">Open another date</a>.
      </p>
    </div>
  )}

  <div class="k-tiles" style="margin-top:22px;">
    {TILES.map((t) => (
      <a class="k-tile" href={t.href}>
        <div class="k-tile__name">{t.name}</div>
        <div class="k-tile__note">{t.note}</div>
      </a>
    ))}
  </div>
</KidsLayout>

<style>
  /* Bigger than the header's, and capped so it does not dominate a phone. */
  .k-hero { margin: 0 0 18px; }
  .k-hero img { height: clamp(52px, 11vw, 84px); width: auto; display: block; }

  .k-now { display:block; max-width:620px; padding:22px 24px; border-radius:16px; text-decoration:none;
           background:var(--k-orange); color:#fff; }
  .k-now:hover { filter:brightness(1.06); }
  .k-now__label { display:block; font-size:12px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; opacity:.9; }
  .k-now__cta { display:block; font-size:clamp(26px, 6vw, 34px); font-weight:800; line-height:1.15; margin:6px 0 10px; }
  .k-now__count { display:block; font-size:16px; }
  .k-now__count strong { font-size:22px; }
  .k-now--none { max-width:620px; }
</style>
