---
import AppLayout from '../../layouts/AppLayout.astro';
import { readForm } from '../../lib/form';
import { getDb, schema, nowIso } from '../../db';
import { and, eq, or, like, sql, asc, inArray } from 'drizzle-orm';
import { demoOn, demoPerson } from '../../lib/demo';
import { archivePeople, restorePeople, parsePersonIds } from '../../lib/archive';
import { parseGroupTarget, resolveGroup, activePeople, memberCount, addToGroup,
         removeFromGroup } from '../../lib/groups';

const user = Astro.locals.user!;
const db = getDb(Astro.locals.runtime.env);

/**
 * Groups live here now, not on a tab of their own.
 *
 * They never were a place you went — they are a way of looking at the people
 * you are already looking at. A separate screen meant creating a list on one
 * page, adding people to it on a second, and being unable to see who was in it
 * anywhere at all. The list of groups is a fold at the bottom of this page,
 * and picking one filters the table above it.
 *
 * /groups still resolves; it redirects here.
 */
let groupError: string | null = null;
/*
 * The batch archive is a TWO-STEP POST, and the first step writes nothing.
 *
 * "Archive selected" only gathers the ticked ids and re-renders this page with
 * a confirmation card at the top naming everybody in it; the write happens on
 * the second button. That is why `review` below is state rather than a
 * redirect — this is the one branch on this page that falls THROUGH to the
 * normal render instead of returning, and the group branches must not swallow
 * it on the way past.
 *
 * A browser dialog would have been fewer lines. It would also have been the
 * only thing on this page that stops working without JavaScript, to guard the
 * one action here that can take a hundred people off every list at once.
 */
let review: { ids: number[]; restoring: boolean } | null = null;
let batchError: string | null = null;
/*
 * GROUPS FROM THE TICKS. The same checkboxes that archive also add to a group —
 * search a surname, tick the family, add; search the next. Adding is not
 * confirmed (nothing is lost, and anyone already in is skipped); removing many
 * is, in the same two-step way as archiving. See lib/groups.ts.
 *
 * "Select all shown" re-draws the page with every row ticked, so it needs no
 * script. `ticked` also carries the ticks back when an add is refused, so the
 * selection is not lost to a forgotten dropdown.
 */
let selectAll = false;
let ticked = new Set<number>();
let removeReview: { ids: number[]; groupId: number } | null = null;
if (Astro.request.method === 'POST') {
  const form = await readForm(Astro.request);
  const action = String(form.get('action') ?? '');
  /** Back to this same view with a notice — a 303, so a reload cannot repeat it. */
  const doneWith = (k: string, v: string, extra: Record<string, string> = {}) => {
    const done = new URLSearchParams(Astro.url.search);
    for (const key of ['added', 'addedTo', 'ticked', 'removed', 'removedFrom', 'archived', 'restored']) done.delete(key);
    done.set(k, v);
    for (const [ek, ev] of Object.entries(extra)) done.set(ek, ev);
    return Astro.redirect(`${Astro.url.pathname}?${done}`, 303);
  };

  if (action === 'select-all') selectAll = true;

  if (action === 'group-add') {
    const ids = parsePersonIds(form.getAll('personId'));
    const parsed = parseGroupTarget(form.get('targetGroup'), form.get('newGroupName'));
    if (!ids.length) batchError = 'Nobody was ticked, so nobody was added.';
    else if ('error' in parsed) batchError = parsed.error;
    else {
      const gid = await resolveGroup(db, parsed.target);
      if (!gid) batchError = 'That group no longer exists.';
      else {
        const before = await memberCount(db, gid);
        await addToGroup(db, gid, await activePeople(db, ids));
        const added = (await memberCount(db, gid)) - before;
        return doneWith('added', String(added), { addedTo: String(gid), ticked: String(ids.length) });
      }
    }
    ticked = new Set(ids);
  }

  if (action === 'group-remove-review' || action === 'group-remove-confirm') {
    const ids = parsePersonIds(form.getAll('personId'));
    const gid = Number(form.get('fromGroup'));
    const [g] = Number.isInteger(gid) && gid > 0
      ? await db.select({ id: schema.groups.id }).from(schema.groups).where(eq(schema.groups.id, gid)).limit(1)
      : [];
    if (!g) batchError = 'That group no longer exists.';
    else if (!ids.length) batchError = 'Nobody was ticked, so nobody was removed.';
    else if (action === 'group-remove-confirm') {
      const before = await memberCount(db, g.id);
      await removeFromGroup(db, g.id, ids);
      return doneWith('removed', String(before - (await memberCount(db, g.id))), { removedFrom: String(g.id) });
    } else removeReview = { ids, groupId: g.id };
    if (!removeReview) ticked = new Set(ids);
  }

  if (action === 'archive-review' || action === 'archive-confirm') {
    const ids = parsePersonIds(form.getAll('personId'));
    // Which direction is read from the FORM, not from the URL: the confirmation
    // has to mean what it said when it was drawn, even if the query string is
    // edited between the two steps.
    const restoring = String(form.get('restoring') ?? '') === '1';

    if (action === 'archive-confirm') {
      // Re-parsed from the hidden fields rather than trusted from the review —
      // the confirm step is an ordinary POST and can be replayed or edited.
      if (restoring) await restorePeople(db, ids);
      else await archivePeople(db, ids);
      // 303 back to the same view, so a reload cannot repeat it.
      const done = new URLSearchParams(Astro.url.search);
      for (const key of ['added', 'addedTo', 'ticked', 'removed', 'removedFrom']) done.delete(key);
      done.set(restoring ? 'restored' : 'archived', String(ids.length));
      return Astro.redirect(`${Astro.url.pathname}?${done}`, 303);
    }

    if (ids.length) review = { ids, restoring };
    else batchError = restoring
      ? 'Nobody was ticked, so nobody was restored.'
      : 'Nobody was ticked, so nobody was archived.';
  }
  // Back to the same view, fold still open — a search or filter survives the
  // round trip, which it would not if this redirected to a bare /people, and
  // the fold has to reopen or the result of the click is invisible.
  const params = new URLSearchParams(Astro.url.search);
  params.set('groups', 'open');
  const back = `${Astro.url.pathname}?${params}#groups`;

  if (action === 'create-group') {
    const name = String(form.get('name') ?? '').trim();
    if (!name) groupError = 'Give the group a name.';
    else {
      await db.insert(schema.groups)
        .values({ name, description: String(form.get('description') ?? '').trim() || null,
                  createdAt: nowIso() })
        .onConflictDoNothing();
      return Astro.redirect(back, 303);
    }
  }

  if (action === 'delete-group') {
    const id = Number(form.get('groupId'));
    // The membership rows go with it via ON DELETE CASCADE; nobody is removed
    // from the church by deleting a list.
    if (id) await db.delete(schema.groups).where(eq(schema.groups.id, id));
    return Astro.redirect(back, 303);
  }
}

const q = (Astro.url.searchParams.get('q') ?? '').trim();
const filter = Astro.url.searchParams.get('filter') ?? '';
const groupId = Number(Astro.url.searchParams.get('group')) || 0;
/* Open on arrival when the fold is the reason for arriving: a failed create
 * needs its error read, and /groups redirects here asking for exactly this. */
const groupsOpen = Astro.url.searchParams.get('groups') === 'open';

/** How many were written, for the notice after the redirect. */
const didArchive = Number(Astro.url.searchParams.get('archived')) || 0;
const didRestore = Number(Astro.url.searchParams.get('restored')) || 0;
const addedTo = Number(Astro.url.searchParams.get('addedTo')) || 0;
const didAdd = Number(Astro.url.searchParams.get('added')) || 0;
const didTick = Number(Astro.url.searchParams.get('ticked')) || 0;
const removedFrom = Number(Astro.url.searchParams.get('removedFrom')) || 0;
const didRemove = Number(Astro.url.searchParams.get('removed')) || 0;
/** "3 people" / "1 person" — built as one string, because Astro keeps the
 *  whitespace either side of an expression and "Archive 1  person?" is what
 *  splitting it across two lines actually renders. */
const countLabel = (n: number) => `${n} ${n === 1 ? 'person' : 'people'}`;

// The archived view is the ONLY one that shows them; every other filter hides
// them, which is what archiving is for.
const where = [eq(schema.people.archived, filter === 'archived')];
if (q) {
  // Parameterised by Drizzle — the search box is user input reaching SQL, and
  // hand-built strings are how that goes wrong.
  const term = `%${q}%`;
  where.push(or(
    like(schema.people.firstName, term),
    like(schema.people.lastName, term),
    like(schema.people.email, term),
    like(schema.people.phone, term),
  )!);
}
if (filter === 'unknown') where.push(eq(schema.people.adultChild, 'unknown'));
if (filter === 'adults') where.push(eq(schema.people.adultChild, 'adult'));
if (filter === 'children') where.push(eq(schema.people.adultChild, 'child'));
if (filter === 'no-email') where.push(sql`(email is null or email = '')`);
if (filter === 'textable') where.push(sql`phone_e164 is not null and sms_consent = 'opted_in'`);
if (filter === 'opted-out') where.push(eq(schema.people.smsConsent, 'opted_out'));
if (filter === 'needs-profile') where.push(eq(schema.people.needsProfile, true));
/*
 * "Missing details" — the filter this list existed without.
 *
 * The directory and this page read the SAME row; there is no second copy and
 * nothing to sync. But this table only ever showed name, phone and email, so a
 * birthday or address sitting on the record was invisible here while being
 * plainly visible in the directory — which reads exactly like the dashboard is
 * missing data it actually has. The "On file" column below fixes the looking;
 * this fixes the finding.
 */
if (filter === 'incomplete') {
  where.push(sql`(birthday is null or birthday = ''
                  or address_street is null or address_street = '')`);
}
/* Membership, as a predicate on this table rather than a join — a join would
   duplicate a row for anyone in the group twice, which cannot happen today but
   is the kind of thing that starts happening the week a second membership row
   becomes legal. */
if (groupId) {
  where.push(sql`exists (select 1 from people_groups pg
                          where pg.person_id = people.id and pg.group_id = ${groupId})`);
}

const demo = demoOn(Astro.url, user);
const rows = (await db.select().from(schema.people)
  .where(and(...where))
  .orderBy(asc(schema.people.lastName), asc(schema.people.firstName))
  .limit(500))
  // Display only — nothing is written, so demo mode cannot corrupt anything.
  .map((r) => demoPerson(r, r.id, demo));

/*
 * The people named in the confirmation, fetched by id rather than picked out of
 * `rows` above. They will normally be the same rows — the ticks came from this
 * very table — but the confirmation must name whoever is about to be written,
 * not whoever the current search happens to still match.
 */
const reviewPeople = review
  ? (await db.select().from(schema.people)
      .where(inArray(schema.people.id, review.ids))
      .orderBy(asc(schema.people.lastName), asc(schema.people.firstName)))
      .map((r) => demoPerson(r, r.id, demo))
  : [];

const groups = await db.select({
  id: schema.groups.id, name: schema.groups.name, description: schema.groups.description,
  members: sql<number>`(select count(*) from people_groups pg where pg.group_id = groups.id)`,
  reachable: sql<number>`(
    select count(*) from people_groups pg
      join people p on p.id = pg.person_id
     where pg.group_id = groups.id and p.archived = 0
       and p.phone_e164 is not null and p.sms_consent = 'opted_in')`,
}).from(schema.groups).orderBy(asc(schema.groups.name));
const chosenGroup = groups.find((g) => g.id === groupId) ?? null;
const addedGroup = groups.find((g) => g.id === addedTo) ?? null;
const removedGroup = groups.find((g) => g.id === removedFrom) ?? null;
const removeGroup = removeReview ? groups.find((g) => g.id === removeReview!.groupId) ?? null : null;
/* Named on the confirmation, fetched by id for the same reason reviewPeople is. */
const removePeople = removeReview
  ? (await db.select().from(schema.people)
      .where(inArray(schema.people.id, removeReview.ids.slice(0, 90)))
      .orderBy(asc(schema.people.lastName), asc(schema.people.firstName)))
      .map((r) => demoPerson(r, r.id, demo))
  : [];

const FILTERS: [string, string][] = [
  ['', 'Everyone'], ['unknown', 'Unconfirmed'], ['adults', 'Adults'],
  ['children', 'Children'], ['no-email', 'No email'],
  ['incomplete', 'Missing details'],
  /*
   * Last, and a different KIND of filter from the rest — the others narrow the
   * congregation, this one shows a set that is otherwise invisible.
   *
   * The view itself has worked since the page was written; nothing linked to
   * it. /people?filter=archived opened only if you typed it, so archiving
   * somebody put them somewhere with no door, which is most of why it looked
   * like there was no archiving at all.
   */
  ['archived', 'Archived'],
];
const archivedView = filter === 'archived';
/** A link to this same view with one thing changed. Everything else on screen
 *  — the search, the chip, the group — has to survive being clicked. */
const href = (f: string, g: number = groupId) => {
  const parts = [f && `filter=${f}`, q && `q=${encodeURIComponent(q)}`,
                 g && `group=${g}`].filter(Boolean);
  return `/people${parts.length ? '?' : ''}${parts.join('&')}`;
};
---
<AppLayout title="People" user={user}>
  {demo && (
    <p class="demo-flag">Demo mode — names, numbers and addresses on this page
    are invented. Counts and dates are real. <a href="/people">Turn it off</a>.</p>
  )}
  <div style="display:flex; align-items:baseline; gap:16px; flex-wrap:wrap; margin-bottom:18px;">
    <h1 style="margin:0;">People</h1>
    <span class="muted">{rows.length}{rows.length === 500 ? '+' : ''} shown</span>
    <a class="btn" href="/people/new" style="margin-left:auto;">Add a person</a>
    <a class="btn btn--ghost" href="/api/people/export?texting=1" download>Texting list (CSV)</a>
    <a class="btn btn--ghost" href="/api/people/export" download>Everyone (CSV)</a>
  </div>

  {didArchive > 0 && (
    <p class="notice notice--ok">
      Archived {countLabel(didArchive)}. They are off the check-in list
      and out of the directory — nothing was deleted, and the
      {' '}<a href={href('archived', 0)}>Archived list</a> brings them back.
    </p>
  )}
  {didRestore > 0 && (
    <p class="notice notice--ok">
      Restored {countLabel(didRestore)}. They are back on the check-in list.
    </p>
  )}
  {batchError && <p class="notice">{batchError}</p>}
  {addedGroup && (
    <p class="notice notice--ok">
      {didAdd > 0 ? `Added ${countLabel(didAdd)} to` : 'Nobody new was added to'}
      {' '}<a href={href(filter, addedGroup.id)}><strong>{addedGroup.name}</strong></a>{didTick > didAdd
        ? ` — ${countLabel(didTick - didAdd)} ${didTick - didAdd === 1 ? 'was' : 'were'} already in it. `
        : '. '}It now has {countLabel(addedGroup.members)}.
    </p>
  )}
  {removedGroup && (
    <p class="notice notice--ok">
      Took {countLabel(didRemove)} out of <strong>{removedGroup.name}</strong>. Nobody
      left the church or any other group.
    </p>
  )}

  {removeReview && removeGroup && removePeople.length > 0 && (
    <div class="card danger" style="margin-bottom:22px;">
      <h2 style="margin-top:0;">Take {countLabel(removeReview.ids.length)} out of {removeGroup.name}?</h2>
      <p class="muted" style="max-width:64ch; margin:-4px 0 14px; font-size:15px;">
        They stop getting texts sent to this group. Nobody leaves the church or any
        other group, and anyone can be added back.
      </p>
      <ul style="margin:0 0 18px; padding-left:20px; columns:2; column-gap:32px;">
        {removePeople.map((p) => (
          <li style="break-inside:avoid;">{p.lastName}, {p.firstName}</li>
        ))}
        {removeReview.ids.length > removePeople.length && (
          <li class="muted">and {removeReview.ids.length - removePeople.length} more</li>
        )}
      </ul>
      <div style="display:flex; gap:14px; flex-wrap:wrap; align-items:center;">
        <a class="btn btn--ghost" href={href(filter)}>Cancel</a>
        <form method="POST" style="margin:0;">
          <input type="hidden" name="action" value="group-remove-confirm" />
          <input type="hidden" name="fromGroup" value={removeGroup.id} />
          {removeReview.ids.map((id) => <input type="hidden" name="personId" value={id} />)}
          <button class="btn btn--danger" type="submit">Yes, take them out</button>
        </form>
      </div>
    </div>
  )}

  {/*
    STEP TWO. Nothing has been written at this point — this card is the whole
    of the confirmation, and closing the page or pressing Cancel leaves every
    one of these people exactly as they were.
  */}
  {review && reviewPeople.length > 0 && (
    <div class="card danger" style="margin-bottom:22px;">
      <h2 style="margin-top:0;">
        {review.restoring ? 'Restore' : 'Archive'} {countLabel(reviewPeople.length)}?
      </h2>
      <p class="muted" style="max-width:64ch; margin:-4px 0 14px; font-size:15px;">
        {review.restoring
          ? 'They go back on the check-in list and can be texted again. Being listed in the member directory is a separate box on their own page and is not turned back on here.'
          : 'They come off the check-in list, out of the member directory and out of every texting audience. Nothing is deleted — attendance history, groups and message logs are all kept, and any of them can be brought back from the Archived list.'}
      </p>
      <ul style="margin:0 0 18px; padding-left:20px; columns:2; column-gap:32px;">
        {reviewPeople.map((p) => (
          <li style="break-inside:avoid;">{p.lastName}, {p.firstName}</li>
        ))}
      </ul>
      <div style="display:flex; gap:14px; flex-wrap:wrap; align-items:center;">
        {/* Cancel first in the markup, so Enter can never be the write. */}
        <a class="btn btn--ghost" href={href(filter)}>Cancel</a>
        <form method="POST" style="margin:0;">
          <input type="hidden" name="action" value="archive-confirm" />
          <input type="hidden" name="restoring" value={review.restoring ? '1' : '0'} />
          {review.ids.map((id) => <input type="hidden" name="personId" value={id} />)}
          <button class="btn btn--danger" type="submit">
            Yes, {review.restoring ? 'restore' : 'archive'} {countLabel(reviewPeople.length)}
          </button>
        </form>
      </div>
    </div>
  )}

  <form method="GET" action="/people" style="display:flex; gap:10px; margin-bottom:16px; flex-wrap:wrap;">
    <input name="q" value={q} placeholder="Search name, email or phone"
           style="flex:1; min-width:220px; min-height:44px; padding:9px 12px; border:1px solid var(--hair); border-radius:6px;" />
    {/* A dropdown rather than another row of chips: groups are made by the pastor
        and there is no ceiling on how many there will be, so this has to still
        work at thirty of them. It submits with the search box, so a group and
        a search narrow together. */}
    {groups.length > 0 && (
      <label class="vh-label">
        <span class="vh">Group</span>
        <select name="group" style="min-height:44px; min-width:180px;">
          <option value="">Any group</option>
          {groups.map((g) => (
            <option value={g.id} selected={g.id === groupId}>{g.name}</option>
          ))}
        </select>
      </label>
    )}
    {filter && <input type="hidden" name="filter" value={filter} />}
    <button class="btn btn--ghost" type="submit">Search</button>
  </form>

  {chosenGroup && (
    <p class="muted" style="margin:-6px 0 16px; font-size:15px;">
      Showing <strong>{chosenGroup.name}</strong> only — {chosenGroup.members}
      {chosenGroup.members === 1 ? ' person' : ' people'} in this group.
      {' '}<a href={href(filter, 0)}>Show everyone</a>.
    </p>
  )}

  <div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:20px;">
    {FILTERS.map(([f, label]) => (
      <a href={href(f)} class="chip"
         style={filter === f ? 'background:var(--ink);color:var(--cream);text-decoration:none' : 'text-decoration:none'}>{label}</a>
    ))}
  </div>

  <p class="muted" style="margin:-10px 0 20px; max-width:66ch; font-size:15px;">
    {archivedView
      ? 'People who have been archived. They are off every list, register and texting audience, and none of their history has been deleted. Tick anyone here and press Restore selected to bring them back.'
      : 'Everyone here except people who have been archived — those are under the Archived chip. Tick people to add them to a group, or to take them off the lists.'}
  </p>

  {rows.length === 0 ? (
    <div class="card"><p style="margin:0;" class="muted">
      {q || filter ? 'Nobody matches that.' : 'No people yet — import the Breeze export to get started.'}
    </p></div>
  ) : (
    /*
     * Its own form, wrapping the table and nothing else. It must not contain
     * the Groups fold below — a form inside a form is not a thing, and the
     * browser silently drops the inner one rather than telling anybody.
     *
     * Posting to the current URL with no action attribute is what carries the
     * search, the chip and the chosen group through both steps.
     */
    <form method="POST">
    <input type="hidden" name="restoring" value={archivedView ? '1' : '0'} />
    {/*
      The group bar. FIRST in the form on purpose: Enter in the new-name box
      submits with the form's first button, which must be Add — not Archive.
      Not on the Archived view: an archived person is on no texting list.
    */}
    {!archivedView && (
      <div class="card gbar">
        <div class="gbar__row">
          <label class="gbar__f">
            <span>Add ticked people to</span>
            <select name="targetGroup">
              <option value="">Choose a group…</option>
              {groups.map((g) => <option value={g.id}>{g.name}</option>)}
            </select>
          </label>
          <label class="gbar__f">
            <span>or a new group called</span>
            <input name="newGroupName" maxlength="80" placeholder="e.g. Choir" autocomplete="off" />
          </label>
          <button class="btn" type="submit" name="action" value="group-add">Add</button>
        </div>
        <div class="gbar__row gbar__row--sub">
          {selectAll
            ? <a class="btn btn--ghost" href={href(filter)}>Clear ticks</a>
            : <button class="btn btn--ghost" type="submit" name="action" value="select-all">Select all {rows.length} shown</button>}
          {chosenGroup && (
            <>
              <input type="hidden" name="fromGroup" value={chosenGroup.id} />
              <button class="btn btn--ghost" type="submit" name="action" value="group-remove-review">
                Take ticked out of {chosenGroup.name}
              </button>
            </>
          )}
        </div>
      </div>
    )}
    <div class="card t-wrap" style="padding:0; overflow-x:auto;">
      <table class="t-stack">
        <thead>
          <tr><th class="pick"><span class="vh">Selected</span></th><th>Name</th><th>Phone</th><th>Email</th><th>On file</th><th>Adult / child</th><th>Directory</th><th>Texts</th></tr>
        </thead>
        <tbody>
          {rows.map((p) => (
            <tr>
              <td class="pick" data-label="Select">
                {/* The label names the person, because on a phone this reads as
                    a bare tick with the name on the line below it. */}
                <input type="checkbox" name="personId" value={p.id}
                       checked={selectAll || ticked.has(p.id)}
                       aria-label={`Select ${p.firstName} ${p.lastName}`} />
              </td>
              <td>
                <a href={`/people/${p.id}`} style="font-weight:600;">{p.lastName}, {p.firstName}</a>
                {p.needsProfile && <> <span class="chip chip--warn">needs a name</span></>}
              </td>
              <td data-label="Phone">{p.phone ?? <span class="muted">—</span>}</td>
              <td data-label="Email" style="word-break:break-all;">{p.email ?? <span class="muted">—</span>}</td>
              {/* What the directory holds for this person, shown HERE so a gap
                  is visible while scanning rather than only after opening the
                  record. Same row, same fields — this is the same data the
                  directory prints. */}
              <td data-label="On file">
                <span class={p.birthday ? 'on' : 'off'} title={p.birthday ? `Birthday: ${p.birthday.slice(5)}` : 'No birthday on file'}>bday</span>
                <span class={p.anniversary ? 'on' : 'off'} title={p.anniversary ? `Anniversary: ${p.anniversary.slice(5)}` : 'No anniversary on file'}>anniv</span>
                <span class={p.addressStreet ? 'on' : 'off'} title={p.addressStreet ?? 'No address on file'}>addr</span>
                <span class={p.photoKey ? 'on' : 'off'} title={p.photoKey ? 'Has a photo' : 'No photo'}>photo</span>
              </td>
              <td data-label="Status">
                {p.adultChild === 'unknown'
                  ? <span class="chip chip--warn">Unconfirmed</span>
                  : <span class="chip">{p.adultChild}</span>}
              </td>
              <td data-label="Directory">
                {p.adultChild !== 'adult'
                  ? <span class="muted">—</span>
                  : p.includeInDirectory
                    ? <span class="chip">{p.directoryStatus === 'none' ? 'included' : p.directoryStatus}</span>
                    : <span class="muted">not included</span>}
              </td>
              <td data-label="Texts">
                {!p.phoneE164 ? <span class="muted">no number</span>
                  : p.smsConsent === 'opted_in' ? <span class="chip">on</span>
                  : p.smsConsent === 'opted_out' ? <span class="chip chip--warn">opted out</span>
                  : <span class="muted">not asked</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div style="display:flex; gap:14px; align-items:center; flex-wrap:wrap; margin-top:16px;">
      <button class="btn btn--danger" type="submit" name="action" value="archive-review">
        {archivedView ? 'Restore selected' : 'Archive selected'}
      </button>
      <span class="muted" style="font-size:14px;">
        {archivedView
          ? 'You will be shown who, and asked again, before anything changes.'
          : 'Nothing is deleted, and you will be shown who and asked again first.'}
      </span>
    </div>
    </form>
  )}

  {/* Making and deleting the lists themselves. A fold, because it is done a
      handful of times a year while the table above it is read every week.
      Adding PEOPLE to a group is the bar above the table, or the boxes on a
      person's own page. */}
  <details class="card" id="groups" style="margin-top:26px;" open={groupsOpen || !!groupError}>
    <summary class="fold">
      Groups
      <span class="muted fold__n">
        {groups.length === 0 ? 'none yet'
          : `${groups.length} ${groups.length === 1 ? 'list' : 'lists'}`}
      </span>
    </summary>

    <p class="muted" style="max-width:58ch; margin:14px 0 18px;">
      Named lists for sending to part of the church rather than everyone, and for
      filtering this page. Add people by ticking them in the list above, or from their own page.
    </p>

    {groupError && <p class="notice">{groupError}</p>}

    <form method="POST" style="display:flex; gap:12px; align-items:flex-end; flex-wrap:wrap; margin-bottom:22px;">
      <input type="hidden" name="action" value="create-group" />
      <label class="field" style="margin:0; flex:1; min-width:190px;">
        <span>Name</span><input name="name" placeholder="Fairhaven Youth parents" required />
      </label>
      <label class="field" style="margin:0; flex:2; min-width:210px;">
        <span>What it is for</span><input name="description" placeholder="Optional" />
      </label>
      <button class="btn" type="submit">Create</button>
    </form>

    {groups.length === 0 ? (
      <p class="muted" style="margin:0;">
        No groups yet. Until there is one, Messaging can only send to everyone.
      </p>
    ) : (
      <div class="t-wrap" style="overflow-x:auto;">
        <table class="t-stack">
          <thead><tr><th>Group</th><th>People</th><th>Can be texted</th><th></th></tr></thead>
          <tbody>
            {groups.map((g) => (
              <tr>
                <td>
                  <a href={`/people?group=${g.id}`} style="font-weight:600;">{g.name}</a>
                  {g.description && <><br /><span class="muted" style="font-size:14px;">{g.description}</span></>}
                </td>
                <td data-label="People">{g.members}</td>
                <td data-label="Can be texted">
                  {g.reachable}
                  {g.members > g.reachable && (
                    <span class="muted"> · {g.members - g.reachable} without a number or opt-in</span>
                  )}
                </td>
                <td data-label="">
                  <form method="POST" onsubmit="return confirm('Delete this group? Nobody is removed from the church — only the list.')">
                    <input type="hidden" name="action" value="delete-group" />
                    <input type="hidden" name="groupId" value={g.id} />
                    <button class="btn btn--ghost" style="min-height:36px; padding:6px 12px;" type="submit">Delete</button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </details>
</AppLayout>

<style>
  /* Unmistakable, because a screenshot of demo data that is mistaken for real
     data is the one way this feature could do harm. */
  .demo-flag { background:#fdf0d9; border-left:4px solid #b8860b; color:#5c4405;
               padding:10px 14px; margin:0 0 18px; font-size:14px; border-radius:3px; }
  .demo-flag a { color:#5c4405; }

  /* "On file" markers. Present is quiet and dark; missing is struck through
     and pale — the eye is scanning for GAPS, so the gaps are what change
     shape rather than the hits. */
  .on, .off { display:inline-block; margin-right:6px; font-size:12px; font-weight:700;
              letter-spacing:.04em; }
  .on  { color:#1e5b28; }
  .off { color:#b6ada0; text-decoration:line-through; }

  /* The group picker needs a name for a screen reader and no name on screen —
     the "Any group" option already says what it is to everyone else. */
  .vh-label { display: flex; }
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden;
        clip-path: inset(50%); white-space: nowrap; }

  /* The select column. Narrow, and the box itself is enlarged rather than the
     cell padded — this gets used on a phone, and a 14px tick target beside
     somebody's name is how the wrong person gets archived. */
  .pick { width: 1%; white-space: nowrap; }
  .pick input { width: 20px; height: 20px; accent-color: var(--red); margin: 0; }

  /*
   * Stacked, the tick has to stay ON the name's line.
   *
   * .t-stack makes every cell its own row and treats the FIRST one as the
   * row's identity — which the tick has just become, leaving the name below it
   * as an unlabelled orphan and the tick belonging to nothing in particular.
   * Laying the row out as a flex line puts them back together: the tick takes
   * only its own width, the name takes the rest of that line, and every other
   * cell still wraps to a full row of its own.
   */
  @media (max-width: 700px) {
    .t-stack tr { display: flex; flex-wrap: wrap; align-items: baseline; }
    .t-stack td { flex: 1 1 100%; }
    .t-stack td.pick { flex: 0 0 auto; width: auto; padding-right: 4px; }
    .t-stack td.pick::before { content: none; }
    .t-stack td.pick + td { flex: 1 1 0; font-size: 17px; padding-bottom: 6px; }
    .t-stack td.pick + td::before { content: none; }
  }

  .danger { border-color: var(--red); }

  .gbar { margin-bottom: 14px; padding: 14px 16px; }
  .gbar__row { display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap; }
  .gbar__row--sub { margin-top: 12px; align-items: center; }
  .gbar__f { display: flex; flex-direction: column; gap: 4px; flex: 1 1 200px; min-width: 0;
             font-size: 13px; font-weight: 700; color: var(--ink-soft); }
  .gbar__f select, .gbar__f input { min-height: 44px; font: inherit; font-size: 16px; font-weight: 400;
             padding: 8px 10px; border: 1px solid var(--hair); border-radius: 6px; background: #fff;
             color: var(--ink); }
</style>
