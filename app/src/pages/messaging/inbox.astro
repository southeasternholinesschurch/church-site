---
import AppLayout from '../../layouts/AppLayout.astro';
import Replies from '../../components/Replies.astro';

const user = Astro.locals.user!;

/**
 * Every reply, on a page of its own.
 *
 * No longer on the nav bar — the last few replies sit at the bottom of
 * /messaging, which is where they get read. This page is what that link opens
 * when there is a genuine backlog to work through, and it is still a perfectly
 * good bookmark.
 */
---
<AppLayout title="Replies" user={user}>
  <div style="display:flex; align-items:baseline; gap:14px; flex-wrap:wrap;">
    <h1 style="margin:0;">Replies</h1>
    <a href="/messaging" style="margin-left:auto;">Send a message →</a>
  </div>
  <p class="muted" style="max-width:58ch; margin:6px 0 22px;">
    Everything people have texted to the church number. STOP and START are handled
    automatically — these are here so nothing said to you goes unread.
  </p>

  <div class="card">
    <Replies user={user} limit={100} />
  </div>
</AppLayout>
