---
import '../styles/kids.css';
import { canAccess, isKidsRole, type Role } from '../lib/permissions';

/**
 * The children's-ministry chrome.
 *
 * A SEPARATE layout from AppLayout rather than a themed variant of it. The two
 * have different navigation, a different palette and different audiences, and
 * every conditional that tried to serve both would be a place where a staff
 * link could leak into a volunteer's view. Access is enforced in the
 * middleware regardless — but a layout that CANNOT render /people is one fewer
 * thing to get wrong.
 */
interface Props {
  title: string;
  user: { email: string; name: string | null; role: Role };
}
const { title, user } = Astro.props;
const path = Astro.url.pathname;

/**
 * Three things a volunteer does, and one place for everything a director sets up
 * once and leaves alone. The logo is the way home, so there is no "Home" link.
 *
 * `also` lists the pages that live UNDER a link, so it stays highlighted while
 * you are on them — Replies sits beside Messages, and the setup screens under
 * Setup, rather than each taking a slot in a bar that wraps on a phone.
 *
 * Filtered by canAccess below, so a teacher never sees Setup. The page refuses
 * anyone without the capability regardless; a hidden link is not access control.
 */
const NAV: { href: string; label: string; also?: string[] }[] = [
  { href: '/kids/attendance', label: 'Attendance', also: ['/kids/register'] },
  { href: '/kids/calling', label: 'Calling' },
  { href: '/kids/children', label: 'Children', also: ['/kids/child'] },
  { href: '/kids/messaging', label: 'Messages', also: ['/kids/replies'] },
  { href: '/kids/setup', label: 'Setup', also: ['/kids/classes', '/kids/kiosk', '/kids/cards'] },
];
const under = (base: string) => path === base || path.startsWith(`${base}/`);
const nav = NAV.filter((n) => canAccess(user.role, n.href));

/** Staff came DOWN into this section and need the way back. A volunteer has no
 *  such link, because there is nowhere for it to lead. */
const showWayBack = !isKidsRole(user.role);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* The landing page is already called Fairhaven Kids; "Fairhaven Kids · Fairhaven Kids" in a tab
        is noise. Every other page reads "Registers · Fairhaven Kids". */}
    <title>{title === 'Fairhaven Kids' ? 'Fairhaven Kids' : `${title} · Fairhaven Kids`}</title>
    <meta name="robots" content="noindex, nofollow" />
    {/* Fairhaven Kids' own marks, not the staff app's — a volunteer with both installed
        picks between two home-screen icons, and two identical ones is a coin
        toss every Sunday morning.

        The favicons carry the CROWN alone rather than the wordmark: "KIDS" at
        16px is a row of grey smears, the same reason the staff favicon is a
        single S. Generated by scripts/make-kids-icons.py, which measures white
        against the gradient under every letterform and refuses to write an icon
        that falls below 4.5:1. */}
    <link rel="icon" type="image/png" sizes="32x32" href="/kids-icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/kids-icons/favicon-48.png" />
    <link rel="apple-touch-icon" href="/kids-icons/apple-touch-icon.png" />
    {/* Navy, not the staff app's warm ink — the phone's own chrome should agree
        with the page a volunteer is looking at. */}
    <meta name="theme-color" content="#081334" />
    {/* Installable, so Fairhaven Kids sits on a volunteer's home screen as its own app
        and runs without the browser's chrome — which on a phone in a classroom
        is two rows of buttons' worth of height.

        No service worker, deliberately, and none is needed to install. The only
        thing one could usefully cache here is furniture; these pages are
        children's addresses, allergies and behaviour notes, which must always
        come from the network so that archiving a child or revoking a volunteer
        bites on the very next open.

        Scope is "/kids", which sits INSIDE the staff manifest's "/". On a phone
        with both installed a link may open in whichever was installed last —
        harmless, and the same trade the directory already makes, which is why
        all three manifests carry distinct ids. */}
    <link rel="manifest" href="/kids.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Fairhaven Kids" />
  </head>
  <body class="kids">
    <header class="k-bar">
      <div class="k-bar__in">
        {/* The real wordmark, not type pretending to be it. White because the
            bar is navy; the source artwork is a pink-to-cyan gradient that
            disappears against it. Trimmed and flattened from
            site/src/assets/brand — see the note in kids.css. */}
        <a href="/kids" class="k-bar__brand" aria-label="Fairhaven Kids — home">
          <img src="/kids-logo-white.png" alt="Fairhaven Kids" width="450" height="220" />
        </a>
        <nav class="k-bar__nav">
          {nav.map((n) => (
            <a href={n.href} aria-current={[n.href, ...(n.also ?? [])].some(under) ? 'page' : undefined}>{n.label}</a>
          ))}
          {showWayBack && <a href="/" class="k-bar__up">← Staff dashboard</a>}
          <span class="k-bar__who">{user.name ?? user.email}</span>
          <form method="POST" action="/auth/logout" style="margin:0">
            <button class="k-bar__nav" style="background:none;border:0;color:rgba(255,255,255,.78);font:inherit;font-size:15px;cursor:pointer;padding:0">Sign out</button>
          </form>
        </nav>
      </div>
    </header>

    <div class="k-backdrop" aria-hidden="true"></div>

    <main class="k-main">
      <div class="k-wrap">
        <slot />
      </div>
    </main>
  </body>
</html>
