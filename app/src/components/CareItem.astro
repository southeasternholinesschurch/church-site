---
/**
 * One thing on the follow-up list, with everything that can be done about it.
 *
 * The same card on /care and on a person's own care page, so "log what
 * happened" is one form everywhere. Every action is a plain form post — the
 * pastor reading this on a phone in a hospital car park should never be
 * waiting on a script.
 */
import CareItemMore from './CareItemMore.astro';
import { CARE_KINDS, NEXT_STEPS, careKindLabel, shortDate } from '../lib/care';

interface Props {
  item: {
    id: number; kind: string; reason: string; dueOn: string;
    personId: number | null; guestId: number | null; name: string;
    phone: string | null; email: string | null;
    assignedStaffId: number | null; assignedName: string | null;
    last: { kind: string; onDate: string; body: string | null; author: string | null } | null;
    message: string | null;
  };
  today: string;
  /** Admins who could take it. The assign control is hidden when there is one. */
  staff: { id: number; name: string }[];
  /** Hide the name link when the card is already on that person's page. */
  showName?: boolean;
  /**
   * On a person's or a guest's own page. The page has ONE "log a contact" form
   * of its own, so the card drops its copy and shows only what is open and the
   * other things that can be done about it. Two log forms on one screen, one of
   * which closed the follow-up and one of which did not, was a trap.
   */
  compact?: boolean;
}
const { item, today, staff, showName = true, compact = false } = Astro.props;

const LABEL: Record<string, string> = { guest: 'Guest card', missing: 'Not been in', reminder: 'Reminder' };
const href = item.personId ? `/care/person/${item.personId}` : `/care/guest/${item.guestId}`;
const late = item.dueOn < today;
const telHref = item.phone ? `tel:${item.phone.replace(/[^\d+]/g, '')}` : null;
---
<article class="ci card" id={`item-${item.id}`}>
  <div class="ci__top">
    <span class={`chip ci__kind ci__kind--${item.kind}`}>{LABEL[item.kind] ?? item.kind}</span>
    {item.assignedName && <span class="chip">With {item.assignedName}</span>}
    {late && <span class="ci__late">since {shortDate(item.dueOn)}</span>}
  </div>
  {showName && <h3 class="ci__name"><a href={href}>{item.name}</a></h3>}
  <p class="ci__why">{item.reason}</p>
  {compact ? (
    /* Secondary on a page whose main act is the log form below, so folded. */
    <details class="ci__act">
      <summary>Snooze, close or assign</summary>
      <CareItemMore item={item} staff={staff} />
    </details>
  ) : (<>
  {item.message && <blockquote class="ci__msg">{item.message}</blockquote>}
  {(telHref || item.email) && (
    <p class="ci__reach">
      {telHref && <a href={telHref}>{item.phone}</a>}
      {item.email && <a href={`mailto:${item.email}`}>{item.email}</a>}
    </p>
  )}
  {item.last && (
    <p class="ci__last">
      <span class="label">Last</span>
      {careKindLabel(item.last.kind)} · {shortDate(item.last.onDate)}{item.last.author && ` · ${item.last.author}`}
      {item.last.body && <span class="ci__lastbody"> — {item.last.body.length > 140 ? `${item.last.body.slice(0, 140)}…` : item.last.body}</span>}
    </p>
  )}

  <details class="ci__act">
    <summary>Log what happened</summary>
    <form method="POST" class="ci__form">
      <input type="hidden" name="action" value="log" />
      <input type="hidden" name="itemId" value={item.id} />
      <div class="ci__row">
        <label class="field"><span>What</span>
          <select name="kind">
            {/* A call is what most follow-ups turn out to be. */}
            {CARE_KINDS.map((k) => <option value={k.id} selected={k.id === 'call'}>{k.label}</option>)}
          </select>
        </label>
        <label class="field"><span>When</span>
          <input type="date" name="onDate" value={today} max={today} />
        </label>
      </div>
      <label class="field"><span>Note</span>
        <textarea name="body" rows="3" placeholder="What did you learn? Anything to pray about or follow up on?"></textarea>
      </label>
      <fieldset class="ci__next">
        <legend class="label">Then</legend>
        {NEXT_STEPS.map((s) => (
          <label class="ci__radio">
            <input type="radio" name="next" value={s.id} checked={s.id === 'done'} />
            <span>{s.label}</span>
            {s.id === 'date' && <input type="date" name="nextOn" min={today} aria-label="Check again on" />}
          </label>
        ))}
      </fieldset>
      <button class="btn" type="submit">Save to the care log</button>
    </form>

    <CareItemMore item={item} staff={staff} />
  </details>
  </>)}
</article>

<style>
  .ci { padding: 18px 20px; margin-bottom: 14px; }
  .ci__top { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-bottom: 6px; }
  .ci__kind--guest { background: #e8f2eb; color: #16532c; }
  .ci__kind--missing { background: #fbeee0; color: #8a5316; }
  .ci__kind--reminder { background: #e7ecf6; color: #23406e; }
  .ci__late { font-size: 13px; color: var(--ink-soft); }
  .ci__name { margin: 2px 0 4px; font-size: 20px; }
  .ci__name a { color: var(--ink); text-decoration: none; }
  .ci__name a:hover { color: var(--red); text-decoration: underline; }
  .ci__why { margin: 0; color: var(--ink-soft); }
  .ci__msg { margin: 10px 0 0; padding: 8px 12px; border-left: 3px solid var(--hair);
             background: var(--cream); border-radius: 0 6px 6px 0; white-space: pre-line; }
  .ci__reach { display: flex; gap: 16px; flex-wrap: wrap; margin: 8px 0 0; font-size: 15px; }
  .ci__last { margin: 10px 0 0; font-size: 14px; color: var(--ink-soft); }
  .ci__last .label { margin-right: 8px; color: var(--tan); }
  .ci__act { margin-top: 12px; border-top: 1px solid var(--hair); padding-top: 10px; }
  .ci__act > summary { cursor: pointer; font-weight: 700; color: var(--red); min-height: 32px;
                       display: flex; align-items: center; }
  .ci__act > summary:focus-visible { outline: 2px solid var(--red); outline-offset: 3px; }
  .ci__form { margin-top: 12px; }
  .ci__row { display: grid; grid-template-columns: 1fr 1fr; gap: 0 14px; }
  .ci__next { border: 0; padding: 0; margin: 0 0 16px; display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .ci__next legend { color: var(--ink-soft); margin-bottom: 8px; }
  .ci__radio { display: flex; align-items: center; gap: 8px; min-height: 36px; }
  .ci__radio input[type=radio] { width: 18px; height: 18px; }
  .ci__radio input[type=date] { font: inherit; font-size: 14px; padding: 4px 8px;
                                border: 1px solid var(--hair); border-radius: 6px; }
  @media (max-width: 560px) {
    .ci__row { grid-template-columns: 1fr; }
  }
</style>
